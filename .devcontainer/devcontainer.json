{
  "name": "Heistproof",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "npm install && npx playwright install --with-deps chromium",
  "forwardPorts": [4410],
  "portsAttributes": { "4410": { "label": "Heistproof console", "onAutoForward": "openBrowser" } },
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
