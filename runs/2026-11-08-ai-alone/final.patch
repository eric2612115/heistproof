+export function buildPayPalSdkUrl(config) {
+  if (!config) return null;
+  if (config.sdkUrl) return config.sdkUrl;
+  const clientId = config.clientId ?? config.client_id;
+  if (!clientId) return null;
+  // PAYPAL_ENV (surfaced by the server config) chooses the script host,
+  // never PAYPAL_API_BASE.
+  const env = config.env ?? config.environment;
+  const host = env === "live" ? "https://www.paypal.com" : "https://www.sandbox.paypal.com";
+  const params = new URLSearchParams({
+    "client-id": clientId,
+    components: "buttons",
+    currency: config.currency ?? "USD",
+    intent: "capture",
+    "enable-funding": "venmo,paylater",
+    "disable-funding": "card,credit",
+  });
+  const testBuyerCountry = config.testBuyerCountry ?? config.buyerCountry;
+  if (env !== "live" && testBuyerCountry) params.set("buyer-country", testBuyerCountry);
+  return `${host}/sdk/js?${params.toString()}`;
+}
+
+function loadPayPalSdk(config) {
+  if (window.paypal?.Buttons) return Promise.resolve(window.paypal);
+  const url = buildPayPalSdkUrl(config);
+  if (!url) return Promise.reject(new Error("PayPal is not configured"));
+  return new Promise((resolve, reject) => {
+    const script = document.createElement("script");
+    script.src = url;
+    script.async = true;
+    script.dataset.paypalSdk = "true";
+    script.onload = () => resolve(window.paypal);
+    script.onerror = () => reject(new Error("Could not load PayPal"));
+    document.head.appendChild(script);
+  });
+}
+
+let paypalInitialised = false;
+
+export async function initPayPal() {
+  const container = document.querySelector("#paypal-button-container");
+  if (!container || paypalInitialised) return;
+  paypalInitialised = true;
+  try {
+    const res = await fetch("/api/paypal/config");
+    if (!res.ok) throw new Error("PayPal config unavailable");
+    const config = await res.json();
+    if (!config.enabled && !config.paypalEnabled) {
+      const section = document.querySelector("#paypal-section");
+      if (section) section.hidden = true;
+      return;
+    }
+    const paypal = await loadPayPalSdk(config);
+    if (!paypal?.Buttons) throw new Error("PayPal is unavailable");
+    await paypal
+      .Buttons({
+        createOrder: async () => {
+          showError("");
+          if (bag.read().length === 0) throw new Error("Your bag is empty.");
+          const response = await fetch("/api/paypal/orders", {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({
+              items: bag.read(),
+              email: document.querySelector("#email")?.value || undefined,
+            }),
+          });
+          const data = await response.json().catch(() => ({}));
+          if (!response.ok) throw new Error(data.error ?? "Could not create a PayPal order");
+          return data.id ?? data.paypalOrderId;
+        },
+        onApprove: async (data) => {
+          try {
+            const paypalOrderId = data.orderID ?? data.id;
+            const response = await fetch(`/api/paypal/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+              method: "POST",
+              headers: { "content-type": "application/json" },
+              body: JSON.stringify({}),
+            });
+            const result = await response.json().catch(() => ({}));
+            if (!response.ok) throw new Error(result.error ?? "PayPal payment failed");
+            await showConfirmation(result.orderId);
+          } catch (err) {
+            showError(err.message);
+            throw err;
+          }
+        },
+        onCancel: () => {
+          showError("PayPal checkout was cancelled. Your bag is still here.");
+        },
+        onError: (err) => {
+          showError(err?.message ?? "PayPal could not complete your payment. Please try again or pay with card.");
+        },
+      })
+      .render("#paypal-button-container");
+  } catch (err) {
+    // PayPal being unavailable must never break card checkout.
+    const section = document.querySelector("#paypal-section");
+    if (section) section.hidden = true;
+    console.warn("PayPal unavailable:", err);
+  }
+}
