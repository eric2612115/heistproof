+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createApp, paypalBrowserConfig, paypalSdkUrl } from "../server.js";
+import { openDb } from "../lib/db.js";
+import { createCardProcessor } from "../lib/card-processor.js";
+
+function fakePayPal({ captureCents = 4900, verified = true } = {}) {
+  const state = { captureCalls: 0, created: [] };
+  return {
+    state,
+    clientId: "test-client-id",
+    async createOrder({ localOrderId, cart }) {
+      state.created.push({ localOrderId, totalCents: cart.totalCents });
+      return { id: "PAYPAL-ORDER-1", status: "CREATED" };
+    },
+    async captureOrder() {
+      state.captureCalls += 1;
+      return {
+        id: "PAYPAL-ORDER-1",
+        status: "COMPLETED",
+        purchase_units: [
+          {
+            reference_id: state.created[0].localOrderId,
+            custom_id: state.created[0].localOrderId,
+            payments: {
+              captures: [
+                {
+                  id: "CAPTURE-1",
+                  status: "COMPLETED",
+                  amount: { value: (captureCents / 100).toFixed(2), currency_code: "USD" },
+                  custom_id: state.created[0].localOrderId,
+                  supplementary_data: { related_ids: { order_id: "PAYPAL-ORDER-1" } },
+                },
+              ],
+            },
+          },
+        ],
+      };
+    },
+    async getOrder() {
+      return this.captureOrder();
+    },
+    async verifyWebhookSignature() {
+      return verified;
+    },
+  };
+}
+
+async function startShop(paypal, env = {}) {
+  const db = openDb(":memory:");
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypal, env });
+  const server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  return { db, base: `http://127.0.0.1:${server.address().port}`, close: () => new Promise((r) => server.close(r)) };
+}
+
+const post = (url, body, headers = {}) =>
+  fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body) });
+
+const webhookHeaders = {
+  "paypal-auth-algo": "SHA256withRSA",
+  "paypal-cert-url": "https://api.sandbox.paypal.com/certs/test",
+  "paypal-transmission-id": "trans-1",
+  "paypal-transmission-sig": "sig",
+  "paypal-transmission-time": "2026-01-01T00:00:00Z",
+};
+
+async function createViaApi(shop) {
+  const res = await post(`${shop.base}/api/paypal/orders`, { items: [{ sku: "FOG-HOODIE", qty: 1, price: 1 }] });
+  assert.equal(res.status, 200);
+  return res.json();
+}
+
+test("paypal browser config picks SDK host from PAYPAL_ENV, not the API base", () => {
+  const sandbox = paypalBrowserConfig(
+    { PAYPAL_ENV: "sandbox", PAYPAL_API_BASE: "http://127.0.0.1:9999", PAYPAL_TEST_BUYER_COUNTRY: "US" },
+    "cid",
+  );
+  assert.equal(sandbox.testBuyerCountry, "US");
+  assert.match(sandbox.sdkUrl, /^https:\/\/www\.sandbox\.paypal\.com\/sdk\/js\?/);
+  assert.match(sandbox.sdkUrl, /buyer-country=US/);
+  assert.match(sandbox.sdkUrl, /enable-funding=venmo%2Cpaylater/);
+  const live = paypalBrowserConfig({ PAYPAL_ENV: "live", PAYPAL_API_BASE: "http://127.0.0.1:9999", PAYPAL_TEST_BUYER_COUNTRY: "US" }, "cid");
+  assert.equal(live.testBuyerCountry, null);
+  assert.match(live.sdkUrl, /^https:\/\/www\.paypal\.com\/sdk\/js\?/);
+  assert.doesNotMatch(live.sdkUrl, /buyer-country/);
+  assert.match(paypalSdkUrl({ clientId: "cid", env: { PAYPAL_ENV: "live" } }), /^https:\/\/www\.paypal\.com\//);
+});
+
+test("paypal create prices on the server and capture fulfils once, even when replayed", async () => {
+  const paypal = fakePayPal();
+  const shop = await startShop(paypal, { PAYPAL_CLIENT_ID: "test-client-id" });
+  try {
+    const created = await createViaApi(shop);
+    assert.equal(created.paypalOrderId, "PAYPAL-ORDER-1");
+    assert.equal(paypal.state.created[0].totalCents, 4900); // browser-sent price: 1 ignored
+
+    const cap1 = await post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`, {});
+    assert.equal(cap1.status, 200);
+    const { orderId } = await cap1.json();
+    assert.equal(orderId, created.orderId);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.getOrder(orderId).paid_cents, 4900);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+
+    const cap2 = await post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`, {});
+    assert.equal(cap2.status, 200);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("paypal capture with a mismatched amount does not fulfil", async () => {
