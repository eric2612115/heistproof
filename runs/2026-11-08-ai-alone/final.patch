+// --- PayPal helpers ---------------------------------------------------------
+
+// The injected/real client is used through a small adapter so tests can
+// substitute their own implementation. Only our own client is relied on
+// in production.
+function paypalCreateOrder(paypal, args) {
+  if (typeof paypal.createOrder === "function") return paypal.createOrder(args);
+  throw new Error("PayPal client cannot create orders");
+}
+function paypalCaptureOrder(paypal, paypalOrderId, localOrderId) {
+  if (typeof paypal.captureOrder === "function") return paypal.captureOrder(paypalOrderId, localOrderId);
+  throw new Error("PayPal client cannot capture orders");
+}
+function paypalVerifyWebhook(paypal, args) {
+  if (typeof paypal.verifyWebhookSignature === "function") return paypal.verifyWebhookSignature(args);
+  if (typeof paypal.verifyWebhook === "function") return paypal.verifyWebhook(args);
+  throw new Error("PayPal client cannot verify webhooks");
+}
+
+function normaliseEnv(value) {
+  return value === "live" ? "live" : "sandbox";
+}
+
+function publicPayPalConfig(paypal) {
