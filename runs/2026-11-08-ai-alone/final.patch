+test("config endpoint exposes only the public client id", async () => {
+  const shop = await startShop(fakePayPal(), {
+    PAYPAL_CLIENT_ID: "test-client-id",
+    PAYPAL_CLIENT_SECRET: "must-not-leak",
+    PAYPAL_WEBHOOK_ID: "WH-secret-id",
+    PAYPAL_ENV: "sandbox",
+    PAYPAL_TEST_BUYER_COUNTRY: "GB",
+    PAYPAL_API_BASE: "http://127.0.0.1:9/proxy",
+  });
+  try {
+    const res = await fetch(`${shop.base}/api/paypal/config`);
+    const text = await res.text();
+    assert.match(text, /test-client-id/);
+    assert.match(text, /"testBuyerCountry":"GB"/);
+    assert.doesNotMatch(text, /must-not-leak|WH-secret-id/);
+    assert.match(text, /www\.sandbox\.paypal\.com/);
+  } finally {
+    await shop.close();
+  }
+});
