+// PayPal REST client.
+//
+// All REST calls go to `apiBase` (PAYPAL_API_BASE). Credentials are read by
+// the caller from PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET and never leave
+// the server. Amounts cross this boundary as decimal strings ("49.00"),
+// while the rest of the shop works in integer cents.
+
+export function formatPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  return (cents / 100).toFixed(2);
+}
+
+export function parsePayPalAmount(value) {
+  const text = String(value ?? "").trim();
+  if (!/^\d+(\.\d{1,2})?$/.test(text)) return null;
+  const [dollars, fraction = ""] = text.split(".");
+  return Number(dollars) * 100 + Number(fraction.padEnd(2, "0"));
+}
+
+export function createPayPalClient({
+  clientId,
+  clientSecret,
+  apiBase = "https://api-m.sandbox.paypal.com",
+  webhookId,
+  env,
+  testBuyerCountry,
+  fetchImpl = fetch,
+} = {}) {
+  const base = String(apiBase || "https://api-m.sandbox.paypal.com").replace(/\/+$/, "");
+  let tokenCache = null;
+
+  const client = {
+    clientId: clientId ?? null,
+    apiBase: base,
+    env: env ?? null,
+    testBuyerCountry: testBuyerCountry ?? null,
+    // Never expose clientSecret / webhookId through config serialisation;
+    // they are only kept in this closure via the methods below.
+
+    isConfigured() {
+      return Boolean(clientId && clientSecret);
+    },
+
+    async getAccessToken() {
+      if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.value;
+      const res = await fetchImpl(`${base}/v1/oauth2/token`, {
+        method: "POST",
+        headers: {
+          Authorization: `Basic ${Buffer.from(`${clientId}:${clientSecret}`).toString("base64")}`,
+          "Content-Type": "application/x-www-form-urlencoded",
+          Accept: "application/json",
+        },
+        body: "grant_type=client_credentials",
+      });
+      const data = await res.json().catch(() => ({}));
+      if (!res.ok || !data.access_token) {
+        const err = new Error(data.error_description || data.message || `PayPal authentication failed (${res.status})`);
+        err.status = 502;
+        throw err;
+      }
+      tokenCache = {
+        value: data.access_token,
+        expiresAt: Date.now() + Math.max(60, Number(data.expires_in) || 3600) * 1000,
+      };
+      return tokenCache.value;
+    },
+
+    async request(pathname, { method = "GET", body, requestId } = {}) {
+      const token = await client.getAccessToken();
+      const headers = {
+        Authorization: `Bearer ${token}`,
+        "Content-Type": "application/json",
+        Accept: "application/json",
+      };
+      if (requestId) headers["PayPal-Request-Id"] = requestId;
+      const res = await fetchImpl(`${base}${pathname}`, {
+        method,
+        headers,
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+      const data = await res.json().catch(() => ({}));
+      if (!res.ok) {
+        const detail = data.details?.[0]?.description || data.message || data.name || res.statusText;
+        const err = new Error(`PayPal request failed (${res.status}): ${detail}`);
+        err.status = 502;
+        err.paypalStatus = res.status;
+        throw err;
+      }
+      return data;
+    },
+
+    // Creates a PayPal order for a cart already priced on the server.
+    async createOrder({ localOrderId, cart }) {
+      const currencyCode = String(cart.currency || "usd").toUpperCase();
+      const amount = formatPayPalAmount(cart.totalCents);
+      return client.request("/v2/checkout/orders", {
+        method: "POST",
+        requestId: `create-${localOrderId}`,
+        body: {
+          intent: "CAPTURE",
+          purchase_units: [
+            {
+              reference_id: localOrderId,
+              custom_id: localOrderId,
+              description: `Fogline order ${localOrderId}`,
+              amount: {
+                currency_code: currencyCode,
+                value: amount,
+                breakdown: {
+                  item_total: { currency_code: currencyCode, value: amount },
+                },
+              },
+              items: cart.lines.map((line) => ({
+                name: line.name,
+                sku: line.sku,
+                quantity: String(line.qty),
+                unit_amount: { currency_code: currencyCode, value: formatPayPalAmount(line.unitCents) },
+                category: "PHYSICAL_GOODS",
+              })),
+            },
+          ],
+          application_context: {
+            brand_name: "Fogline Supply Co.",
+            shipping_preference: "NO_SHIPPING",
+            user_action: "PAY_NOW",
+          },
+        },
+      });
+    },
+
+    async captureOrder(paypalOrderId, localOrderId) {
+      return client.request(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+        method: "POST",
+        // Re-using the same request id makes a retried capture safe:
+        // PayPal will not capture the same order twice for it.
+        requestId: `capture-${localOrderId || paypalOrderId}`,
+        body: {},
+      });
+    },
+
+    async getOrder(paypalOrderId) {
+      return client.request(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}`);
+    },
+
+    async verifyWebhookSignature({ headers, webhookEvent }) {
+      if (!webhookId) throw new Error("PAYPAL_WEBHOOK_ID is not configured");
+      return client.request("/v1/notifications/verify-webhook-signature", {
+        method: "POST",
+        body: {
+          auth_algo: headers.authAlgo,
+          cert_url: headers.certUrl,
+          transmission_id: headers.transmissionId,
+          transmission_sig: headers.transmissionSig,
+          transmission_time: headers.transmissionTime,
+          webhook_id: webhookId,
+          webhook_event: webhookEvent,
+        },
+      });
+    },
+  };
+
+  return client;
+}
+
+export function payPalClientFromEnv(envVars = process.env) {
+  return createPayPalClient({
+    clientId: envVars.PAYPAL_CLIENT_ID,
+    clientSecret: envVars.PAYPAL_CLIENT_SECRET,
+    apiBase: envVars.PAYPAL_API_BASE || "https://api-m.sandbox.paypal.com",
+    webhookId: envVars.PAYPAL_WEBHOOK_ID,
+    env: envVars.PAYPAL_ENV === "live" ? "live" : "sandbox",
+    testBuyerCountry: envVars.PAYPAL_TEST_BUYER_COUNTRY || null,
+  });
+}
