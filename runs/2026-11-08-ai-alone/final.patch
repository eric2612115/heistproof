+function fakePaypal({ captureAmount = "49.00", captureCurrency = "USD", captureStatus = "COMPLETED", verify = "SUCCESS" } = {}) {
+  const calls = { create: [], capture: [], verify: [] };
+  return {
+    clientId: "test-client-id",
+    clientSecret: "must-never-leak",
+    env: "sandbox",
+    testBuyerCountry: "GB",
+    calls,
+    isConfigured: () => true,
+    async createOrder(args) {
+      calls.create.push(args);
+      return { id: "PAYPAL-ORDER-1", status: "CREATED" };
+    },
+    async captureOrder(id) {
+      calls.capture.push(id);
+      return {
+        id,
+        status: "COMPLETED",
+        purchase_units: [
+          {
+            reference_id: calls.create.at(-1)?.localOrderId,
+            payments: {
+              captures: [
+                { id: "CAPTURE-1", status: captureStatus, amount: { currency_code: captureCurrency, value: captureAmount } },
+              ],
+            },
+          },
+        ],
+      };
+    },
+    async verifyWebhookSignature(args) {
+      calls.verify.push(args);
+      return { verification_status: verify };
+    },
+  };
+}
