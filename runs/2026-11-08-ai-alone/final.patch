index 0000000..9287ed4
--- /dev/null
+++ b/lib/paypal.js
@@ -0,0 +1,233 @@
+// PayPal REST client (Checkout Orders v2 + webhook verification).
+// All PayPal REST calls go to PAYPAL_API_BASE. The browser SDK host is chosen
+// separately from PAYPAL_ENV in server.js -- never from PAYPAL_API_BASE, which
+// may point at a local recording proxy in tests.
+
+export class PayPalError extends Error {
+  constructor(message, { status = 502, details = null } = {}) {
+    super(message);
+    this.name = "PayPalError";
+    this.status = status;
+    this.details = details;
+  }
+}
+
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  return (cents / 100).toFixed(2);
+}
+
+export function payPalAmountToCents(value) {
+  // PayPal amounts are decimal strings like "49.00". Parse strictly so a
+  // tampered or malformed amount can never compare equal by accident.
+  const match = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(value ?? "").trim());
+  if (!match) return null;
+  return Number(match[1]) * 100 + Number((match[2] ?? "0").padEnd(2, "0"));
+}
+
+function trimBase(base) {
+  return String(base || "https://api-m.sandbox.paypal.com").replace(/\/+$/, "");
+}
+
+export function createPayPalClient({
+  clientId,
+  clientSecret,
+  webhookId = null,
+  apiBase = "https://api-m.sandbox.paypal.com",
+  fetchImpl = globalThis.fetch,
+} = {}) {
+  if (!clientId || !clientSecret) return null;
+  if (typeof fetchImpl !== "function") throw new Error("fetch is not available");
+
+  const base = trimBase(apiBase);
+  let tokenCache = null; // { accessToken, expiresAt }
+
+  async function request(path, { method = "GET", body, headers = {}, authenticated = true } = {}) {
+    const finalHeaders = { accept: "application/json", ...headers };
+    if (authenticated) {
+      finalHeaders.authorization = `Bearer ${await getAccessToken()}`;
+    }
+    if (body !== undefined) finalHeaders["content-type"] = "application/json";
+
+    let res;
+    try {
+      res = await fetchImpl(`${base}${path}`, {
+        method,
+        headers: finalHeaders,
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+    } catch (err) {
+      throw new PayPalError(`PayPal request failed: ${err.message}`, { status: 502 });
+    }
+    const text = await res.text().catch(() => "");
+    let data = null;
+    try {
+      data = text ? JSON.parse(text) : null;
+    } catch {
+      data = text || null;
+    }
+    if (!res.ok) {
+      const message =
+        (data && typeof data === "object" && (data.message || data.error_description || data.name)) ||
+        `PayPal request failed (${res.status})`;
+      throw new PayPalError(String(message), { status: res.status >= 400 && res.status < 500 ? 402 : 502, details: data });
+    }
+    return data;
+  }
+
+  async function getAccessToken() {
+    if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.accessToken;
+    const basic = Buffer.from(`${clientId}:${clientSecret}`).toString("base64");
+    let res;
+    try {
+      res = await fetchImpl(`${base}/v1/oauth2/token`, {
+        method: "POST",
+        headers: {
+          authorization: `Basic ${basic}`,
+          accept: "application/json",
+          "content-type": "application/x-www-form-urlencoded",
+        },
+        body: "grant_type=client_credentials",
+      });
+    } catch (err) {
+      throw new PayPalError(`PayPal authentication failed: ${err.message}`, { status: 502 });
+    }
+    const data = await res.json().catch(() => null);
+    if (!res.ok || !data?.access_token) {
+      throw new PayPalError("PayPal authentication failed", { status: 502, details: data });
+    }
+    const expiresInMs = Number(data.expires_in ?? 3600) * 1000;
+    tokenCache = { accessToken: data.access_token, expiresAt: Date.now() + Math.max(0, expiresInMs - 60_000) };
+    return tokenCache.accessToken;
+  }
+
+  return {
+    apiBase: base,
+    clientId,
+    webhookId,
+
+    getAccessToken,
+
+    // Create a PayPal order for a server-priced cart. The local order id is
+    // carried in custom_id / reference_id / invoice_id so capture and webhook
+    // payloads can be matched back to it without trusting browser amounts.
+    async createOrder({ localOrderId, cart }) {
+      const value = centsToPayPalAmount(cart.totalCents);
+      const currency = String(cart.currency || "usd").toUpperCase();
+      return request("/v2/checkout/orders", {
+        method: "POST",
+        headers: { "paypal-request-id": `${localOrderId}-create` },
+        body: {
+          intent: "CAPTURE",
+          purchase_units: [
+            {
+              reference_id: localOrderId,
+              custom_id: localOrderId,
+              invoice_id: localOrderId,
+              description: `Fogline order ${localOrderId}`,
+              amount: {
+                currency_code: currency,
+                value,
+                breakdown: { item_total: { currency_code: currency, value } },
+              },
+              items: (cart.lines ?? []).map((line) => ({
+                name: String(line.name).slice(0, 127),
+                sku: line.sku,
+                quantity: String(line.qty),
+                unit_amount: { currency_code: currency, value: centsToPayPalAmount(line.unitCents) },
+              })),
+            },
+          ],
+        },
+      });
+    },
+
+    async getOrder(paypalOrderId) {
+      return request(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}`);
+    },
+
+    async captureOrder(paypalOrderId, localOrderId = null) {
+      return request(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+        method: "POST",
+        // Same key on retry makes a repeated capture safe at PayPal.
+        headers: { "paypal-request-id": `${localOrderId ?? paypalOrderId}-${paypalOrderId}-capture` },
+        body: {},
+      });
+    },
+
+    // Verify a webhook via PayPal. Returns true only on SUCCESS.
+    async verifyWebhookSignature({ headers, event }) {
+      if (!webhookId) return false;
+      const data = await request("/v1/notifications/verify-webhook-signature", {
+        method: "POST",
+        body: {
+          auth_algo: headers?.authAlgo,
+          cert_url: headers?.certUrl,
+          transmission_id: headers?.transmissionId,
+          transmission_sig: headers?.transmissionSig,
+          transmission_time: headers?.transmissionTime,
+          webhook_id: webhookId,
+          webhook_event: event,
+        },
+      });
+      return data?.verification_status === "SUCCESS";
+    },
+  };
+}
+
+// Build a client from the environment. Returns null when PayPal is not
+// configured, so the card checkout keeps working without credentials.
+export function createPayPalClientFromEnv(env = process.env) {
+  return createPayPalClient({
+    clientId: env.PAYPAL_CLIENT_ID,
+    clientSecret: env.PAYPAL_CLIENT_SECRET,
+    webhookId: env.PAYPAL_WEBHOOK_ID || null,
+    apiBase: env.PAYPAL_API_BASE || "https://api-m.sandbox.paypal.com",
+  });
+}
+
+// Normalise a capture (from a capture or get-order response) into the facts
+// the shop checks before fulfilling: status, cents, currency, ids.
+export function extractCapture(paypalPayload) {
+  if (!paypalPayload || typeof paypalPayload !== "object") return null;
+  const units = Array.isArray(paypalPayload.purchase_units) ? paypalPayload.purchase_units : [];
+  for (const unit of units) {
+    const captures = unit?.payments?.captures;
+    if (Array.isArray(captures) && captures.length > 0) {
+      const capture = captures[0];
+      return {
+        orderStatus: paypalPayload.status ?? null,
+        captureId: capture.id ?? null,
+        status: capture.status ?? null,
+        cents: payPalAmountToCents(capture.amount?.value),
+        currency: capture.amount?.currency_code ?? null,
+        customId: capture.custom_id ?? unit.custom_id ?? null,
+        referenceId: unit.reference_id ?? null,
+        paypalOrderId: capture.supplementary_data?.related_ids?.order_id ?? paypalPayload.id ?? null,
+      };
+    }
+  }
+  // A bare capture resource (webhook PAYMENT.CAPTURE.* payloads).
+  if (paypalPayload.amount && (paypalPayload.status || paypalPayload.id)) {
+    return {
+      orderStatus: null,
+      captureId: paypalPayload.id ?? null,
+      status: paypalPayload.status ?? null,
+      cents: payPalAmountToCents(paypalPayload.amount?.value),
+      currency: paypalPayload.amount?.currency_code ?? null,
+      customId: paypalPayload.custom_id ?? null,
+      referenceId: null,
+      paypalOrderId: paypalPayload.supplementary_data?.related_ids?.order_id ?? null,
+    };
+  }
+  return {
+    orderStatus: paypalPayload.status ?? null,
+    captureId: null,
+    status: paypalPayload.status ?? null,
+    cents: null,
+    currency: null,
+    customId: units[0]?.custom_id ?? null,
+    referenceId: units[0]?.reference_id ?? null,
+    paypalOrderId: paypalPayload.id ?? null,
+  };
+}
diff --git a/public/app.js b/public/app.js
index fc14e08..d110a29 100644
--- a/public/app.js
+++ b/public/app.js
@@ -116,6 +116,124 @@ export async function showConfirmation(orderId) {
     <p>${order.items.map((i) => `${i.qty} &times; ${i.name}`).join("<br />")}</p><p class="price">${order.total}</p>`;
 }
 
+// --- PayPal / Venmo / Pay Later -------------------------------------------
+// The amount is always priced on the server. The browser only sends SKUs,
+// gets a PayPal order id back, lets the buyer approve it, then asks the
+// server to capture it. The server verifies the captured amount before
+// fulfilling.
+let paypalInitialised = false;
+
+function loadPayPalSdk(config) {
+  if (window.paypal?.Buttons) return Promise.resolve(window.paypal);
+  // PAYPAL_ENV alone chooses the SDK host (never PAYPAL_API_BASE, which is a
+  // server-side REST base and may be a local proxy).
+  const sdkHost =
+    config.env === "live" ? "https://www.paypal.com/sdk/js" : "https://www.sandbox.paypal.com/sdk/js";
+  const params = new URLSearchParams({
+    "client-id": config.clientId,
+    currency: config.currency || "USD",
+    intent: "capture",
+    components: "buttons",
+    "enable-funding": "venmo,paylater",
+  });
+  // Sandbox only: testBuyerCountry (from PAYPAL_TEST_BUYER_COUNTRY) lets test
+  // buyers see Venmo / Pay Later eligibility outside the US.
+  const testBuyerCountry = config.env === "sandbox" ? config.testBuyerCountry : null;
+  if (testBuyerCountry) params.set("buyer-country", testBuyerCountry);
+  const src = config.sdkUrl && config.env !== "live" ? config.sdkUrl : `${sdkHost}?${params.toString()}`;
+  // In live, rebuild from the live host rather than trusting any other base;
+  // in sandbox the server-provided sdkUrl was built the same way.
+  const finalSrc = config.env === "live" ? `${sdkHost}?${params.toString()}` : src;
+  return new Promise((resolve, reject) => {
+    const script = document.createElement("script");
+    script.src = finalSrc;
+    script.async = true;
+    script.dataset.paypalSdk = "true";
+    script.onload = () => resolve(window.paypal);
+    script.onerror = () => reject(new Error("Could not load PayPal checkout"));
+    document.head.appendChild(script);
+  });
+}
+
+async function initPayPal() {
+  if (paypalInitialised) return;
+  const section = $("#paypal-buttons");
+  if (!section) return;
+  let config;
+  try {
+    config = await (await fetch("/api/paypal/config")).json();
+  } catch {
+    section.hidden = true;
+    return;
+  }
+  if (!config.enabled || !config.clientId) {
+    section.hidden = true;
+    return;
+  }
+  paypalInitialised = true;
+  try {
+    const paypal = await loadPayPalSdk(config);
+    if (!paypal?.Buttons) {
+      section.hidden = true;
+      return;
+    }
+    const buttonConfig = {
+      style: { layout: "vertical", label: "paypal" },
+      async createOrder() {
+        showError("");
+        if (bag.read().length === 0) throw new Error("Your bag is empty.");
+        const res = await fetch("/api/paypal/orders", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ items: bag.read(), email: $("#email")?.value || undefined }),
+        });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.error ?? "Could not start PayPal checkout");
+        return data.id ?? data.paypalOrderId;
+      },
+      async onApprove(data) {
+        const paypalOrderId = data.orderID ?? data.id;
+        const res = await fetch(`/api/paypal/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ orderID: paypalOrderId }),
+        });
+        const result = await res.json();
+        if (!res.ok) throw new Error(result.error ?? "PayPal payment failed");
+        await showConfirmation(result.orderId);
+      },
+      onCancel() {
+        showError("PayPal checkout was cancelled.");
+      },
+      onError(err) {
+        showError(err?.message ?? "PayPal checkout failed.");
+      },
+    };
+    const sources = [
+      [paypal.FUNDING?.PAYPAL, "#paypal-button-container"],
+      [paypal.FUNDING?.VENMO, "#venmo-button-container"],
+      [paypal.FUNDING?.PAYLATER, "#paylater-button-container"],
+    ];
+    let renderedAny = false;
+    for (const [fundingSource, selector] of sources) {
+      const container = $(selector);
+      if (!container) continue;
+      try {
+        const buttons = fundingSource ? paypal.Buttons({ ...buttonConfig, fundingSource }) : paypal.Buttons(buttonConfig);
+        if (buttons && typeof buttons.isEligible === "function" && !buttons.isEligible()) continue;
+        await buttons.render(selector);
+        renderedAny = true;
+      } catch {
+        // That funding source is not eligible for this buyer; others may be.
+      }
+    }
+    if (!renderedAny) section.hidden = true;
+  } catch (err) {
+    section.hidden = true;
+    showError(err.message);
+  }
+}
+
 async function payByCard(event) {
   event.preventDefault();
   showError("");
@@ -161,6 +279,7 @@ async function main() {
   $("#close-panel").addEventListener("click", closePanel);
   $("#scrim").addEventListener("click", closePanel);
