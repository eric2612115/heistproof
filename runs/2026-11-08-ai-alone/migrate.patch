+  assert.match(url, /^https:\/\/www\.sandbox\.paypal\.com\/sdk\/js\?/);
+  assert.match(url, /enable-funding=venmo%2Cpaylater/);
+  assert.match(url, /buyer-country=GB/);
+  const live = paypalSdkUrl(paypalConfigFromEnv({ PAYPAL_CLIENT_ID: "cid", PAYPAL_ENV: "live", PAYPAL_TEST_BUYER_COUNTRY: "GB" }));
