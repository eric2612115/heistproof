+import { createCardProcessor } from "../lib/card-processor.js";
+import { createPayPalClient, paypalSdkUrl } from "../lib/paypal.js";
+
+function fakePayPal({ captureAmount = "49.00", verified = true } = {}) {
+  const state = { creates: 0, captures: 0 };
+  return {
+    state,
+    async createOrder({ shopOrderId }) {
+      state.creates += 1;
+      return { id: "PAYPAL-ORDER-1", status: "CREATED", purchase_units: [{ reference_id: shopOrderId, custom_id: shopOrderId }] };
+    },
+    async getOrder() {
+      return { id: "PAYPAL-ORDER-1", status: "APPROVED" };
+    },
+    async captureOrder() {
+      state.captures += 1;
+      return {
+        id: "PAYPAL-ORDER-1",
+        status: "COMPLETED",
+        purchase_units: [
+          {
+            reference_id: state.shopOrderId,
+            payments: { captures: [{ id: "CAPTURE-1", status: "COMPLETED", amount: { value: captureAmount, currency_code: "USD" } }] },
+          },
+        ],
+      };
+    },
+    async verifyWebhookSignature() {
+      return { verification_status: verified ? "SUCCESS" : "FAILURE" };
+    },
+  };
+}
+
+async function startShop(paypal) {
+  const db = openDb(":memory:");
+  // Remember the shop order id the fake was asked to create, for capture refs.
+  const origCreate = paypal.createOrder.bind(paypal);
+  paypal.createOrder = async (args) => {
+    paypal.state.shopOrderId = args.shopOrderId;
+    return origCreate(args);
+  };
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypal });
+  const server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  const base = `http://127.0.0.1:${server.address().port}`;
+  return { db, base, close: () => new Promise((r) => server.close(r)) };
+}
+
+const post = (url, body) => fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body ?? {}) });
+
+test("sdk host comes from PAYPAL_ENV, and buyer-country is sandbox-only", () => {
+  assert.match(paypalSdkUrl({ env: "live", clientId: "abc" }), /^https:\/\/www\.paypal\.com\/sdk\/js\?/);
+  const sandbox = paypalSdkUrl({ env: "sandbox", clientId: "abc", testBuyerCountry: "US" });
+  assert.match(sandbox, /^https:\/\/www\.sandbox\.paypal\.com\/sdk\/js\?/);
+  assert.match(sandbox, /buyer-country=US/);
+  assert.match(sandbox, /enable-funding=venmo%2Cpaylater/);
+  assert.doesNotMatch(paypalSdkUrl({ env: "live", clientId: "abc", testBuyerCountry: "US" }), /buyer-country/);
+});
+
+test("paypal client sends every REST call to PAYPAL_API_BASE", async () => {
+  const calls = [];
+  const fetchImpl = async (url, options) => {
+    calls.push({ url, options });
+    if (url.endsWith("/v1/oauth2/token")) return new Response(JSON.stringify({ access_token: "tok", expires_in: 300 }), { status: 200 });
+    return new Response(JSON.stringify({ id: "PP-1", status: "CREATED" }), { status: 200 });
+  };
+  const client = createPayPalClient({ clientId: "id", clientSecret: "secret", webhookId: "wh", apiBase: "http://127.0.0.1:9/proxy", fetchImpl });
+  const order = await client.createOrder({ shopOrderId: "FOG-1", lines: [{ name: "Hoodie", qty: 1, unitCents: 4900 }], totalCents: 4900, currency: "usd" });
