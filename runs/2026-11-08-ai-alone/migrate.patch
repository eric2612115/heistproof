+// --- PayPal / Venmo / Pay Later ---
+// The server creates and captures every PayPal order; the browser only asks
+// the server to start a payment and to capture the approved one. Amounts
+// never come from the browser.
+
+export function loadPayPalScript(sdkUrl) {
+  return new Promise((resolve, reject) => {
+    if (window.paypal?.Buttons) return resolve(window.paypal);
+    const script = document.createElement("script");
+    script.src = sdkUrl;
+    script.async = true;
+    script.dataset.paypalSdk = "true";
+    script.onload = () => resolve(window.paypal);
+    script.onerror = () => reject(new Error("Could not load PayPal"));
+    document.head.appendChild(script);
+  });
+}
+
+export async function initPayPal() {
+  try {
+    let config = null;
+    try {
+      const res = await fetch("/api/paypal/config");
+      if (res.ok) config = await res.json();
+    } catch {
+      /* PayPal unavailable — card checkout is unaffected. */
+    }
+    if (!window.paypal?.Buttons) {
+      if (!config?.enabled || !(config.sdkUrl || config.scriptUrl || config.paypalSdkUrl)) return;
+      await loadPayPalScript(config.sdkUrl || config.scriptUrl || config.paypalSdkUrl);
+    }
+    if (!window.paypal?.Buttons) return;
+
+    const box = $("#paypal-checkout");
+    if (box) box.hidden = false;
+
+    const callbacks = {
+      async createOrder() {
+        showError("");
+        const items = bag.read();
+        if (!items.length) throw new Error("Your bag is empty.");
+        const res = await fetch("/api/paypal/orders", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ items, email: $("#email")?.value || undefined }),
+        });
+        const data = await res.json().catch(() => ({}));
+        if (!res.ok) throw new Error(data.error ?? "Could not start PayPal checkout");
+        return data.paypalOrderId ?? data.id ?? data.orderID;
+      },
+      async onApprove(data) {
+        const paypalOrderId = data?.orderID ?? data?.orderId ?? data?.id;
+        const res = await fetch(`/api/paypal/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ paypalOrderId }),
+        });
+        const result = await res.json().catch(() => ({}));
+        if (!res.ok) throw new Error(result.error ?? "PayPal payment failed");
+        await showConfirmation(result.orderId ?? result.shopOrderId);
+      },
+      onCancel() {
+        showError("PayPal checkout was cancelled. Your bag is still here.");
+      },
+      onError(err) {
+        showError(err?.message ?? "PayPal payment failed. Please try again.");
+      },
+    };
+
+    const renderButtons = (options, selector) => {
+      try {
+        const buttons = window.paypal.Buttons(options);
+        if (buttons?.isEligible && !buttons.isEligible()) return;
+        buttons.render(selector);
+      } catch {
+        /* That funding source is not eligible for this buyer. */
+      }
+    };
+
+    // One smart-buttons component offers PayPal, Venmo and Pay Later as the
+    // buyer is eligible; explicit funding-source buttons are rendered too.
+    renderButtons({ ...callbacks }, "#paypal-buttons");
+    const funding = window.paypal.FUNDING ?? {};
+    if (funding.VENMO) renderButtons({ ...callbacks, fundingSource: funding.VENMO }, "#paypal-venmo-buttons");
+    if (funding.PAYLATER) renderButtons({ ...callbacks, fundingSource: funding.PAYLATER }, "#paypal-paylater-buttons");
+    else if (funding.PAY_LATER) renderButtons({ ...callbacks, fundingSource: funding.PAY_LATER }, "#paypal-paylater-buttons");
+  } catch (err) {
+    // Never let a PayPal load failure break the card checkout.
+    console.warn("PayPal unavailable:", err?.message ?? err);
+  }
+}
