+import { createPayPalClient, paypalConfigFromEnv, paypalSdkUrl } from "../lib/paypal.js";
+
+const post = (url, body, headers = {}) =>
+  fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body) });
+
+// Fake PayPal REST API recording every call, like the harness proxy.
+function fakePayPalFetch(calls, { captureAmount = "49.00", verify = "SUCCESS" } = {}) {
+  return async (url, opts = {}) => {
+    calls.push({ url, method: opts.method, headers: opts.headers, body: opts.body });
+    const json = (data, status = 200) => new Response(JSON.stringify(data), { status, headers: { "content-type": "application/json" } });
+    if (url.endsWith("/v1/oauth2/token")) return json({ access_token: "tok", expires_in: 3600 });
+    if (url.endsWith("/v2/checkout/orders")) return json({ id: "PAYPAL-ORDER-1", status: "CREATED" });
+    if (url.endsWith("/v2/checkout/orders/PAYPAL-ORDER-1/capture")) {
+      return json({
+        id: "PAYPAL-ORDER-1",
+        status: "COMPLETED",
+        purchase_units: [{
+          payments: { captures: [{ id: "CAP-1", status: "COMPLETED", amount: { value: captureAmount, currency_code: "USD" } }] },
+        }],
+      });
+    }
+    if (url.endsWith("/v1/notifications/verify-webhook-signature")) return json({ verification_status: verify });
+    return json({}, 404);
+  };
+}
+
+async function startShop(opts = {}) {
+  const db = openDb(":memory:");
+  const calls = [];
+  const config = paypalConfigFromEnv({
+    PAYPAL_CLIENT_ID: "client-id",
+    PAYPAL_CLIENT_SECRET: "secret",
+    PAYPAL_WEBHOOK_ID: "wh-1",
+    PAYPAL_API_BASE: "http://paypal.test",
+    PAYPAL_ENV: "sandbox",
+    PAYPAL_TEST_BUYER_COUNTRY: "GB",
+  });
+  const paypal = createPayPalClient(config, fakePayPalFetch(calls, opts));
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypal });
+  const server = await new Promise((resolve) => { const s = app.listen(0, "127.0.0.1", () => resolve(s)); });
+  return { db, calls, base: `http://127.0.0.1:${server.address().port}`, close: () => new Promise((r) => server.close(r)) };
+}
+
+test("sdk url follows PAYPAL_ENV, not the API base, with venmo/paylater + sandbox buyer-country", () => {
+  const cfg = paypalConfigFromEnv({ PAYPAL_CLIENT_ID: "cid", PAYPAL_ENV: "sandbox", PAYPAL_API_BASE: "http://127.0.0.1:9", PAYPAL_TEST_BUYER_COUNTRY: "GB" });
