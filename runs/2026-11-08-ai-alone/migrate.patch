@@ -0,0 +1,204 @@
+// PayPal REST client.
+//
+// Credentials are read only on the server. Every REST call goes to
+// PAYPAL_API_BASE (a local recording proxy in the test harness, PayPal in
+// real use). The browser SDK host is a different decision: it is chosen from
+// PAYPAL_ENV only, never from PAYPAL_API_BASE.
+
+export const DEFAULT_PAYPAL_API_BASE = "https://api-m.sandbox.paypal.com";
+
+function cleanBase(value) {
+  const base = String(value ?? "").trim() || DEFAULT_PAYPAL_API_BASE;
+  return base.replace(/\/+$/, "");
+}
+
+export function paypalConfigFromEnv(env = process.env) {
+  const environment = String(env.PAYPAL_ENV ?? "sandbox").toLowerCase() === "live" ? "live" : "sandbox";
+  return {
+    clientId: env.PAYPAL_CLIENT_ID ?? "",
+    clientSecret: env.PAYPAL_CLIENT_SECRET ?? "",
+    webhookId: env.PAYPAL_WEBHOOK_ID ?? "",
+    apiBase: cleanBase(env.PAYPAL_API_BASE),
+    env: environment,
+    environment,
+    // Sandbox-only test buyer country, forwarded to the browser SDK as
+    // `buyer-country`. Never sent in live mode.
+    testBuyerCountry: environment === "sandbox" ? (env.PAYPAL_TEST_BUYER_COUNTRY ?? "") : "",
+    currency: "USD",
+  };
+}
+
+export function paypalSdkUrl(config) {
+  // Browser script host follows PAYPAL_ENV, never PAYPAL_API_BASE.
+  const host = config.env === "live" ? "https://www.paypal.com" : "https://www.sandbox.paypal.com";
+  const params = new URLSearchParams({
+    "client-id": config.clientId,
+    currency: config.currency ?? "USD",
+    intent: "capture",
+    components: "buttons,messages",
+    "enable-funding": "venmo,paylater",
+  });
+  if (config.env === "sandbox" && config.testBuyerCountry) {
+    params.set("buyer-country", config.testBuyerCountry);
+  }
+  return `${host}/sdk/js?${params.toString()}`;
+}
+
+// Format integer cents the way PayPal amounts require, e.g. 4900 -> "49.00".
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  return (cents / 100).toFixed(2);
+}
+
+// Parse a PayPal decimal-string amount back to integer cents, strictly.
+// Returns null for anything that is not a well-formed amount.
+export function payPalAmountToCents(value) {
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) return null;
+    return Math.round(value * 100);
+  }
+  if (typeof value !== "string") return null;
+  const match = /^(\d+)(?:\.(\d{1,2}))?$/.exec(value.trim());
+  if (!match) return null;
+  return Number(match[1]) * 100 + Number((match[2] ?? "").padEnd(2, "0") || 0);
+}
+
+export function createPayPalClient(configOrEnv = paypalConfigFromEnv(), fetchImpl = globalThis.fetch) {
+  const config = configOrEnv && (configOrEnv.clientId !== undefined || configOrEnv.apiBase !== undefined || configOrEnv.env !== undefined)
+    ? { currency: "USD", testBuyerCountry: "", ...configOrEnv, apiBase: cleanBase(configOrEnv.apiBase) }
+    : paypalConfigFromEnv(configOrEnv);
+  if (typeof fetchImpl !== "function") throw new Error("fetch is not available");
+
+  let tokenCache = null;
+
+  const isConfigured = () => Boolean(config.clientId && config.clientSecret);
+
+  async function readBody(res) {
+    const text = await res.text();
+    if (!text) return {};
+    try {
+      return JSON.parse(text);
+    } catch {
+      return { raw: text };
+    }
+  }
+
+  async function getAccessToken() {
+    if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.accessToken;
+    if (!isConfigured()) throw Object.assign(new Error("PayPal is not configured"), { status: 503 });
+    const basic = Buffer.from(`${config.clientId}:${config.clientSecret}`).toString("base64");
+    const res = await fetchImpl(`${config.apiBase}/v1/oauth2/token`, {
+      method: "POST",
+      headers: {
+        authorization: `Basic ${basic}`,
+        "content-type": "application/x-www-form-urlencoded",
+        accept: "application/json",
+      },
+      body: "grant_type=client_credentials",
+    });
+    const data = await readBody(res);
+    if (!res.ok || !data.access_token) {
+      throw Object.assign(new Error(data.error_description ?? data.message ?? "PayPal authentication failed"), { status: 502 });
+    }
+    const expiresInMs = Number(data.expires_in ?? 300) * 1000;
+    tokenCache = { accessToken: data.access_token, expiresAt: Date.now() + Math.max(expiresInMs - 30_000, 0) };
+    return tokenCache.accessToken;
+  }
+
+  async function api(pathname, { method = "GET", body, headers = {} } = {}) {
+    const token = await getAccessToken();
+    const res = await fetchImpl(`${config.apiBase}${pathname}`, {
+      method,
+      headers: {
+        authorization: `Bearer ${token}`,
+        "content-type": "application/json",
+        accept: "application/json",
+        ...headers,
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    const data = await readBody(res);
+    if (!res.ok) {
+      const message = data.message ?? data.error_description ?? data.name ?? `PayPal request failed (${res.status})`;
+      const err = Object.assign(new Error(message), { status: 502, paypalStatus: res.status, details: data.details ?? data });
+      throw err;
+    }
+    return data;
+  }
+
+  return {
+    config,
+    isConfigured,
+    getAccessToken,
+    api,
+
+    // Creates a PayPal order for a total already priced on the server.
+    // The local order id is carried in reference_id/custom_id so capture and
+    // webhook handlers can bind the PayPal order back to our order without
+    // ever trusting an amount sent by the browser.
+    async createOrder({ localOrderId, totalCents, currency = "USD", lines = [] }) {
+      const currencyCode = String(currency).toUpperCase();
+      const value = centsToPayPalAmount(totalCents);
+      const items = (lines ?? []).map((line) => ({
+        name: String(line.name ?? line.sku ?? "Item").slice(0, 127),
+        quantity: String(line.qty),
+        unit_amount: { currency_code: currencyCode, value: centsToPayPalAmount(line.unitCents) },
+      }));
+      const purchaseUnit = {
+        reference_id: localOrderId,
+        custom_id: localOrderId,
+        invoice_id: localOrderId,
+        amount: {
+          currency_code: currencyCode,
+          value,
+          ...(items.length ? { breakdown: { item_total: { currency_code: currencyCode, value } } } : {}),
+        },
+        ...(items.length ? { items } : {}),
+      };
+      return api("/v2/checkout/orders", {
+        method: "POST",
+        headers: { "PayPal-Request-Id": `create-${localOrderId}` },
+        body: {
+          intent: "CAPTURE",
+          purchase_units: [purchaseUnit],
+          application_context: {
+            brand_name: "Fogline Supply Co.",
+            user_action: "PAY_NOW",
+            shipping_preference: "NO_SHIPPING",
+          },
+        },
+      });
+    },
+
+    async getOrder(paypalOrderId) {
+      return api(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}`);
+    },
+
+    async captureOrder(paypalOrderId) {
+      return api(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+        method: "POST",
+        headers: { "PayPal-Request-Id": `capture-${paypalOrderId}` },
+        body: {},
+      });
+    },
+
+    // Verify a webhook with PayPal before acting on it. Headers come from
+    // the incoming request; the configured webhook id is never sent to the
+    // browser.
+    async verifyWebhookSignature({ headers, webhookEvent }) {
+      if (!config.webhookId) throw Object.assign(new Error("PayPal webhook is not configured"), { status: 503 });
+      return api("/v1/notifications/verify-webhook-signature", {
+        method: "POST",
+        body: {
+          auth_algo: headers?.["paypal-auth-algo"] ?? null,
+          cert_url: headers?.["paypal-cert-url"] ?? null,
+          transmission_id: headers?.["paypal-transmission-id"] ?? null,
+          transmission_sig: headers?.["paypal-transmission-sig"] ?? null,
+          transmission_time: headers?.["paypal-transmission-time"] ?? null,
+          webhook_id: config.webhookId,
+          webhook_event: webhookEvent,
+        },
+      });
+    },
+  };
+}
