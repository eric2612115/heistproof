+let paypalButtonsRendered = false;
+
+function loadPayPalSdk(sdkUrl) {
+  if (window.paypal) return Promise.resolve(window.paypal);
+  return new Promise((resolve, reject) => {
+    const existing = document.querySelector("script[data-paypal-sdk]");
+    if (existing) {
+      existing.addEventListener("load", () => resolve(window.paypal), { once: true });
+      existing.addEventListener("error", reject, { once: true });
+      return;
+    }
+    const script = document.createElement("script");
+    script.src = sdkUrl;
+    script.dataset.paypalSdk = "true";
+    script.async = true;
+    script.onload = () => resolve(window.paypal);
+    script.onerror = () => reject(new Error("Could not load PayPal"));
+    document.head.appendChild(script);
+  });
+}
+
+export async function initPayPal() {
+  const container = $("#paypal-checkout");
+  const buttonsEl = $("#paypal-buttons");
+  if (!container || !buttonsEl || paypalButtonsRendered) return;
+  try {
+    const config = await (await fetch("/api/paypal/config")).json();
+    if (!config.enabled || !config.clientId) return;
+
+    // SDK host/query are supplied by the server from PAYPAL_ENV; fall back to
+    // building the same URL here (never from a PayPal API base URL).
+    let sdkUrl = config.sdkUrl || config.sdk_url;
+    if (!sdkUrl) {
+      const host = config.env === "live" ? "https://www.paypal.com" : "https://www.sandbox.paypal.com";
+      const params = new URLSearchParams({
+        "client-id": config.clientId,
+        currency: config.currency || "USD",
+        intent: "capture",
+        components: "buttons,messages",
+        "enable-funding": "venmo,paylater",
+      });
+      if (config.env !== "live" && (config.testBuyerCountry || config.buyerCountry)) {
+        params.set("buyer-country", config.testBuyerCountry || config.buyerCountry);
+      }
+      sdkUrl = `${host}/sdk/js?${params.toString()}`;
+    }
+
+    const paypal = await loadPayPalSdk(sdkUrl);
+    if (!paypal?.Buttons) return;
+    container.hidden = false;
+
+    // Pay Later messaging, when the messages component is available.
+    const messageEl = $("#paypal-message");
+    if (messageEl && paypal.Messages) {
+      try {
+        await paypal.Messages({ amount: bagTotalCents() / 100, placement: "payment" }).render("#paypal-message");
+      } catch {
+        messageEl.innerHTML = `<div data-pp-message data-pp-placement="payment" data-pp-amount="${(bagTotalCents() / 100).toFixed(2)}"></div>`;
+      }
+    } else if (messageEl) {
+      messageEl.innerHTML = `<div data-pp-message data-pp-placement="payment" data-pp-amount="${(bagTotalCents() / 100).toFixed(2)}"></div>`;
+    }
+
+    paypalButtonsRendered = true;
+    await paypal
+      .Buttons({
+        style: { layout: "vertical" },
+        // The server prices the bag and creates the PayPal order; the
+        // browser never supplies an amount.
+        createOrder: async () => {
+          showError("");
+          const email = document.querySelector("#email")?.value;
+          const res = await fetch("/api/paypal/orders", {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({ items: bag.read(), email }),
+          });
+          const data = await res.json();
+          if (!res.ok) throw new Error(data.error ?? "Could not start PayPal checkout");
+          return data.id;
+        },
+        // Approval is not payment: the server captures and verifies the
+        // amount before anything ships.
+        onApprove: async (data) => {
+          showError("");
+          const res = await fetch(`/api/paypal/orders/${encodeURIComponent(data.orderID)}/capture`, {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({}),
+          });
+          const result = await res.json();
+          if (!res.ok) throw new Error(result.error ?? "Payment failed");
+          await showConfirmation(result.orderId);
+        },
+        onCancel: () => showError("PayPal checkout was cancelled."),
+        onError: (err) => showError(err?.message ?? "PayPal checkout failed. Please try again or pay by card."),
+      })
+      .render("#paypal-buttons");
+  } catch {
+    // PayPal unavailable/unconfigured: the card form keeps working.
+    if (container) container.hidden = true;
+  }
+}
