+// PayPal REST client (Checkout Orders v2 + webhook signature verification).
+//
+// Every REST call goes to `apiBase` (PAYPAL_API_BASE). The browser SDK host
+// is deliberately NOT derived from this value: a test harness may point
+// PAYPAL_API_BASE at a local recording proxy, while the browser must still
+// load the real SDK from PayPal's sandbox or live host (see paypalSdkUrl).
+
+export const DEFAULT_PAYPAL_API_BASE = "https://api-m.sandbox.paypal.com";
+
+export function normalizePayPalEnv(value) {
+  return String(value ?? "").toLowerCase() === "live" ? "live" : "sandbox";
+}
+
+// The browser script is chosen ONLY from PAYPAL_ENV, never from PAYPAL_API_BASE.
+export function paypalSdkBase(env) {
+  return normalizePayPalEnv(env) === "live" ? "https://www.paypal.com" : "https://www.sandbox.paypal.com";
+}
+
+export function paypalSdkUrl({ env, clientId, currency = "USD", testBuyerCountry } = {}) {
+  const params = new URLSearchParams({
+    "client-id": clientId ?? "",
+    currency: String(currency || "USD").toUpperCase(),
+    intent: "capture",
+    components: "buttons",
+    "enable-funding": "venmo,paylater",
+    "disable-funding": "card",
+  });
+  // buyer-country is a sandbox-only SDK testing parameter; never send it live.
+  if (normalizePayPalEnv(env) === "sandbox" && testBuyerCountry) {
+    params.set("buyer-country", String(testBuyerCountry).toUpperCase());
+  }
+  return `${paypalSdkBase(env)}/sdk/js?${params.toString()}`;
+}
+
+// Integer cents -> PayPal decimal string ("49.00"), without floats.
+export function centsToPayPalValue(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, "0")}`;
+}
+
+// PayPal decimal string ("49.00") -> integer cents, without floats.
+export function payPalValueToCents(value) {
+  const text = String(value ?? "").trim();
+  const match = /^(\d+)(?:\.(\d{1,2}))?$/.exec(text);
+  if (!match) return null;
+  return Number(match[1]) * 100 + Number((match[2] ?? "").padEnd(2, "0") || 0);
+}
+
+export function paypalConfigFromEnv(env = process.env) {
+  const paypalEnv = normalizePayPalEnv(env.PAYPAL_ENV);
+  const testBuyerCountry =
+    paypalEnv === "sandbox" && env.PAYPAL_TEST_BUYER_COUNTRY ? String(env.PAYPAL_TEST_BUYER_COUNTRY).toUpperCase() : null;
+  return {
+    clientId: env.PAYPAL_CLIENT_ID ?? null,
+    clientSecret: env.PAYPAL_CLIENT_SECRET ?? null,
+    webhookId: env.PAYPAL_WEBHOOK_ID ?? null,
+    apiBase: (env.PAYPAL_API_BASE ?? DEFAULT_PAYPAL_API_BASE).replace(/\/+$/, ""),
+    env: paypalEnv,
+    testBuyerCountry,
+    currency: "USD",
+  };
+}
+
+export function createPayPalClient(config = {}) {
+  const clientId = config.clientId ?? null;
+  const clientSecret = config.clientSecret ?? null;
+  const webhookId = config.webhookId ?? null;
+  const apiBase = (config.apiBase ?? DEFAULT_PAYPAL_API_BASE).replace(/\/+$/, "");
+  const fetchImpl = config.fetchImpl ?? config.fetch ?? globalThis.fetch;
+  if (typeof fetchImpl !== "function") throw new Error("fetch is not available");
+
+  let tokenCache = null;
+
+  const enabled = Boolean(clientId && clientSecret);
+
+  async function request(path, { method = "GET", body, headers = {} } = {}) {
+    const res = await fetchImpl(`${apiBase}${path}`, {
+      method,
+      headers: { "content-type": "application/json", ...headers },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    const text = await res.text();
+    let data = null;
+    try {
+      data = text ? JSON.parse(text) : null;
+    } catch {
+      data = text;
+    }
+    if (!res.ok) {
+      const message = data?.message || data?.error_description || data?.error || `PayPal request failed (${res.status})`;
+      const err = new Error(message);
+      err.status = res.status;
+      err.paypal = data;
+      throw err;
+    }
+    return data;
+  }
+
+  async function getAccessToken() {
+    if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.value;
+    if (!enabled) throw new Error("PayPal is not configured");
+    const basic = Buffer.from(`${clientId}:${clientSecret}`).toString("base64");
+    const res = await fetchImpl(`${apiBase}/v1/oauth2/token`, {
+      method: "POST",
+      headers: { authorization: `Basic ${basic}`, "content-type": "application/x-www-form-urlencoded" },
+      body: "grant_type=client_credentials",
+    });
+    const text = await res.text();
+    let data = null;
+    try {
+      data = text ? JSON.parse(text) : null;
+    } catch {
+      data = null;
+    }
+    if (!res.ok || !data?.access_token) {
+      const err = new Error(data?.error_description || data?.message || `PayPal auth failed (${res.status})`);
+      err.status = res.status;
+      err.paypal = data;
+      throw err;
+    }
+    tokenCache = { value: data.access_token, expiresAt: Date.now() + Number(data.expires_in ?? 300) * 1000 };
+    return tokenCache.value;
+  }
+
+  async function authed(path, options = {}) {
+    const token = await getAccessToken();
+    return request(path, { ...options, headers: { authorization: `Bearer ${token}`, ...(options.headers ?? {}) } });
+  }
+
+  return {
+    enabled,
+    config: { clientId, apiBase, webhookId, env: config.env, testBuyerCountry: config.testBuyerCountry ?? null },
+
+    // Creates a CAPTURE order for exactly the server-priced total. The shop
+    // order id is carried as reference_id and custom_id so capture and
+    // webhook payloads can be reconciled back to the local order.
+    async createOrder({ shopOrderId, lines, totalCents, currency = "USD" }) {
+      const cur = String(currency).toUpperCase();
+      const value = centsToPayPalValue(totalCents);
+      return authed("/v2/checkout/orders", {
+        method: "POST",
+        headers: { "paypal-request-id": String(shopOrderId) },
+        body: {
+          intent: "CAPTURE",
+          purchase_units: [
+            {
+              reference_id: String(shopOrderId),
+              custom_id: String(shopOrderId),
+              description: `Fogline order ${shopOrderId}`,
+              amount: {
+                currency_code: cur,
+                value,
+                breakdown: { item_total: { currency_code: cur, value } },
+              },
+              items: (lines ?? []).map((line) => ({
+                name: String(line.name ?? line.sku ?? "Item").slice(0, 127),
+                quantity: String(line.qty),
+                unit_amount: { currency_code: cur, value: centsToPayPalValue(line.unitCents) },
+              })),
+            },
+          ],
+          application_context: {
+            brand_name: "Fogline Supply Co.",
+            shipping_preference: "NO_SHIPPING",
+            user_action: "PAY_NOW",
+          },
+        },
+      });
+    },
+
+    async getOrder(paypalOrderId) {
+      return authed(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}`);
+    },
+
+    async captureOrder(paypalOrderId, { requestId } = {}) {
+      return authed(`/v2/checkout/orders/${encodeURIComponent(paypalOrderId)}/capture`, {
+        method: "POST",
+        headers: requestId ? { "paypal-request-id": String(requestId) } : {},
+        body: {},
+      });
+    },
+
+    // https://developer.paypal.com/docs/api/webhooks/v1/#verify-webhook-signature
+    async verifyWebhookSignature({ headers, webhookEvent }) {
+      if (!webhookId) throw new Error("PayPal webhook id is not configured");
+      const get = (name) => headers?.[name] ?? headers?.get?.(name) ?? null;
+      return authed("/v1/notifications/verify-webhook-signature", {
+        method: "POST",
+        body: {
+          auth_algo: get("paypal-auth-algo"),
+          cert_url: get("paypal-cert-url"),
+          transmission_id: get("paypal-transmission-id"),
+          transmission_sig: get("paypal-transmission-sig"),
+          transmission_time: get("paypal-transmission-time"),
+          webhook_id: webhookId,
+          webhook_event: webhookEvent,
+        },
+      });
+    },
+  };
+}
+
+// Extracts the completed capture from an Orders v2 capture/get response.
+export function extractCapture(paypalResult) {
+  if (!paypalResult || typeof paypalResult !== "object") return { status: null, capture: null };
+  const units = Array.isArray(paypalResult.purchase_units) ? paypalResult.purchase_units : [];
+  for (const unit of units) {
+    const captures = unit?.payments?.captures;
+    if (Array.isArray(captures) && captures.length) {
+      const completed = captures.find((c) => String(c.status).toUpperCase() === "COMPLETED") ?? captures[0];
+      return { status: completed.status ?? paypalResult.status ?? null, capture: completed, unit };
+    }
+  }
+  // Some gateways return the capture resource itself.
+  if (paypalResult.amount && paypalResult.status) return { status: paypalResult.status, capture: paypalResult, unit: units[0] ?? null };
+  return { status: paypalResult.status ?? null, capture: null, unit: units[0] ?? null };
+}
+
+export function shopOrderIdFromPayPal(result) {
+  if (!result || typeof result !== "object") return null;
+  const unit = Array.isArray(result.purchase_units) ? result.purchase_units[0] : null;
+  return (
+    unit?.custom_id ??
+    unit?.reference_id ??
+    result.custom_id ??
+    result.resource?.custom_id ??
+    null
+  );
+}
