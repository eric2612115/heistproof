+function captureOrderJson({ id, custom, value, captureStatus = "COMPLETED", captureValue = value }) {
+  return {
+    id,
+    status: captureStatus === "COMPLETED" ? "COMPLETED" : "APPROVED",
+    purchase_units: [{
+      custom_id: custom,
+      amount: { currency_code: "USD", value },
+      payments: { captures: [{ id: "CAP-1", status: captureStatus, amount: { currency_code: "USD", value: captureValue }, custom_id: custom }] },
+    }],
+  };
+}
+
+// Faked fetch: the SDK sees token-first, then operations; webhook verify/token share the seam.
+function makeFakePayPal() {
+  const state = {
+    calls: [],
+    custom: null,
+    value: null,
+    captureMode: "success",
+    createMode: "success",
+    verify: "SUCCESS",
+    tokenFails: false,
+    onCreate: null,
+    paypalId: "PAYPAL-ORDER-1",
+  };
+  const fetchImpl = async (input, init) => {
+    const request = new Request(input, init);
+    const body = request.body ? await request.text() : "";
+    const url = new URL(request.url);
+    state.calls.push({ url, request, body, method: request.method });
+    const path = url.pathname;
+    if (path === "/v1/oauth2/token") {
+      if (state.tokenFails) return json(401, { error: "invalid_client", error_description: "bad credentials" });
+      return json(200, { access_token: "TOKEN-1", token_type: "Bearer", expires_in: 3600 });
+    }
+    if (path === "/v1/notifications/verify-webhook-signature") {
+      return json(200, { verification_status: state.verify });
+    }
+    if (path === "/v2/checkout/orders" && request.method === "POST") {
+      const parsed = JSON.parse(body);
+      state.custom = parsed.purchase_units[0].custom_id;
+      state.value = parsed.purchase_units[0].amount.value;
+      if (state.onCreate) state.onCreate(parsed);
+      if (state.createMode === "connection") throw new Error("socket hang up");
+      return json(201, {
+        id: state.paypalId,
+        status: "CREATED",
+        purchase_units: [{ custom_id: state.custom, amount: { currency_code: "USD", value: state.value } }],
+      });
+    }
+    const capMatch = /^\/v2\/checkout\/orders\/([^/]+)\/capture$/.exec(path);
+    if (capMatch && request.method === "POST") {
+      // Real PayPal sandbox: a capture with no body / no Content-Type is
+      // rejected with 415 UNSUPPORTED_MEDIA_TYPE (see harness report).
+      if (!request.headers.get("content-type")?.includes("application/json") || !body) {
+        return json(415, { name: "UNSUPPORTED_MEDIA_TYPE", message: "The request payload is not supported", debug_id: "dbg-415" });
+      }
+      switch (state.captureMode) {
+        case "success": return json(200, captureOrderJson({ id: capMatch[1], custom: state.custom, value: state.value }));
+        case "pending": return json(200, captureOrderJson({ id: capMatch[1], custom: state.custom, value: state.value, captureStatus: "PENDING" }));
+        case "wrongAmount": return json(200, captureOrderJson({ id: capMatch[1], custom: state.custom, value: state.value, captureValue: "0.01" }));
+        case "wrongCustom": return json(200, captureOrderJson({ id: capMatch[1], custom: "FOG-OTHER", value: state.value }));
+        case "declined": return json(422, errorBody("INSTRUMENT_DECLINED", "The instrument was declined"));
+        case "alreadyCaptured": return json(422, errorBody("ORDER_ALREADY_CAPTURED", "Order already captured"));
+        case "connection": throw new Error("socket hang up");
+        default: throw new Error(`unknown captureMode ${state.captureMode}`);
+      }
+    }
+    const getMatch = /^\/v2\/checkout\/orders\/([^/]+)$/.exec(path);
+    if (getMatch && request.method === "GET") {
+      return json(200, captureOrderJson({ id: getMatch[1], custom: state.custom, value: state.value }));
+    }
+    return json(404, errorBody("NOT_FOUND", "no fake route"));
+  };
+  return { state, fetchImpl };
+}
+
+async function startShop(fake, serviceOpts = {}) {
+  const db = openDb(":memory:");
+  const paypal = createPayPalService({
+    clientId: "test-client-id",
+    clientSecret: SECRET,
+    webhookId: "WH-TEST-1",
+    apiBase: "https://api-m.sandbox.paypal.com",
+    env: "sandbox",
+    fetchImpl: fake.fetchImpl,
+    ...serviceOpts,
+  });
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypal });
+  const server = await new Promise((resolve) => { const s = app.listen(0, "127.0.0.1", () => resolve(s)); });
+  return { db, paypal, base: `http://127.0.0.1:${server.address().port}`, close: () => new Promise((r) => server.close(r)) };
+}
+
+const post = (url, body, headers = {}) => fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: body === undefined ? undefined : JSON.stringify(body) });
+const callsTo = (fake, suffix, method) => fake.state.calls.filter((c) => c.url.pathname.endsWith(suffix) && (!method || c.method === method));
+
+async function createViaHttp(shop, fake) {
+  const res = await post(`${shop.base}/api/paypal/orders`, {
+    items: [{ sku: "FOG-HOODIE", qty: 1, price: 1, amount: "0.01", total: "0.01", currency: "EUR" }],
+    email: "buyer@example.com",
+  });
+  assert.equal(res.status, 200);
+  return res.json();
+}
+function webhook(shop, event, fake) {
+  return post(`${shop.base}/api/paypal/webhooks`, event, {
+    "paypal-auth-algo": "SHA256withRSA",
+    "paypal-cert-url": "https://api-m.sandbox.paypal.com/certs/1",
+    "paypal-transmission-id": "trans-1",
+    "paypal-transmission-sig": "sig-1",
+    "paypal-transmission-time": "2026-01-01T00:00:00Z",
+  });
+}
+const captureEvent = (id, shopOrderId, paypalId, value = "49.00") => ({
+  id, event_type: "PAYMENT.CAPTURE.COMPLETED",
+  resource: { id: "CAP-1", status: "COMPLETED", amount: { value, currency_code: "USD" }, custom_id: shopOrderId, supplementary_data: { related_ids: { order_id: paypalId } } },
+});
