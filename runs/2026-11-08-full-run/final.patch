+test("capture verifies amount/custom_id and fulfils exactly once; second and concurrent captures are safe", async () => {
+  const fake = makeFakePayPal();
+  const shop = await startShop(fake);
+  try {
+    const { orderId } = await createViaHttp(shop, fake);
+    const [r1, r2] = await Promise.all([
+      post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`, undefined, { "paypal-mock-response": '{"mock_application_codes":"INSTRUMENT_DECLINED"}' }),
+      post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`),
+    ]);
+    assert.equal(r1.status, 200);
+    assert.equal(r2.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.getOrder(orderId).paid_cents, 4900);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+    // The browser's negative-testing header was never forwarded to PayPal.
+    for (const c of callsTo(fake, "/capture", "POST")) assert.equal(c.request.headers.get("paypal-mock-response"), null);
+    // Sequential second capture: answered locally, no second shipment.
+    const again = await post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`);
+    assert.equal(again.status, 200);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally { await shop.close(); }
+});
