+function json(status, body) {
+  return new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+}
+function errorBody(issue, description = "PayPal said no") {
+  return { name: "UNPROCESSABLE_ENTITY", message: description, debug_id: "dbg-1", details: [{ issue, description }] };
