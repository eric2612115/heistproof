@@ -0,0 +1,106 @@
+// PayPal Web SDK v6: PayPal, Venmo and Pay Later next to the card form.
+// The browser sends only SKUs and quantities; the server prices and decides if an order is paid.
+export async function initPayPalCheckout({ bag, bagTotalCents, showError, showConfirmation }) {
+  let config;
+  try {
+    config = await (await fetch("/api/paypal/config")).json();
+  } catch {
+    return; // PayPal unavailable; card checkout keeps working.
+  }
+  if (!config?.clientId || !config?.scriptUrl) return;
+
+  await new Promise((resolve, reject) => {
+    const s = document.createElement("script");
+    s.async = true;
+    s.src = config.scriptUrl; // sandbox or live URL chosen server-side from PAYPAL_ENV
+    s.onload = resolve;
+    s.onerror = reject;
+    document.head.appendChild(s);
+  }).catch(() => null);
+  if (!window.paypal) return;
+
+  const sdk = await window.paypal.createInstance({
+    clientId: config.clientId,
+    components: ["paypal-payments", "venmo-payments", "paypal-messages"],
+    pageType: "checkout",
+    ...(config.testBuyerCountry ? { testBuyerCountry: config.testBuyerCountry } : {}),
+  });
+  sdk.createPayPalMessages();
+
+  const section = document.querySelector("#paypal-section");
+  const message = document.querySelector("#paylater-message");
+  const updateMessage = () => {
+    const amount = (bagTotalCents() / 100).toFixed(2);
+    if (message) message.amount = amount;
+  };
+  document.addEventListener("bag:change", updateMessage);
+  updateMessage();
+
+  const methods = await sdk.findEligibleMethods({ currencyCode: "USD" });
+  section.hidden = false;
+
+  async function createOrder() {
+    const email = document.querySelector("#email")?.value;
+    const res = await fetch("/api/paypal/orders", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ items: bag.read(), ...(email ? { email } : {}) }),
+    });
+    const data = await res.json();
+    if (!res.ok) throw new Error(data.error ?? "Could not start PayPal checkout");
+    return { orderId: data.id };
+  }
+
+  const handlers = {
+    async onApprove({ orderId }) {
+      try {
+        const res = await fetch(`/api/paypal/orders/${encodeURIComponent(orderId)}/capture`, { method: "POST" });
+        const data = await res.json();
+        if (res.status === 202 || data.status === "pending") {
+          showError("Payment is pending; we will confirm when PayPal completes it.");
+          return;
+        }
+        if (!res.ok) throw new Error(data.error ?? "Payment failed");
+        await showConfirmation(data.orderId);
+      } catch (err) {
+        showError(err.message);
+      }
+    },
+    onCancel() {
+      showError("PayPal checkout was cancelled; nothing was charged.");
+    },
+    onError(error) {
+      showError(error?.message ?? "PayPal checkout failed; nothing was charged.");
+    },
+  };
+
+  const sessions = [
+    ["paypal", "#paypal-button", () => sdk.createPayPalOneTimePaymentSession(handlers)],
+    ["venmo", "#venmo-button", () => sdk.createVenmoOneTimePaymentSession(handlers)],
+    ["paylater", "#paylater-button", () => sdk.createPayLaterOneTimePaymentSession(handlers)],
+  ];
+
+  for (const [method, selector, makeSession] of sessions) {
+    if (!methods.isEligible(method)) continue;
+    const button = document.querySelector(selector);
+    if (!button) continue;
+    if (method === "paylater") {
+      const { productCode, countryCode } = methods.getDetails("paylater");
+      button.productCode = productCode;
+      button.countryCode = countryCode;
+    }
+    const session = makeSession();
+    button.hidden = false;
+    button.addEventListener("click", async () => {
+      showError("");
+      // Do NOT await createOrder() before start(): awaiting loses the click's
+      // transient activation and the popup is blocked.
+      const createOrderPromise = createOrder();
+      try {
+        await session.start({ presentationMode: "auto" }, createOrderPromise);
+      } catch (err) {
+        showError(err?.message ?? "PayPal checkout failed; nothing was charged.");
+      }
+    });
+  }
+}
