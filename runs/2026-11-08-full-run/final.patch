index 0000000..d4a7431
--- /dev/null
+++ b/lib/paypal.js
@@ -0,0 +1,294 @@
+import { PaypalClient, PaypalError } from "paypal";
+
+// One function owns the cents -> PayPal decimal-string conversion (rule 2).
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, "0")}`;
+}
+
+export function payPalAmountToCents(value) {
+  if (typeof value !== "string") return null;
+  const m = /^(\d+)(?:\.(\d{1,2}))?$/.exec(value.trim());
+  if (!m) return null;
+  return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0") || 0);
+}
+
+export class PayPalServiceError extends Error {
+  constructor(message, { status = 502, issue = null, unknown = false, apiStatus = null, cause } = {}) {
+    super(message, cause ? { cause } : undefined);
+    this.name = "PayPalServiceError";
+    this.status = status;
+    this.issue = issue;
+    this.unknown = unknown;
+    this.apiStatus = apiStatus;
+  }
+}
+
+const FIXED = {
+  credentials: "PayPal is unavailable: our PayPal credentials were rejected.",
+  quota: "PayPal is temporarily unavailable: our PayPal quota is exhausted.",
+  provider: "PayPal is unavailable right now. Please try again later.",
+  unknown: "PayPal did not confirm the outcome. Your order has not been charged by us; please check before trying again.",
+};
+
+function reasonFromPayload(payload) {
+  try {
+    let body = null;
+    if (payload && "rawBody" in payload) {
+      const text = new TextDecoder().decode(payload.rawBody);
+      try { body = JSON.parse(text); } catch { return text.slice(0, 300) || null; }
+    } else if (payload?.body) {
+      body = payload.body;
+    }
+    if (!body) return null;
+    // SDK-decoded Error model uses camelCase; raw JSON uses snake_case. Handle both.
+    const details = body.details ?? [];
+    const parts = [
+      body.message,
+      ...details.map((d) => d.description ?? d.issue),
+    ].filter(Boolean);
+    return parts.join(" — ").slice(0, 500) || body.name || null;
+  } catch {
+    return null;
+  }
+}
+
+function issueFromPayload(payload) {
+  try {
+    let body = null;
+    if (payload && "rawBody" in payload) {
+      body = JSON.parse(new TextDecoder().decode(payload.rawBody));
+    } else if (payload?.body) body = payload.body;
+    return body?.details?.find((d) => d?.issue)?.issue ?? null;
+  } catch {
+    return null;
+  }
+}
+
+// Translate the SDK error family (narrowed on err.kind, paypal:typescript-error-handling)
+// into our HTTP-facing error, per plan table 1b.4. Non-family throwables are rethrown.
+export function translatePayPalError(err, { isWrite = false } = {}) {
+  if (err instanceof PayPalServiceError) return err;
+  if (err instanceof PaypalError) {
+    switch (err.kind) {
+      case "api": {
+        const reason = reasonFromPayload(err.payload);
+        const issue = issueFromPayload(err.payload);
+        if (err.status === 401 || err.status === 403) {
+          return new PayPalServiceError(FIXED.credentials, { status: 502, apiStatus: err.status, issue, cause: err });
+        }
+        if (err.status === 429) {
+          return new PayPalServiceError(FIXED.quota, { status: 503, apiStatus: err.status, issue, cause: err });
+        }
+        if (err.status >= 400 && err.status < 500) {
+          return new PayPalServiceError(reason ?? "PayPal rejected the request.", { status: err.status, apiStatus: err.status, issue, cause: err });
+        }
+        return new PayPalServiceError(FIXED.provider, { status: 502, apiStatus: err.status, issue, cause: err });
+      }
+      case "connection":
+      case "timeout":
+        return isWrite
+          ? new PayPalServiceError(FIXED.unknown, { status: 502, unknown: true, cause: err })
+          : new PayPalServiceError(FIXED.provider, { status: 502, cause: err });
+      case "decode":
+        // A malformed 2xx on a write means the outcome is unknown; on an error status the
+        // provider rejected us and only the detail was lost.
+        if (isWrite && err.status >= 200 && err.status < 300) {
+          return new PayPalServiceError(FIXED.unknown, { status: 502, unknown: true, apiStatus: err.status, cause: err });
+        }
+        if (err.status >= 400 && err.status < 500) {
+          return new PayPalServiceError("PayPal rejected the request.", { status: err.status, apiStatus: err.status, cause: err });
+        }
+        return new PayPalServiceError(FIXED.provider, { status: 502, apiStatus: err.status, cause: err });
+      case "encode":
+      case "auth":
+        // Nothing was sent: our integration/credentials, not the caller's fault. No re-read.
+        return new PayPalServiceError(FIXED.credentials, { status: 502, cause: err });
+      default:
+        return new PayPalServiceError(FIXED.provider, { status: 502, cause: err });
+    }
+  }
+  return err;
+}
+
+export function payPalScriptUrl(env) {
+  return env === "live"
+    ? "https://www.paypal.com/web-sdk/v6/core"
+    : "https://www.sandbox.paypal.com/web-sdk/v6/core";
+}
+
+export function createPayPalService({
+  clientId,
+  clientSecret,
+  webhookId,
+  apiBase = "https://api-m.sandbox.paypal.com",
+  env = "sandbox",
+  testBuyerCountry,
+  fetchImpl,
+  client: injectedClient,
+} = {}) {
+  const base = String(apiBase || "https://api-m.sandbox.paypal.com").replace(/\/+$/, "");
+  const effectiveEnv = env === "live" ? "live" : "sandbox";
+  const doFetch = fetchImpl ?? globalThis.fetch;
+
+  let client = injectedClient ?? null;
+  function getClient() {
+    if (client) return client;
+    if (!clientId) throw new PayPalServiceError("PAYPAL_CLIENT_ID is not configured.", { status: 502 });
+    if (!clientSecret) throw new PayPalServiceError("PAYPAL_CLIENT_SECRET is not configured.", { status: 502 });
+    client = new PaypalClient({
+      oauth2: { clientId, clientSecret },
+      serverOptions: { baseUrl: base },
+      ...(fetchImpl ? { fetch: fetchImpl } : {}),
+      retry: { timeout: 30_000 },
+      logging: { level: "off" },
+    });
+    return client;
+  }
+
+  // --- Webhook verification token (SDK has no webhook surface; see paypal-plan.md) ---
+  let tokenCache = null;
+  async function getAccessToken() {
+    if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.token;
+    if (!clientId) throw new PayPalServiceError("PAYPAL_CLIENT_ID is not configured.", { status: 502 });
+    if (!clientSecret) throw new PayPalServiceError("PAYPAL_CLIENT_SECRET is not configured.", { status: 502 });
+    const res = await doFetch(`${base}/v1/oauth2/token`, {
+      method: "POST",
+      headers: {
+        authorization: `Basic ${Buffer.from(`${clientId}:${clientSecret}`).toString("base64")}`,
+        "content-type": "application/x-www-form-urlencoded",
+      },
+      body: "grant_type=client_credentials",
+    });
+    if (!res.ok) throw new PayPalServiceError(FIXED.credentials, { status: 502 });
+    const data = await res.json();
+    if (!data.access_token) throw new PayPalServiceError(FIXED.credentials, { status: 502 });
+    tokenCache = {
+      token: data.access_token,
+      expiresAt: Date.now() + (Number(data.expires_in) > 0 ? Number(data.expires_in) * 1000 : 3600_000),
+    };
+    return tokenCache.token;
+  }
+
+  return {
+    config: {
+      clientId: clientId ?? null,
+      env: effectiveEnv,
+      scriptUrl: payPalScriptUrl(effectiveEnv),
+      currency: "USD",
+      ...(effectiveEnv === "sandbox" && testBuyerCountry ? { testBuyerCountry } : {}),
+    },
+
+    async createOrder({ shopOrderId, cart }) {
+      try {
+        const c = getClient();
+        const total = centsToPayPalAmount(cart.totalCents);
+        const order = await c.orders.createOrder({
+          payPalRequestId: shopOrderId,
+          prefer: "return=representation",
+          body: {
+            intent: "CAPTURE",
+            purchaseUnits: [
+              {
+                customId: shopOrderId,
+                invoiceId: shopOrderId,
+                amount: {
+                  currencyCode: "USD",
+                  value: total,
+                  breakdown: { itemTotal: { currencyCode: "USD", value: total } },
+                },
+                items: cart.lines.map((l) => ({
+                  name: l.name,
+                  sku: l.sku,
+                  quantity: String(l.qty),
+                  unitAmount: { currencyCode: "USD", value: centsToPayPalAmount(l.unitCents) },
+                })),
+              },
+            ],
+          },
+        });
+        if (!order?.id) {
+          throw new PayPalServiceError(FIXED.unknown, { status: 502, unknown: true });
+        }
+        const pu = order.purchaseUnits?.[0];
+        if (pu) {
+          if (pu.customId !== undefined && pu.customId !== shopOrderId) {
+            throw new PayPalServiceError(FIXED.unknown, { status: 502, unknown: true });
+          }
+          if (pu.amount?.value !== undefined && payPalAmountToCents(pu.amount.value) !== cart.totalCents) {
+            throw new PayPalServiceError(FIXED.unknown, { status: 502, unknown: true });
+          }
+        }
+        return order;
+      } catch (err) {
+        throw translatePayPalError(err, { isWrite: true });
+      }
+    },
+
+    async captureOrder({ paypalOrderId, shopOrderId }) {
+      try {
+        const c = getClient();
+        const order = await c.orders.captureOrder({
+          id: paypalOrderId,
+          payPalRequestId: `capture-${shopOrderId}`,
+          prefer: "return=representation",
+          // Real PayPal sandbox rejects a bodiless capture (no Content-Type)
+          // with 415 UNSUPPORTED_MEDIA_TYPE. Send an empty JSON object so the
+          // SDK sends Content-Type: application/json and body "{}".
+          // paymentSource inside the body remains unset.
+          body: {},
+        });
+        if (!order || typeof order !== "object") {
+          throw new PayPalServiceError(FIXED.unknown, { status: 502, unknown: true });
+        }
+        return order;
+      } catch (err) {
+        throw translatePayPalError(err, { isWrite: true });
+      }
+    },
+
+    async getOrder({ paypalOrderId }) {
+      try {
+        const c = getClient();
+        return await c.orders.getOrder({ id: paypalOrderId });
+      } catch (err) {
+        throw translatePayPalError(err, { isWrite: false });
+      }
+    },
+
+    // Rule 6: verify with PayPal before trusting any webhook. Returns true only on SUCCESS.
+    async verifyWebhook({ headers, event }) {
+      if (!webhookId) throw new PayPalServiceError("PAYPAL_WEBHOOK_ID is not configured.", { status: 502 });
+      const token = await getAccessToken();
+      const res = await doFetch(`${base}/v1/notifications/verify-webhook-signature`, {
+        method: "POST",
+        headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
+        body: JSON.stringify({
+          auth_algo: headers.authAlgo,
+          cert_url: headers.certUrl,
+          transmission_id: headers.transmissionId,
+          transmission_sig: headers.transmissionSig,
+          transmission_time: headers.transmissionTime,
+          webhook_id: webhookId,
+          webhook_event: event,
+        }),
+      });
+      if (!res.ok) return false;
+      const data = await res.json().catch(() => null);
+      return data?.verification_status === "SUCCESS";
+    },
+  };
+}
+
+export function createPayPalServiceFromEnv(envVars = process.env, { fetchImpl } = {}) {
+  const ppEnv = envVars.PAYPAL_ENV ?? "sandbox";
+  return createPayPalService({
+    clientId: envVars.PAYPAL_CLIENT_ID,
+    clientSecret: envVars.PAYPAL_CLIENT_SECRET,
+    webhookId: envVars.PAYPAL_WEBHOOK_ID,
+    apiBase: envVars.PAYPAL_API_BASE ?? "https://api-m.sandbox.paypal.com",
+    env: ppEnv,
+    testBuyerCountry: envVars.PAYPAL_TEST_BUYER_COUNTRY,
+    fetchImpl,
+  });
+}
