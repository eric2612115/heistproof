+test("create prices from the catalog, binds custom_id, sends only required fields, and does not pay", async () => {
+  const fake = makeFakePayPal();
+  const shop = await startShop(fake);
+  try {
+    let atCreate = null;
+    fake.state.onCreate = (body) => { atCreate = shop.db.getOrder(body.purchase_units[0].custom_id); };
+    const data = await createViaHttp(shop, fake);
+    assert.equal(data.id, "PAYPAL-ORDER-1");
+    // Claim existed (pending shop order) when the create request left.
+    assert.equal(atCreate.status, "pending");
+    const order = shop.db.getOrder(data.orderId);
+    assert.equal(order.status, "pending");
+    assert.equal(order.paypal_order_id, "PAYPAL-ORDER-1");
+    assert.equal(order.total_cents, 4900);
+    assert.equal(shop.db.shipmentsFor(data.orderId).length, 0);
+
+    const createCall = callsTo(fake, "/v2/checkout/orders", "POST")[0];
+    const wire = JSON.parse(createCall.body);
+    assert.deepEqual(Object.keys(wire).sort(), ["intent", "purchase_units"]);
+    assert.equal(wire.intent, "CAPTURE");
+    const pu = wire.purchase_units[0];
+    assert.deepEqual(Object.keys(pu).sort(), ["amount", "custom_id", "invoice_id", "items"]);
+    assert.equal(pu.custom_id, data.orderId);
+    assert.equal(pu.invoice_id, data.orderId);
+    assert.equal(pu.amount.value, "49.00");
+    assert.equal(pu.amount.breakdown.item_total.value, "49.00");
+    const itemSum = pu.items.reduce((s, i) => s + Number(i.unit_amount.value) * Number(i.quantity), 0);
+    assert.equal(itemSum.toFixed(2), pu.amount.value);
+    assert.equal(createCall.request.headers.get("prefer"), "return=representation");
+    assert.equal(createCall.request.headers.get("paypal-request-id"), data.orderId);
+    assert.equal(createCall.request.headers.get("paypal-mock-response"), null);
+  } finally { await shop.close(); }
+});
