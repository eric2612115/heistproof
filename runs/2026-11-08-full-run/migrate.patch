+
+test("create prices from the catalog, ignores tampered amounts, and sends only required fields", async () => {
+  let claimSeenAtSendTime = false;
+  const shop = await startShop({
+    onCreate: (call, state) => {
+      // The shop order (the claim) must already exist when the request leaves.
+      const shopOrder = shopDb.getOrder(call.json.purchase_units[0].custom_id);
+      claimSeenAtSendTime = Boolean(shopOrder && shopOrder.status === "pending");
+      state.customId = call.json.purchase_units[0].custom_id;
+      state.total = call.json.purchase_units[0].amount.value;
