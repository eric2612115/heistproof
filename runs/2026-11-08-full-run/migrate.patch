+// ---- PayPal / Venmo / Pay Later (PayPal Web SDK v6) ----
+
+async function createPayPalOrder() {
+  // The browser sends only SKUs and quantities; the server prices the bag.
+  const res = await fetch("/api/paypal/orders", {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ items: bag.read(), email: $("#email")?.value || undefined }),
+  });
+  const data = await res.json();
+  if (!res.ok) throw new Error(data.error ?? "Could not start PayPal checkout.");
+  return { orderId: data.id };
+}
+
+const payPalSessionOptions = {
+  async onApprove({ orderId }) {
+    // The server decides whether this order is really paid.
+    const res = await fetch(`/api/paypal/orders/${encodeURIComponent(orderId)}/capture`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: "{}",
+    });
+    const data = await res.json();
+    if (!res.ok) throw new Error(data.error ?? "Payment failed. Please choose another way to pay.");
+    if (data.status === "pending") {
+      showError("Your payment is pending; we will fulfil it once PayPal completes the capture.");
+      return;
+    }
+    await showConfirmation(data.orderId);
+  },
+  onCancel() {
+    showError("Payment cancelled — nothing was charged.");
+  },
+  onError(error) {
+    showError(error?.message ?? "PayPal could not complete this payment. Please choose another way to pay.");
+  },
+};
+
+function loadScript(src) {
+  return new Promise((resolve, reject) => {
+    const script = document.createElement("script");
+    script.async = true;
+    script.src = src;
+    script.onload = resolve;
+    script.onerror = () => reject(new Error("Could not load PayPal."));
+    document.head.appendChild(script);
+  });
+}
+
+async function initPayPal() {
+  const config = await (await fetch("/api/paypal/config")).json().catch(() => null);
+  if (!config?.clientId || !config?.scriptUrl) return;
+  await loadScript(config.scriptUrl);
+  const sdk = await window.paypal.createInstance({
+    clientId: config.clientId,
+    components: ["paypal-payments", "venmo-payments", "paypal-messages"],
+    pageType: "checkout",
+    ...(config.testBuyerCountry ? { testBuyerCountry: config.testBuyerCountry } : {}),
+  });
+  sdk.createPayPalMessages();
+  const methods = await sdk.findEligibleMethods({ currencyCode: config.currency ?? "USD" });
+
+  const sessions = {
+    paypal: { button: $("#paypal-button"), create: () => sdk.createPayPalOneTimePaymentSession(payPalSessionOptions) },
+    venmo: { button: $("#venmo-button"), create: () => sdk.createVenmoOneTimePaymentSession(payPalSessionOptions) },
+    paylater: { button: $("#paylater-button"), create: () => sdk.createPayLaterOneTimePaymentSession(payPalSessionOptions) },
+  };
+
+  let anyEligible = false;
+  for (const [method, { button, create }] of Object.entries(sessions)) {
+    if (!button || !methods.isEligible(method)) continue;
+    if (method === "paylater") {
+      const { productCode, countryCode } = methods.getDetails("paylater");
+      button.productCode = productCode;
+      button.countryCode = countryCode;
+      const message = $("#paylater-message");
+      if (message) message.hidden = false;
+    }
+    button.hidden = false;
+    anyEligible = true;
+    const session = create();
+    button.addEventListener("click", async () => {
+      showError("");
+      try {
+        // Do not await createOrder before start(): the popup needs the click's activation.
+        const createOrderPromise = createPayPalOrder();
+        // Surface a server rejection instead of leaving an unhandled rejection if start fails first.
+        createOrderPromise.catch(() => {});
+        await session.start({ presentationMode: "auto" }, createOrderPromise);
+      } catch (err) {
+        showError(err.message ?? "PayPal could not start. Please try again.");
+      }
+    });
+  }
+  if (anyEligible) $("#paypal-section").hidden = false;
+
+  const updateMessageAmount = () => {
+    const message = $("#paylater-message");
+    if (message) message.amount = (bagTotalCents() / 100).toFixed(2);
+  };
+  document.addEventListener("bag:change", updateMessageAmount);
+  updateMessageAmount();
+}
