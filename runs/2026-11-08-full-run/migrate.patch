+test("amount conversion is exact, in one place", () => {
+  assert.equal(centsToPayPalAmount(4900), "49.00");
+  assert.equal(centsToPayPalAmount(5), "0.05");
+  assert.equal(centsToPayPalAmount(0), "0.00");
+  assert.equal(centsToPayPalAmount(1010), "10.10");
+  assert.equal(payPalAmountToCents("49.00"), 4900);
+  assert.equal(payPalAmountToCents("0.05"), 5);
+  assert.equal(payPalAmountToCents("49.005"), null);
+  assert.equal(payPalAmountToCents("x"), null);
+});
+
+test("browser config exposes only the client id and the sandbox script", async () => {
+  const shop = await startShop();
+  try {
+    const res = await fetch(`${shop.base}/api/paypal/config`);
+    const body = await res.json();
