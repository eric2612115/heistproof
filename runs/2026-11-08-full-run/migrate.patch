+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "../server.js";
+import { openDb } from "../lib/db.js";
+import { createCardProcessor } from "../lib/card-processor.js";
+import { createPayPalService, centsToPayPalAmount, payPalAmountToCents } from "../lib/paypal.js";
+
+const jsonResponse = (status, body) => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+const tokenResponse = () => jsonResponse(200, { access_token: "test-token", token_type: "Bearer", expires_in: 3600 });
+const paypalError = (status, message, issue) =>
+  jsonResponse(status, {
+    name: "UNPROCESSABLE_ENTITY",
+    message,
+    debug_id: "debug-1",
+    details: issue ? [{ issue, description: message }] : [],
+  });
+
+// A fake PayPal at the fetch seam: token, Orders v2 and webhook verification, all in wire shape.
+function createFakePayPal(hooks = {}) {
+  const calls = [];
+  const state = { paypalId: "PAYPAL-ORDER-1", customId: null, total: null, captureStatus: hooks.captureStatus ?? "COMPLETED", captureValue: hooks.captureValue, captureCurrency: hooks.captureCurrency, wrongCustomId: hooks.wrongCustomId };
+  const orderWire = ({ status = "COMPLETED", captures = null } = {}) => ({
+    id: state.paypalId,
+    status,
+    intent: "CAPTURE",
+    purchase_units: [
+      {
+        custom_id: state.wrongCustomId ?? state.customId,
+        invoice_id: state.customId,
+        amount: { currency_code: "USD", value: state.total ?? "49.00" },
+        payments: {
+          captures:
+            captures ??
+            [
+              {
+                id: "CAPTURE-1",
+                status: state.captureStatus,
+                custom_id: state.wrongCustomId ?? state.customId,
+                amount: { currency_code: state.captureCurrency ?? "USD", value: state.captureValue ?? state.total ?? "49.00" },
+              },
+            ],
+        },
+      },
+    ],
+    links: [],
+  });
+  const fetchImpl = async (input, init) => {
+    const request = new Request(input, init);
+    const url = new URL(request.url);
+    const text = request.body === null ? "" : await request.clone().text();
+    let json = null;
+    try {
+      json = JSON.parse(text);
+    } catch {
+      /* form bodies etc. */
+    }
+    const call = { method: request.method, pathname: url.pathname, headers: request.headers, text, json };
+    calls.push(call);
+    if (url.pathname === "/v1/oauth2/token") return hooks.onToken ? hooks.onToken(call) : tokenResponse();
+    if (url.pathname === "/v1/notifications/verify-webhook-signature") {
+      return hooks.onVerify ? hooks.onVerify(call) : jsonResponse(200, { verification_status: "SUCCESS" });
+    }
+    if (request.method === "POST" && url.pathname === "/v2/checkout/orders") {
+      if (hooks.onCreate) return hooks.onCreate(call, state);
+      state.customId = json.purchase_units[0].custom_id;
+      state.total = json.purchase_units[0].amount.value;
+      return jsonResponse(201, { id: state.paypalId, status: "CREATED", intent: "CAPTURE", purchase_units: json.purchase_units, links: [] });
+    }
+    if (request.method === "POST" && url.pathname === `/v2/checkout/orders/${state.paypalId}/capture`) {
+      if (hooks.onCapture) return hooks.onCapture(call, () => jsonResponse(201, orderWire()));
+      return jsonResponse(201, orderWire());
+    }
+    if (request.method === "GET" && url.pathname === `/v2/checkout/orders/${state.paypalId}`) {
+      if (hooks.onGet) return hooks.onGet(call, () => jsonResponse(200, orderWire()));
+      return jsonResponse(200, orderWire());
+    }
+    return jsonResponse(404, { name: "RESOURCE_NOT_FOUND", message: "not found", debug_id: "debug-1" });
+  };
+  return { calls, state, fetchImpl, orderWire };
+}
+
+async function startShop(hooks = {}) {
+  const fake = createFakePayPal(hooks);
+  const db = openDb(":memory:");
+  const paypal = createPayPalService({
+    clientId: "test-client-id",
+    clientSecret: "test-client-secret",
+    webhookId: "WH-ID-1",
+    apiBase: "https://paypal.test",
+    paypalEnv: "sandbox",
+    testBuyerCountry: "GB",
+    fetchImpl: fake.fetchImpl,
+  });
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypal });
+  const server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  return { db, fake, base: `http://127.0.0.1:${server.address().port}`, close: () => new Promise((r) => server.close(r)) };
+}
+
+const post = (url, body, headers = {}) =>
+  fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body) });
+
+async function createViaApi(shop, items = [{ sku: "FOG-HOODIE", qty: 1 }]) {
+  const res = await post(`${shop.base}/api/paypal/orders`, { items, email: "buyer@example.com" });
+  assert.equal(res.status, 200);
+  return res.json();
+}
+
+function postWebhook(shop, event) {
+  return post(`${shop.base}/api/paypal/webhooks`, event, {
+    "paypal-auth-algo": "SHA256withRSA",
+    "paypal-cert-url": "https://paypal.test/cert.pem",
+    "paypal-transmission-id": "trans-1",
+    "paypal-transmission-sig": "sig-1",
+    "paypal-transmission-time": "2026-01-01T00:00:00Z",
+  });
+}
+
+const captureCompletedEvent = (shop, eventId = "EVENT-1") => ({
+  id: eventId,
+  event_type: "PAYMENT.CAPTURE.COMPLETED",
+  resource: {
+    id: "CAPTURE-1",
+    status: "COMPLETED",
+    custom_id: shop.fake.state.customId,
+    amount: { currency_code: "USD", value: shop.fake.state.total },
+    supplementary_data: { related_ids: { order_id: shop.fake.state.paypalId } },
+  },
+});
