+  }
+
+  const badCreds = await startShop({ onCapture: () => paypalError(401, "Authentication failed due to invalid authentication credentials.", null) });
+  try {
+    const { id, orderId } = await createViaApi(badCreds);
+    const res = await post(`${badCreds.base}/api/paypal/orders/${id}/capture`, {});
+    assert.equal(res.status, 502);
+    const body = await res.json();
+    assert.equal(body.error, "PayPal is unavailable.");
+    assert.equal(badCreds.db.getOrder(orderId).status, "pending");
+  } finally {
+    await badCreds.close();
+  }
+});
