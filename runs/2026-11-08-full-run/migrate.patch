+function errorBody(issue, message = "The requested action could not be performed.") {
+  return {
+    name: "UNPROCESSABLE_ENTITY",
+    message,
+    debug_id: "debug-1",
+    details: issue ? [{ issue, description: `${issue} description` }] : [],
+  };
