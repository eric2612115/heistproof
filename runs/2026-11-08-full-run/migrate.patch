+test("PAYMENT.CAPTURE.COMPLETED fulfils once; replays and out-of-order events change nothing", async () => {
+  const fake = makeFakePayPal();
+  const shop = await startShop(fake);
+  try {
+    const { orderId } = await createPayPalOrder(shop);
+    fake.state.getMode = "completed";
+    fake.state.captured = true;
+    const event = {
+      id: "EVT-CAPTURE-1", event_type: "PAYMENT.CAPTURE.COMPLETED",
+      resource: { id: "CAP-1", status: "COMPLETED", custom_id: orderId, amount: { currency_code: "USD", value: "49.00" }, supplementary_data: { related_ids: { order_id: "PAYPAL-ORDER-1" } } },
+    };
+    const first = await post(`${shop.base}/api/paypal/webhooks`, event, webhookHeaders);
+    assert.equal(first.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+
+    // Verify request went to PAYPAL_API_BASE with the webhook id and event.
+    const verify = fake.calls.find((c) => c.path === "/v1/notifications/verify-webhook-signature");
+    assert.equal(verify.body.webhook_id, "WH-TEST");
+    assert.equal(verify.body.webhook_event.id, "EVT-CAPTURE-1");
+    assert.equal(verify.body.transmission_id, "trans-1");
+    assert.equal(verify.headers.get("authorization"), "Bearer TEST-TOKEN");
+
+    for (let i = 0; i < 2; i++) {
+      const replay = await post(`${shop.base}/api/paypal/webhooks`, event, webhookHeaders);
+      assert.equal(replay.status, 200);
+    }
+    const lateApproved = await post(`${shop.base}/api/paypal/webhooks`, { id: "EVT-LATE", event_type: "CHECKOUT.ORDER.APPROVED", resource: { id: "PAYPAL-ORDER-1" } }, webhookHeaders);
+    assert.equal(lateApproved.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally { await shop.close(); }
+});
