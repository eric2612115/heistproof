index 0000000..b43859e
--- /dev/null
+++ b/lib/paypal.js
@@ -0,0 +1,282 @@
+import { PaypalClient, PaypalError, CheckoutPaymentIntent } from "paypal";
+
+export const SANDBOX_SCRIPT_URL = "https://www.sandbox.paypal.com/web-sdk/v6/core";
+export const LIVE_SCRIPT_URL = "https://www.paypal.com/web-sdk/v6/core";
+const DEFAULT_API_BASE = "https://api-m.sandbox.paypal.com";
+
+/** Catalog prices are integer cents; PayPal amounts are decimal strings in dollars. */
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  const dollars = Math.floor(cents / 100);
+  const remainder = cents % 100;
+  return `${dollars}.${String(remainder).padStart(2, "0")}`;
+}
+
+/** Parse a PayPal decimal-string amount to integer cents without using floats. Returns null if malformed. */
+export function payPalAmountToCents(value) {
+  if (typeof value !== "string") return null;
+  const match = /^(\d+)(?:\.(\d{1,2}))?$/.exec(value.trim());
+  if (!match) return null;
+  return Number(match[1]) * 100 + Number((match[2] ?? "").padEnd(2, "0") || 0);
+}
+
+export class PayPalServiceError extends Error {
+  constructor(message, { httpStatus = 502, providerStatus = null, issue = null, unknownOutcome = false, neverSent = false, cause } = {}) {
+    super(message, cause ? { cause } : undefined);
+    this.name = "PayPalServiceError";
+    this.httpStatus = httpStatus;
+    this.providerStatus = providerStatus;
+    this.issue = issue;
+    this.unknownOutcome = unknownOutcome;
+    this.neverSent = neverSent;
+  }
+}
+
+function reasonFromPayload(payload) {
+  if (!payload) return null;
+  if ("rawBody" in payload) {
+    try {
+      const parsed = JSON.parse(new TextDecoder().decode(payload.rawBody));
+      return parsed?.message ?? null;
+    } catch {
+      return null;
+    }
+  }
+  const body = payload.body;
+  if (!body) return null;
+  const details = Array.isArray(body.details)
+    ? body.details.map((d) => d.description || d.issue).filter(Boolean).join("; ")
+    : "";
+  return [body.message, details].filter(Boolean).join(" — ") || null;
+}
+
+function issueFromPayload(payload) {
+  if (!payload || "rawBody" in payload) return null;
+  const details = payload.body?.details;
+  return Array.isArray(details) && details[0]?.issue ? details[0].issue : null;
+}
+
+/**
+ * Translate any SDK failure into our boundary error. Arm tags are per-operation and
+ * schema-derived, so we read err.status (never switch on payload.kind across operations).
+ */
+export function translatePayPalError(err, { write = false } = {}) {
+  if (err instanceof PayPalServiceError) return err;
+  if (err instanceof PaypalError) {
+    switch (err.kind) {
+      case "api": {
+        const reason = reasonFromPayload(err.payload);
+        const issue = issueFromPayload(err.payload);
+        if (err.status === 401 || err.status === 403) {
+          return new PayPalServiceError("PayPal is unavailable.", { httpStatus: 502, providerStatus: err.status, issue, cause: err });
+        }
+        if (err.status === 429) {
+          return new PayPalServiceError("PayPal is busy; try again shortly.", { httpStatus: 503, providerStatus: err.status, issue, cause: err });
+        }
+        if (err.status >= 400 && err.status < 500) {
+          return new PayPalServiceError(reason ?? "PayPal rejected the request.", { httpStatus: err.status, providerStatus: err.status, issue, cause: err });
+        }
+        return new PayPalServiceError("PayPal is unavailable.", { httpStatus: 502, providerStatus: err.status, issue, cause: err });
+      }
+      case "decode": {
+        if (err.status >= 200 && err.status < 300) {
+          return new PayPalServiceError("PayPal's response could not be verified; the outcome is unknown.", {
+            httpStatus: 502, providerStatus: err.status, unknownOutcome: write, cause: err,
+          });
+        }
+        if (err.status >= 400 && err.status < 500) {
+          return new PayPalServiceError("PayPal rejected the request.", { httpStatus: err.status, providerStatus: err.status, cause: err });
+        }
+        return new PayPalServiceError("PayPal is unavailable.", { httpStatus: 502, providerStatus: err.status, cause: err });
+      }
+      case "connection":
+      case "timeout":
+        return new PayPalServiceError(
+          write ? "We could not confirm the outcome with PayPal; please check your order status." : "PayPal is unavailable.",
+          { httpStatus: 502, unknownOutcome: write, cause: err },
+        );
+      case "encode":
+      case "auth":
+        return new PayPalServiceError("PayPal is unavailable.", { httpStatus: 502, neverSent: true, cause: err });
+      default:
+        break;
+    }
+  }
+  return err;
+}
+
+/**
+ * Decide, from an Order returned by capture/get, whether the shop order is really paid.
+ * Requires a COMPLETED capture whose amount and currency equal the shop total and whose
+ * custom_id (on the purchase unit or the capture) is the shop order.
+ */
+export function assessCapturedOrder(order, shopOrder) {
+  if (!order || typeof order !== "object") return { state: "invalid", reason: "PayPal returned no order." };
+  if (order.id !== shopOrder.paypal_order_id) return { state: "invalid", reason: "PayPal order does not match this shop order." };
+  const units = Array.isArray(order.purchaseUnits) ? order.purchaseUnits : [];
+  let sawCapture = false;
+  let sawPending = false;
+  for (const unit of units) {
+    const unitCustomId = unit?.customId ?? null;
+    const captures = Array.isArray(unit?.payments?.captures) ? unit.payments.captures : [];
+    for (const capture of captures) {
+      sawCapture = true;
+      const customId = capture?.customId ?? unitCustomId;
+      if (capture?.status === "PENDING") sawPending = true;
+      if (capture?.status !== "COMPLETED") continue;
+      if (customId !== shopOrder.id) return { state: "invalid", reason: "Capture is not bound to this shop order." };
+      const currency = capture?.amount?.currencyCode;
+      const paidCents = payPalAmountToCents(capture?.amount?.value);
+      if (!currency || currency.toUpperCase() !== String(shopOrder.currency).toUpperCase() || paidCents === null) {
+        return { state: "invalid", reason: "Capture amount is missing or in the wrong currency." };
+      }
+      if (paidCents !== shopOrder.total_cents) return { state: "invalid", reason: "Capture amount does not equal the order total." };
+      return { state: "completed", captureId: capture.id ?? null, paidCents };
+    }
+  }
+  if (sawPending) return { state: "pending", reason: "Capture is pending." };
+  if (!sawCapture) return { state: "not_captured", reason: "No capture exists for this order." };
+  return { state: "invalid", reason: "No completed capture exists for this order." };
+}
+
+export function readPayPalConfigFromEnv(env = process.env) {
+  return {
+    clientId: env.PAYPAL_CLIENT_ID ?? "",
+    clientSecret: env.PAYPAL_CLIENT_SECRET ?? "",
+    webhookId: env.PAYPAL_WEBHOOK_ID ?? "",
+    apiBase: env.PAYPAL_API_BASE ?? DEFAULT_API_BASE,
+    paypalEnv: env.PAYPAL_ENV ?? "sandbox",
+    testBuyerCountry: env.PAYPAL_TEST_BUYER_COUNTRY || undefined,
+  };
+}
+
+export function createPayPalServiceFromEnv(env = process.env, fetchImpl) {
+  return createPayPalService({ ...readPayPalConfigFromEnv(env), fetchImpl });
+}
+
+export function createPayPalService({ clientId = "", clientSecret = "", webhookId = "", apiBase = DEFAULT_API_BASE, paypalEnv = "sandbox", testBuyerCountry, fetchImpl } = {}) {
+  const base = String(apiBase || DEFAULT_API_BASE).replace(/\/+$/, "");
+  const configured = Boolean(clientId && clientSecret);
+  const doFetch = fetchImpl ?? globalThis.fetch;
+
+  // One long-lived client: the OAuth token cache and memoized resources live on it.
+  const client = new PaypalClient({
+    ...(configured ? { oauth2: { clientId, clientSecret } } : {}),
+    serverOptions: { baseUrl: base },
+    logging: { level: "off" },
+    ...(fetchImpl ? { fetch: (request) => doFetch(request) } : {}),
+  });
+
+  // Token cache for the webhook-verification call, which has no SDK operation.
+  let tokenCache = null;
+  async function getAccessToken() {
+    if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.value;
+    const res = await doFetch(`${base}/v1/oauth2/token`, {
+      method: "POST",
+      headers: {
+        authorization: `Basic ${Buffer.from(`${clientId}:${clientSecret}`).toString("base64")}`,
+        "content-type": "application/x-www-form-urlencoded",
+      },
+      body: "grant_type=client_credentials",
+    });
+    if (!res.ok) throw new PayPalServiceError("PayPal is unavailable.", { httpStatus: 502, providerStatus: res.status });
+    const data = await res.json();
+    if (!data?.access_token) throw new PayPalServiceError("PayPal is unavailable.", { httpStatus: 502 });
+    const expiresIn = Number(data.expires_in);
+    tokenCache = {
+      value: data.access_token,
+      expiresAt: Date.now() + (Number.isFinite(expiresIn) && expiresIn > 0 ? expiresIn * 1000 : 0),
+    };
+    return tokenCache.value;
+  }
+
+  return {
+    configured,
+    client,
+
+    getBrowserConfig() {
+      const live = paypalEnv === "live";
+      return {
+        clientId: clientId || null,
+        scriptUrl: live ? LIVE_SCRIPT_URL : SANDBOX_SCRIPT_URL,
+        currency: "USD",
+        ...(!live && testBuyerCountry ? { testBuyerCountry } : {}),
+      };
+    },
+
+    async createOrder({ shopOrderId, cart }) {
+      const money = { currencyCode: "USD", value: centsToPayPalAmount(cart.totalCents) };
+      let order;
+      try {
+        order = await client.orders.createOrder({
+          payPalRequestId: shopOrderId,
+          prefer: "return=representation",
+          body: {
+            intent: CheckoutPaymentIntent.Capture,
+            purchaseUnits: [
+              {
+                customId: shopOrderId,
+                invoiceId: shopOrderId,
+                amount: { ...money, breakdown: { itemTotal: { ...money } } },
+                items: cart.lines.map((line) => ({
+                  name: line.name,
+                  sku: line.sku,
+                  quantity: String(line.qty),
+                  unitAmount: { currencyCode: "USD", value: centsToPayPalAmount(line.unitCents) },
+                })),
+              },
+            ],
+          },
+        });
+      } catch (err) {
+        throw translatePayPalError(err, { write: true });
+      }
+      if (!order?.id) {
+        throw new PayPalServiceError("PayPal's response could not be verified; the outcome is unknown.", { httpStatus: 502, unknownOutcome: true });
+      }
+      return order;
+    },
+
+    async captureOrder(paypalOrderId, shopOrderId) {
+      try {
+        return await client.orders.captureOrder({
+          id: paypalOrderId,
+          payPalRequestId: `capture-${shopOrderId}`,
+          prefer: "return=representation",
+        });
+      } catch (err) {
+        throw translatePayPalError(err, { write: true });
+      }
+    },
+
+    async getOrder(paypalOrderId) {
+      try {
+        return await client.orders.getOrder({ id: paypalOrderId });
+      } catch (err) {
+        throw translatePayPalError(err, { write: false });
+      }
+    },
+
+    /** Verify a webhook delivery with PayPal. Returns true only on verification_status SUCCESS. */
+    async verifyWebhookSignature({ headers, event }) {
+      if (!configured || !webhookId) return false;
+      const token = await getAccessToken();
+      const res = await doFetch(`${base}/v1/notifications/verify-webhook-signature`, {
+        method: "POST",
+        headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
+        body: JSON.stringify({
+          auth_algo: headers.authAlgo,
+          cert_url: headers.certUrl,
+          transmission_id: headers.transmissionId,
+          transmission_sig: headers.transmissionSig,
+          transmission_time: headers.transmissionTime,
+          webhook_id: webhookId,
+          webhook_event: event,
+        }),
+      });
+      if (!res.ok) return false;
+      const data = await res.json().catch(() => null);
+      return data?.verification_status === "SUCCESS";
+    },
+  };
+}
