diff --git a/lib/paypal.js b/lib/paypal.js
new file mode 100644
index 0000000..9762d8e
--- /dev/null
+++ b/lib/paypal.js
@@ -0,0 +1,331 @@
+import { PaypalClient, PaypalError } from "paypal";
+
+// One place for the cents -> PayPal decimal-string conversion (hardening rule 2).
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  const dollars = Math.floor(cents / 100);
+  const rest = cents % 100;
+  return `${dollars}.${String(rest).padStart(2, "0")}`;
+}
+
+export function payPalAmountToCents(value) {
+  const m = /^(\d+)\.(\d{2})$/.exec(String(value ?? ""));
+  if (!m) return null;
+  return Number(m[1]) * 100 + Number(m[2]);
+}
+
+const SANDBOX_SCRIPT = "https://www.sandbox.paypal.com/web-sdk/v6/core";
+const LIVE_SCRIPT = "https://www.paypal.com/web-sdk/v6/core";
+
+// Error our routes translate to an HTTP response. `status` is OUR status,
+// `paypalStatus` (when set) is PayPal's, `reason` is only set for caller-caused 4xx.
+export class PayPalServiceError extends Error {
+  constructor(status, message, { reason, code, unknown = false, cause } = {}) {
+    super(message, cause ? { cause } : undefined);
+    this.status = status;
+    this.reason = reason;
+    this.code = code;
+    this.unknown = unknown;
+  }
+}
+
+function payloadBody(err) {
+  const p = err?.payload;
+  if (!p || typeof p !== "object") return null;
+  if ("rawBody" in p) {
+    try {
+      return JSON.parse(new TextDecoder().decode(p.rawBody));
+    } catch {
+      return null;
+    }
+  }
+  return p.body ?? null;
+}
+
+function reasonFromBody(body) {
+  if (!body) return undefined;
+  const parts = [];
+  if (body.message) parts.push(String(body.message));
+  for (const d of body.details ?? []) {
+    const bit = [d.issue, d.description].filter(Boolean).join(": ");
+    if (bit && !parts.includes(bit)) parts.push(bit);
+  }
+  return parts.length ? parts.join(" ") : undefined;
+}
+
+function issueCodes(body) {
+  return (body?.details ?? []).map((d) => d?.issue).filter(Boolean);
+}
+
+// Translate any SDK failure. `onUnknown` (writes only) is awaited for
+// connection/timeout/decode so the caller can re-read provider state.
+function translateError(err, { operation } = {}) {
+  if (err instanceof PayPalServiceError) return err;
+  if (err instanceof PaypalError) {
+    switch (err.kind) {
+      case "api": {
+        const body = payloadBody(err);
+        const reason = reasonFromBody(body);
+        const codes = issueCodes(body);
+        if (codes.includes("INSTRUMENT_DECLINED")) {
+          return new PayPalServiceError(422, "Your payment method was declined. Please choose another way to pay.", {
+            reason,
+            code: "INSTRUMENT_DECLINED",
+            cause: err,
+          });
+        }
+        if (err.status === 401 || err.status === 403) {
+          return new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE", cause: err });
+        }
+        if (err.status === 429) return new PayPalServiceError(503, "PayPal is temporarily unavailable.", { code: "PAYPAL_RATE_LIMITED", cause: err });
+        if (err.status >= 400 && err.status < 500) {
+          return new PayPalServiceError(err.status, reason ?? "PayPal rejected the request.", { reason, code: codes[0], cause: err });
+        }
+        return new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE", cause: err });
+      }
+      case "auth":
+      case "encode":
+        // Nothing was sent: a configuration/integration fault, never re-read.
+        return new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE", cause: err });
+      case "connection":
+      case "timeout":
+      case "decode":
+        return new PayPalServiceError(502, "The payment outcome is unknown. Please check your order status.", {
+          code: "PAYPAL_OUTCOME_UNKNOWN",
+          unknown: true,
+          cause: err,
+        });
+      default:
+        return new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE", cause: err });
+    }
+  }
+  return err; // outside the SDK family: abort reason, bug — rethrow as-is
+}
+
+function isUnknown(err) {
+  return err instanceof PayPalServiceError && err.unknown;
+}
+function isAlreadyCaptured(err) {
+  if (err instanceof PaypalError && err.kind === "api") {
+    return issueCodes(payloadBody(err)).includes("ORDER_ALREADY_CAPTURED");
+  }
+  const cause = err?.cause;
+  if (cause instanceof PaypalError && cause.kind === "api") {
+    return issueCodes(payloadBody(cause)).includes("ORDER_ALREADY_CAPTURED");
+  }
+  return err?.code === "ORDER_ALREADY_CAPTURED";
+}
+
+// Find a validated completed capture on a decoded PayPal Order.
+// Returns { state: "completed", capture, purchaseUnit } | { state: "pending"|"declined"|"none"|"mismatch", ... }
+export function evaluateOrder(order, shopOrder) {
+  if (!order || typeof order !== "object" || !order.id) return { state: "unknown" };
+  const units = order.purchaseUnits ?? [];
+  if (!units.length) return { state: "unknown" };
+  const expectedValue = centsToPayPalAmount(shopOrder.total_cents);
+  const expectedCurrency = String(shopOrder.currency ?? "usd").toUpperCase();
+  let sawPending = false;
+  let sawBadCapture = false;
+  for (const unit of units) {
+    if (unit.customId !== shopOrder.id) return { state: "mismatch", reason: "custom_id mismatch" };
+    const captures = unit.payments?.captures ?? [];
+    for (const capture of captures) {
+      if (capture.customId != null && capture.customId !== shopOrder.id) return { state: "mismatch", reason: "capture custom_id mismatch" };
+      if (capture.status === "PENDING") sawPending = true;
+      if (capture.status === "COMPLETED") {
+        const cents = capture.amount ? payPalAmountToCents(capture.amount.value) : null;
+        if (!capture.amount || String(capture.amount.currencyCode).toUpperCase() !== expectedCurrency || capture.amount.value !== expectedValue || cents !== shopOrder.total_cents) {
+          return { state: "mismatch", reason: "capture amount mismatch" };
+        }
+        return { state: "completed", capture, purchaseUnit: unit };
+      }
+      if (capture.status === "DECLINED" || capture.status === "FAILED") sawBadCapture = true;
+    }
+  }
+  if (sawPending) return { state: "pending" };
+  if (sawBadCapture) return { state: "declined" };
+  return { state: "none" };
+}
+
+export function createPayPalService({
+  clientId,
+  clientSecret,
+  webhookId,
+  apiBase = "https://api-m.sandbox.paypal.com",
+  env = "sandbox",
+  testBuyerCountry,
+  fetchImpl,
+  retry,
+} = {}) {
+  if (!clientId) throw new Error("PAYPAL_CLIENT_ID is not configured");
+  if (!clientSecret) throw new Error("PAYPAL_CLIENT_SECRET is not configured");
+  const paypalEnv = env ?? "sandbox";
+  if (paypalEnv !== "sandbox" && paypalEnv !== "live") throw new Error("PAYPAL_ENV must be sandbox or live");
+  const base = String(apiBase || "https://api-m.sandbox.paypal.com").replace(/\/+$/, "");
+
+  const clientOptions = {
+    oauth2: { clientId, clientSecret },
+    serverOptions: { baseUrl: base },
+    logging: { level: "off" },
+    ...(fetchImpl ? { fetch: fetchImpl } : {}),
+    ...(retry ? { retry } : {}),
+  };
+  const client = new PaypalClient(clientOptions);
+  const rawFetch = fetchImpl ?? globalThis.fetch;
+
+  // Token for webhook verification (no SDK operation exists for it).
+  let tokenCache = null;
+  async function webhookAccessToken() {
+    if (tokenCache && tokenCache.expiresAt > Date.now() + 30_000) return tokenCache.value;
+    const basic = Buffer.from(`${clientId}:${clientSecret}`).toString("base64");
+    const res = await rawFetch(`${base}/v1/oauth2/token`, {
+      method: "POST",
+      headers: { authorization: `Basic ${basic}`, "content-type": "application/x-www-form-urlencoded" },
+      body: "grant_type=client_credentials",
+    });
+    if (!res.ok) throw new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE" });
+    const data = await res.json();
+    if (!data?.access_token) throw new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE" });
+    tokenCache = { value: data.access_token, expiresAt: Date.now() + (Number(data.expires_in ?? 3600) * 1000 || 3600_000) };
+    return tokenCache.value;
+  }
+
+  const service = {
+    client,
+    config() {
+      return {
+        clientId,
+        env: paypalEnv,
+        scriptUrl: paypalEnv === "live" ? LIVE_SCRIPT : SANDBOX_SCRIPT,
+        currency: "USD",
+        ...(paypalEnv === "sandbox" && testBuyerCountry ? { testBuyerCountry } : {}),
+      };
+    },
+
+    // cart: priceCart() result; shopOrderId binds the PayPal order to the shop order.
+    async createOrder({ cart, shopOrderId }) {
+      const total = centsToPayPalAmount(cart.totalCents);
+      const currency = String(cart.currency ?? "usd").toUpperCase();
+      let order;
+      try {
+        order = await client.orders.createOrder({
+          payPalRequestId: shopOrderId,
+          prefer: "return=representation",
+          body: {
+            intent: "CAPTURE",
+            purchaseUnits: [
+              {
+                customId: shopOrderId,
+                invoiceId: shopOrderId,
+                amount: {
+                  currencyCode: currency,
+                  value: total,
+                  breakdown: { itemTotal: { currencyCode: currency, value: total } },
+                },
+                items: cart.lines.map((line) => ({
+                  name: line.name,
+                  sku: line.sku,
+                  quantity: String(line.qty),
+                  unitAmount: { currencyCode: currency, value: centsToPayPalAmount(line.unitCents) },
+                })),
+              },
+            ],
+          },
+        });
+      } catch (err) {
+        const translated = translateError(err, { operation: "createOrder" });
+        // Create has no provider re-read by PayPal-Request-Id in this SDK: unknown stays unknown.
+        throw translated;
+      }
+      if (!order?.id) {
+        throw new PayPalServiceError(502, "The payment outcome is unknown. Please check your order status.", { code: "PAYPAL_OUTCOME_UNKNOWN", unknown: true });
+      }
+      return order;
+    },
+
+    async getOrder(paypalOrderId) {
+      try {
+        return await client.orders.getOrder({ id: paypalOrderId });
+      } catch (err) {
+        throw translateError(err, { operation: "getOrder" });
+      }
+    },
+
+    // Settle from what PayPal holds (used on unknown outcomes / ORDER_ALREADY_CAPTURED / webhooks).
+    async settleFromPayPal(paypalOrderId, shopOrder) {
+      const order = await service.getOrder(paypalOrderId);
+      return { order, evaluation: evaluateOrder(order, shopOrder) };
+    },
+
+    async captureOrder({ paypalOrderId, shopOrder }) {
+      let order;
+      try {
+        order = await client.orders.captureOrder({
+          id: paypalOrderId,
+          payPalRequestId: shopOrder.id,
+          prefer: "return=representation",
+        });
+      } catch (err) {
+        if (isAlreadyCaptured(err) || isUnknown(translateError(err))) {
+          // Rule 10 / unknown outcome: re-read and settle from PayPal's state.
+          try {
+            const settled = await service.settleFromPayPal(paypalOrderId, shopOrder);
+            if (settled.evaluation.state === "completed") return settled;
+            if (settled.evaluation.state === "pending") return settled;
+          } catch {
+            /* re-read failed: still unknown */
+          }
+          throw new PayPalServiceError(502, "The payment outcome is unknown. Please check your order status.", {
+            code: "PAYPAL_OUTCOME_UNKNOWN",
+            unknown: true,
+            cause: err,
+          });
+        }
+        throw translateError(err, { operation: "captureOrder" });
+      }
+      if (!order?.id || !order.purchaseUnits) {
+        // Truncated success body: outcome unknown, try one re-read.
+        try {
+          const settled = await service.settleFromPayPal(paypalOrderId, shopOrder);
+          if (settled.evaluation.state === "completed" || settled.evaluation.state === "pending") return settled;
+        } catch { /* fall through to unknown */ }
+        throw new PayPalServiceError(502, "The payment outcome is unknown. Please check your order status.", { code: "PAYPAL_OUTCOME_UNKNOWN", unknown: true });
+      }
+      return { order, evaluation: evaluateOrder(order, shopOrder) };
+    },
+
+    async verifyWebhook({ headers, event }) {
+      if (!webhookId) throw new PayPalServiceError(500, "Webhook is not configured.", { code: "WEBHOOK_NOT_CONFIGURED" });
+      const token = await webhookAccessToken();
+      const res = await rawFetch(`${base}/v1/notifications/verify-webhook-signature`, {
+        method: "POST",
+        headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
+        body: JSON.stringify({
+          auth_algo: headers.authAlgo,
+          cert_url: headers.certUrl,
+          transmission_id: headers.transmissionId,
+          transmission_sig: headers.transmissionSig,
+          transmission_time: headers.transmissionTime,
+          webhook_id: webhookId,
+          webhook_event: event,
+        }),
+      });
+      if (!res.ok) throw new PayPalServiceError(502, "PayPal is unavailable.", { code: "PAYPAL_UNAVAILABLE" });
+      const data = await res.json().catch(() => null);
+      return data?.verification_status === "SUCCESS";
+    },
+  };
+  return service;
+}
+
+export function payPalServiceFromEnv(env = process.env, fetchImpl) {
+  return createPayPalService({
+    clientId: env.PAYPAL_CLIENT_ID,
+    clientSecret: env.PAYPAL_CLIENT_SECRET,
+    webhookId: env.PAYPAL_WEBHOOK_ID,
+    apiBase: env.PAYPAL_API_BASE || "https://api-m.sandbox.paypal.com",
+    env: env.PAYPAL_ENV || "sandbox",
+    testBuyerCountry: env.PAYPAL_TEST_BUYER_COUNTRY || undefined,
+    fetchImpl,
+  });
+}
