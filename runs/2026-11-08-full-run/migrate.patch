+// A faked fetch that speaks PayPal wire format to the real SDK (token first).
+function makeFakePayPal() {
+  const calls = [];
+  const state = { captureMode: "completed", getMode: "noCapture", verifyStatus: "SUCCESS", tokenFails: false, createBody: null, captured: false };
+  const hooks = {};
+  const fakeFetch = async (input, init) => {
+    const request = new Request(input, init);
+    const url = new URL(request.url);
+    const text = request.body ? await request.clone().text() : "";
+    let body;
+    try { body = text ? JSON.parse(text) : undefined; } catch { body = text; }
+    const call = { method: request.method, path: url.pathname, headers: request.headers, body, rawBody: text };
+    calls.push(call);
+
+    if (url.pathname === "/v1/oauth2/token") {
+      if (state.tokenFails) return json(401, { error: "invalid_client", error_description: "bad credentials" });
+      return json(200, { access_token: "TEST-TOKEN", token_type: "Bearer", expires_in: 3600 });
+    }
+    if (url.pathname === "/v1/notifications/verify-webhook-signature") {
+      return json(200, { verification_status: state.verifyStatus });
+    }
+    if (url.pathname === "/v2/checkout/orders" && request.method === "POST") {
+      if (state.createMode === "throw") throw new Error("connection reset");
+      state.createBody = body;
+      hooks.onCreate?.(call);
+      const unit = body.purchase_units[0];
+      return json(201, {
+        id: "PAYPAL-ORDER-1",
+        status: "CREATED",
+        intent: body.intent,
+        purchase_units: [{ custom_id: unit.custom_id, invoice_id: unit.invoice_id, amount: { currency_code: unit.amount.currency_code, value: unit.amount.value } }],
+      });
+    }
+    const captureMatch = url.pathname.match(/^\/v2\/checkout\/orders\/([^/]+)\/capture$/);
+    if (captureMatch && request.method === "POST") {
+      hooks.onCapture?.(call);
+      if (state.captureDelay) await sleep(state.captureDelay);
+      switch (state.captureMode) {
+        case "throw": throw new Error("socket hangup");
+        case "instrument": return json(422, errorBody("INSTRUMENT_DECLINED", "The instrument presented was declined."));
+        case "refused": return json(422, errorBody("TRANSACTION_REFUSED", "Transaction refused."));
+        case "already": return json(422, errorBody("ORDER_ALREADY_CAPTURED", "Order already captured."));
+        case "api401": return json(401, { name: "UNAUTHORIZED", message: "Authentication failed due to invalid authentication credentials", debug_id: "d", details: [] });
+        case "pending": return json(201, completedOrder({ captureStatus: "PENDING" }));
+        case "mismatchAmount": state.captured = true; return json(201, completedOrder({ value: "0.01" }));
+        case "wrongCustom": state.captured = true; return json(201, completedOrder({ customId: "FOG-OTHER" }));
+        default: state.captured = true; return json(201, completedOrder({}));
+      }
+    }
+    const getMatch = url.pathname.match(/^\/v2\/checkout\/orders\/([^/]+)$/);
+    if (getMatch && request.method === "GET") {
+      if (state.getMode === "completed" || state.captured) return json(200, completedOrder({}));
+      const unit = state.createBody?.purchase_units?.[0];
+      return json(200, {
+        id: getMatch[1],
+        status: "APPROVED",
+        purchase_units: [{ custom_id: unit?.custom_id, amount: { currency_code: "USD", value: unit?.amount?.value }, payments: { captures: [] } }],
+      });
+    }
+    return json(404, errorBody(null, "not found"));
+  };
+
+  function completedOrder({ captureStatus = "COMPLETED", value, customId } = {}) {
+    const unit = state.createBody?.purchase_units?.[0] ?? {};
+    const shopId = customId ?? unit.custom_id;
+    const total = value ?? unit.amount?.value ?? "49.00";
+    return {
+      id: "PAYPAL-ORDER-1",
+      status: "COMPLETED",
+      purchase_units: [{
+        custom_id: unit.custom_id,
+        amount: { currency_code: "USD", value: unit.amount?.value ?? total },
+        payments: { captures: [{ id: "CAP-1", status: captureStatus, custom_id: shopId, amount: { currency_code: "USD", value: total } }] },
+      }],
+    };
+  }
+
+  return { fetch: fakeFetch, calls, state, hooks };
+}
