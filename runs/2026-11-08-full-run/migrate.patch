+    });
+    try { sdk.createPayPalMessages(); } catch { /* message element auto-bootstraps */ }
+
+    const methods = await sdk.findEligibleMethods({ currencyCode: config.currency ?? "USD" });
+    const options = {
+      async onApprove({ orderId }) {
+        showError("");
+        try {
+          const res = await fetch(`/api/paypal/orders/${encodeURIComponent(orderId)}/capture`, { method: "POST" });
+          const data = await res.json().catch(() => ({}));
+          if (res.status === 202) { showError("Your payment is pending. We will confirm it shortly."); return; }
+          if (!res.ok) throw new Error(data.error ?? "Payment failed.");
