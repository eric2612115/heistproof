+test("a PENDING capture waits; the CAPTURE.COMPLETED webhook then fulfils once", async () => {
+  const shop = await startShop({ captureStatus: "PENDING" });
+  try {
+    const { id, orderId } = await createViaApi(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/${id}/capture`, {});
+    assert.equal(res.status, 202);
+    assert.equal(shop.db.getOrder(orderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 0);
+
+    // PayPal later reports the capture completed.
+    shop.fake.state.captureStatus = "COMPLETED";
+    shop.fake.calls.length = 0;
+    const wh = await postWebhook(shop, captureCompletedEvent(shop));
+    assert.equal(wh.status, 200);
+    // The webhook path re-read the order through the SDK before settling.
+    assert.ok(shop.fake.calls.some((c) => c.method === "GET" && c.pathname === `/v2/checkout/orders/${id}`));
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a verified CAPTURE.COMPLETED webhook fulfils; approval alone never does; forged and duplicate deliveries change nothing", async () => {
+  const shop = await startShop();
+  try {
+    const { orderId } = await createViaApi(shop);
+
+    // Real approval event, never captured: no payment, no shipment.
+    const approved = await postWebhook(shop, {
+      id: "EVENT-APPROVED",
+      event_type: "CHECKOUT.ORDER.APPROVED",
+      resource: { id: shop.fake.state.paypalId, status: "APPROVED" },
+    });
+    assert.equal(approved.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 0);
+
+    // Verified capture-completed event fulfils.
+    const completed = await postWebhook(shop, captureCompletedEvent(shop));
+    assert.equal(completed.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+
+    // Replay of the same delivery: 200, nothing changes.
+    const replay = await postWebhook(shop, captureCompletedEvent(shop));
+    assert.equal(replay.status, 200);
+    assert.deepEqual((await replay.json()).duplicate, true);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+
+    // Out-of-order approval after fulfilment moves nothing backwards.
+    const late = await postWebhook(shop, {
+      id: "EVENT-LATE",
+      event_type: "CHECKOUT.ORDER.APPROVED",
+      resource: { id: shop.fake.state.paypalId, status: "APPROVED" },
+    });
+    assert.equal(late.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a webhook PayPal cannot verify is rejected with 400 and changes nothing", async () => {
+  const shop = await startShop({ onVerify: () => jsonResponse(200, { verification_status: "FAILURE" }) });
+  try {
+    const { orderId } = await createViaApi(shop);
+    const res = await postWebhook(shop, captureCompletedEvent(shop));
+    assert.equal(res.status, 400);
+    assert.equal(shop.db.getOrder(orderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 0);
+    assert.equal(shop.db.hasEvent("EVENT-1"), false);
+
+    // The verification request carried the headers, webhook id and parsed event to PAYPAL_API_BASE.
+    const verifyCall = shop.fake.calls.find((c) => c.pathname === "/v1/notifications/verify-webhook-signature");
+    assert.equal(verifyCall.json.webhook_id, "WH-ID-1");
+    assert.equal(verifyCall.json.transmission_id, "trans-1");
+    assert.equal(verifyCall.json.webhook_event.id, "EVENT-1");
+    assert.equal(verifyCall.headers.get("authorization"), "Bearer test-token");
+  } finally {
+    await shop.close();
+  }
+});
