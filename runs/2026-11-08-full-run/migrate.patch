+test("a dropped connection on capture re-reads the order; on create it does not", async () => {
+  const shop = await startShop({
+    onCapture: () => {
+      throw new Error("ECONNRESET");
+    },
+  });
+  try {
+    const { id, orderId } = await createViaApi(shop);
+    const callsBefore = shop.fake.calls.length;
+    const res = await post(`${shop.base}/api/paypal/orders/${id}/capture`, {});
+    assert.equal(res.status, 200);
+    assert.ok(shop.fake.calls.slice(callsBefore).some((c) => c.method === "GET"));
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+  } finally {
+    await shop.close();
+  }
+
+  const authFail = await startShop({ onToken: () => jsonResponse(401, { error: "invalid_client" }) });
+  try {
+    const callsBefore = authFail.fake.calls.length;
+    const res = await post(`${authFail.base}/api/paypal/orders`, { items: [{ sku: "FOG-HOODIE", qty: 1 }] });
+    assert.equal(res.status, 502);
+    assert.equal((await res.json()).error, "PayPal is unavailable.");
+    // Nothing was ever sent to the orders endpoint, so there is nothing to re-read.
+    assert.equal(authFail.fake.calls.slice(callsBefore).filter((c) => c.pathname === "/v2/checkout/orders").length, 0);
+  } finally {
+    await authFail.close();
+  }
+});
