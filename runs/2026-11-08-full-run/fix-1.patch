+test("capture sends an empty JSON body so real PayPal does not answer 415 UNSUPPORTED_MEDIA_TYPE", async () => {
+  const shop = await startShop();
+  try {
+    const { id, orderId } = await createViaApi(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/${id}/capture`, {});
+    // The fake above mimics real PayPal: no application/json body -> 415, order stays pending.
+    assert.equal(res.status, 200);
+    const captureCall = shop.fake.calls.find((c) => c.method === "POST" && c.pathname.endsWith("/capture"));
+    assert.ok(captureCall);
+    assert.match(captureCall.headers.get("content-type") ?? "", /^application\/json/);
+    assert.equal(captureCall.text, "{}");
+    assert.deepEqual(captureCall.json, {});
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
