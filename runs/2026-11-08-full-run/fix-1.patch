+test("capture sends an empty JSON body, not a body-less request (real sandbox 415 regression)", async () => {
+  const shop = await startShop();
+  try {
+    const { orderId } = await createViaApi(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    // The fake now mirrors the real sandbox: without application/json + a
+    // payload it would have answered 415 and the order would stay pending.
+    assert.equal(res.status, 200);
+    const capture = shop.fake.calls.find((c) => c.path.endsWith("/capture"));
+    assert.match(capture.headers.get("content-type") ?? "", /application\/json/);
+    assert.equal(capture.bodyText, "{}");
+    assert.deepEqual(capture.body, {});
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.getOrder(orderId).paid_cents, 4900);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
+
