+test("capture sends an empty JSON object (not a bodiless request) and completes the purchase", async () => {
+  const fake = makeFakePayPal();
+  const shop = await startShop(fake);
+  try {
+    const { orderId } = await createViaHttp(shop, fake);
+    const res = await post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`);
+    // Regression for real-sandbox 415 UNSUPPORTED_MEDIA_TYPE: omitting the
+    // SDK body sends no Content-Type and no payload, and PayPal rejects it,
+    // leaving the shop order pending with 0 labels.
+    assert.equal(res.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+    const captureCalls = callsTo(fake, "/capture", "POST");
+    assert.equal(captureCalls.length, 1);
+    assert.match(captureCalls[0].request.headers.get("content-type") ?? "", /application\/json/);
+    assert.equal(captureCalls[0].body, "{}");
+    assert.deepEqual(JSON.parse(captureCalls[0].body), {});
+  } finally { await shop.close(); }
+});
