+    if (methods.isEligible("paypal")) {
+      wire("#paypal-button", sdk.createPayPalOneTimePaymentSession(options), true);
+    }
+    if (methods.isEligible("venmo")) {
+      wire("#venmo-button", sdk.createVenmoOneTimePaymentSession(options), true);
+    }
