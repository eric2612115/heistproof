+test("a verified PAYMENT.CAPTURE.COMPLETED pays once; replays and out-of-order events change nothing (rules 7, 8, 9)", async () => {
+  let shop;
+  const { api } = fakePayPal();
+  shop = await startShop(api);
+  try {
+    const { orderId } = await createHoodieOrder(shop);
+    const sid = shopOrderId(shop);
+    const event = {
+      id: "EVT-CAPTURE-1",
+      event_type: "PAYMENT.CAPTURE.COMPLETED",
+      resource: {
+        id: "CAP-1",
+        status: "COMPLETED",
+        amount: { value: "49.00", currency_code: "USD" },
+        custom_id: sid,
+        supplementary_data: { related_ids: { order_id: PP_ORDER_ID } },
+      },
+    };
+    assert.equal((await sendWebhook(shop, event)).status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    // Replay the same delivery, then an out-of-order APPROVED event.
+    assert.equal((await sendWebhook(shop, event)).status, 200);
+    assert.equal(
+      (await sendWebhook(shop, { id: "EVT-APPROVED-LATE", event_type: "CHECKOUT.ORDER.APPROVED", resource: { id: PP_ORDER_ID } })).status,
+      200,
+    );
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
