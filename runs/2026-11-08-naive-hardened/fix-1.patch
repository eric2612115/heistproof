+import { test } from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import { createApp } from "../server.js";
+import { openDb } from "../lib/db.js";
+import { createCardProcessor } from "../lib/card-processor.js";
+import { centsToPayPalAmount } from "../lib/paypal.js";
+
+// A fake PayPal API (sandbox stand-in). Its answers — not the shop's
+// assumptions — decide whether an order is paid.
+function startFakePayPal() {
+  const state = { orders: new Map(), lastCreateBody: null, counter: 0, createBodies: [] };
+  const server = http.createServer((req, res) => {
+    const chunks = [];
+    req.on("data", (c) => chunks.push(c));
+    req.on("end", () => {
+      let body = {};
+      try {
+        body = chunks.length ? JSON.parse(Buffer.concat(chunks).toString() || "{}") : {};
+      } catch {
+        body = {}; // e.g. the form-encoded OAuth token request
+      }
+      const send = (status, obj) => {
+        res.writeHead(status, { "content-type": "application/json" });
+        res.end(JSON.stringify(obj));
+      };
+      const url = new URL(req.url, "http://fake");
+      if (req.method === "POST" && url.pathname === "/v1/oauth2/token") return send(200, { access_token: "fake-token" });
+      if (req.method === "POST" && url.pathname === "/v1/notifications/verify-webhook-signature") {
+        return send(200, { verification_status: body.transmission_sig === "valid-sig" ? "SUCCESS" : "FAILURE" });
+      }
+      if (req.method === "POST" && url.pathname === "/v2/checkout/orders") {
+        state.lastCreateBody = body;
+        state.createBodies.push(body);
+        const id = `PP-${++state.counter}`;
+        state.orders.set(id, { id, status: "CREATED", purchase_units: body.purchase_units, behavior: "complete", captured: null });
+        return send(201, { id, status: "CREATED", purchase_units: body.purchase_units });
+      }
+      const captureMatch = url.pathname.match(/^\/v2\/checkout\/orders\/([^/]+)\/capture$/);
+      if (req.method === "POST" && captureMatch) {
+        const order = state.orders.get(captureMatch[1]);
+        if (!order) return send(404, { name: "RESOURCE_NOT_FOUND", debug_id: "dbg404" });
+        const pu = order.purchase_units[0];
+        const completePayload = (captureOverrides = {}) => ({
+          id: order.id,
+          status: "COMPLETED",
+          purchase_units: [
+            {
+              custom_id: pu.custom_id,
+              payments: {
+                captures: [
+                  {
+                    id: "CAP-1",
+                    status: "COMPLETED",
+                    amount: { value: pu.amount.value, currency_code: pu.amount.currency_code },
+                    ...captureOverrides,
+                  },
+                ],
+              },
+            },
+          ],
+        });
+        if (String(req.headers["paypal-mock-response"] ?? "").includes("INSTRUMENT_DECLINED")) {
+          return send(422, {
+            name: "UNPROCESSABLE_ENTITY",
+            debug_id: "dbg-declined",
+            details: [{ issue: "INSTRUMENT_DECLINED", description: "The instrument presented was declined." }],
+          });
+        }
+        if (order.behavior === "notApproved") {
+          return send(422, {
+            name: "UNPROCESSABLE_ENTITY",
+            debug_id: "dbg-not-approved",
+            details: [{ issue: "ORDER_NOT_APPROVED", description: "Order was not approved." }],
+          });
+        }
+        if (order.behavior === "alreadyCaptured" && order.captured) {
+          return send(422, {
+            name: "UNPROCESSABLE_ENTITY",
+            debug_id: "dbg-already",
+            details: [{ issue: "ORDER_ALREADY_CAPTURED", description: "Order already captured." }],
+          });
+        }
+        if (order.behavior === "mismatch") {
+          order.captured = completePayload({ amount: { value: "0.01", currency_code: "USD" } });
+          return send(201, order.captured);
+        }
+        if (order.behavior === "wrongCustomId") {
+          const payload = completePayload();
+          payload.purchase_units[0].custom_id = "FOG-OTHER";
+          order.captured = payload;
+          return send(201, payload);
+        }
+        if (order.behavior === "pending") {
+          const payload = completePayload({ status: "PENDING" });
+          return send(201, payload);
+        }
+        order.captured = completePayload();
+        return send(201, order.captured);
+      }
+      const getMatch = url.pathname.match(/^\/v2\/checkout\/orders\/([^/]+)$/);
+      if (req.method === "GET" && getMatch) {
+        const order = state.orders.get(getMatch[1]);
+        if (!order) return send(404, { name: "RESOURCE_NOT_FOUND", debug_id: "dbg404" });
+        if (order.captured) return send(200, order.captured);
+        return send(200, { id: order.id, status: order.behavior === "notApproved" ? "CREATED" : order.status, purchase_units: order.purchase_units });
+      }
+      return send(404, { name: "NOT_FOUND" });
+    });
+  });
+  return new Promise((resolve) => {
+    server.listen(0, "127.0.0.1", () =>
+      resolve({
+        state,
+        base: `http://127.0.0.1:${server.address().port}`,
+        close: () =>
+          new Promise((r) => {
+            server.closeAllConnections?.();
+            server.close(r);
+          }),
+      }),
+    );
+  });
+}
+
+async function startShop(t) {
+  const fake = await startFakePayPal();
+  process.env.PAYPAL_API_BASE = fake.base;
+  process.env.PAYPAL_CLIENT_ID = "test-client-id";
+  process.env.PAYPAL_CLIENT_SECRET = "test-secret";
+  process.env.PAYPAL_WEBHOOK_ID = "WH-TEST";
+  process.env.PAYPAL_ENV = "sandbox";
+  const db = openDb(":memory:");
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k" });
+  const server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  const base = `http://127.0.0.1:${server.address().port}`;
+  t.after(async () => {
+    server.closeAllConnections?.();
+    await new Promise((r) => server.close(r));
+    await fake.close();
+  });
+  return { db, base, fake };
+}
+
+const post = (url, body, headers = {}) =>
+  fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: body === undefined ? undefined : JSON.stringify(body) });
+
+async function createPayPalOrder(shop, extra = {}) {
+  const res = await post(`${shop.base}/api/paypal/orders`, { items: [{ sku: "FOG-HOODIE", qty: 1 }], ...extra });
+  assert.equal(res.status, 200);
+  return res.json(); // { id, orderId }
+}
+
+function webhookHeaders(sig = "valid-sig") {
+  return {
+    "PAYPAL-AUTH-ALGO": "SHA256withRSA",
+    "PAYPAL-CERT-URL": "https://api-m.sandbox.paypal.com/certs/test",
+    "PAYPAL-TRANSMISSION-ID": "tx-1",
+    "PAYPAL-TRANSMISSION-SIG": sig,
+    "PAYPAL-TRANSMISSION-TIME": "2026-11-08T00:00:00Z",
+  };
+}
