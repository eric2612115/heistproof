+function completedPayPalOrder(shopId, { value = "49.00", currency = "USD", customId = shopId, status = "COMPLETED", captureStatus = "COMPLETED" } = {}) {
+  return {
+    id: PP_ORDER_ID,
+    status,
+    purchase_units: [
+      {
+        custom_id: customId,
+        payments: {
+          captures: [{ id: "CAP-1", status: captureStatus, amount: { value, currency_code: currency }, custom_id: customId }],
+        },
+      },
+    ],
+  };
+}
+
+// Fake PayPal API. `capture` / `getOrder` may be values or functions; a
+// function may throw a PayPalError to simulate a declined/refused capture.
+function fakePayPal({ capture, getOrder, verification = "SUCCESS" } = {}) {
+  const calls = [];
+  const api = async (method, path, body, options) => {
+    calls.push({ method, path, body, options });
+    if (path === "/v1/notifications/verify-webhook-signature") return { verification_status: verification };
+    if (method === "POST" && path === "/v2/checkout/orders") return { id: PP_ORDER_ID, status: "CREATED" };
+    if (method === "POST" && path.endsWith("/capture")) {
+      const result = typeof capture === "function" ? await capture({ method, path, body, options }) : capture;
+      return result;
+    }
+    if (method === "GET" && path.startsWith("/v2/checkout/orders/")) {
+      return typeof getOrder === "function" ? await getOrder() : getOrder;
+    }
+    throw new Error(`unexpected PayPal call ${method} ${path}`);
+  };
+  return { api, calls };
+}
