-// PayPal REST helpers. Written in an afternoon.
+// PayPal REST helpers.
+//
+// Amounts in the catalog are integer cents. PayPal amounts are decimal
+// strings in major units (dollars): 4900 cents is "49.00", never "4900".
+// This module is the one place that converts between the two.
+
+export class PayPalError extends Error {
+  constructor(message, { status = null, issue = null, description = null, debugId = null, details = null, payload = null } = {}) {
+    super(message);
+    this.name = "PayPalError";
+    this.status = status;
+    this.issue = issue;
+    this.description = description;
+    this.debugId = debugId;
+    this.details = details;
+    this.payload = payload;
+  }
+}
+
+/** Convert integer cents to PayPal's decimal-string amount. */
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) {
+    throw new Error(`Amount must be a non-negative integer number of cents, got ${cents}`);
+  }
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, "0")}`;
+}
+
+/** Convert PayPal's decimal-string amount back to integer cents. Returns null if malformed. */
+export function payPalAmountToCents(value) {
+  if (typeof value !== "string" && typeof value !== "number") return null;
+  const match = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(value).trim());
+  if (!match) return null;
+  return Number(match[1]) * 100 + Number((match[2] ?? "0").padEnd(2, "0"));
+}
+
+/** Flatten every capture on a PayPal order, carrying the purchase unit's custom_id. */
+export function collectCaptures(ppOrder) {
+  const captures = [];
+  for (const unit of ppOrder?.purchase_units ?? []) {
+    for (const capture of unit?.payments?.captures ?? []) {
+      captures.push({
+        capture,
+        purchaseUnit: unit,
+        // PayPal's capture response does not always echo custom_id on the
+        // capture itself; the purchase unit carries it (or our reference_id,
+        // which we also set to the shop order id at create time).
+        customId: capture?.custom_id ?? unit?.custom_id ?? unit?.reference_id ?? null,
+        status: capture?.status ?? null,
+        amount: capture?.amount ?? null,
+      });
+    }
+  }
+  return captures;
+}
+
+function errorFields(payload) {
+  const detail = Array.isArray(payload?.details) ? payload.details[0] : null;
+  return {
+    issue: detail?.issue ?? payload?.name ?? payload?.issue ?? null,
+    description: detail?.description ?? payload?.message ?? null,
+    debugId: payload?.debug_id ?? null,
+    details: payload?.details ?? null,
+  };
+}
+
