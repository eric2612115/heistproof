+// Rules 7 + 8: a verified capture-completed webhook settles once; replaying
+// it, or replaying an old approval after it, changes nothing.
+test("a verified PAYMENT.CAPTURE.COMPLETED webhook pays once; replays change nothing", async () => {
+  const fake = fakePayPal();
+  const shop = await startShop(fake.client);
+  try {
+    const { orderId } = await createPayPalOrder(shop);
+    const event = {
+      id: "WH-EVT-3",
+      event_type: "PAYMENT.CAPTURE.COMPLETED",
+      resource: {
+        id: "CAP-1",
+        status: "COMPLETED",
+        amount: { currency_code: "USD", value: "49.00" },
+        supplementary_data: { related_ids: { order_id: PP_ORDER_ID } },
+      },
+    };
+    assert.equal((await post(`${shop.base}/api/paypal/webhooks`, event, webhookHeaders)).status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+
+    assert.equal((await post(`${shop.base}/api/paypal/webhooks`, event, webhookHeaders)).status, 200);
+    assert.equal(
+      (
+        await post(
+          `${shop.base}/api/paypal/webhooks`,
+          { id: "WH-EVT-4", event_type: "CHECKOUT.ORDER.APPROVED", resource: { id: PP_ORDER_ID, status: "APPROVED" } },
+          webhookHeaders,
+        )
+      ).status,
+      200,
+    );
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
