+++ b/test/paypal.test.js
@@ -0,0 +1,301 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "../server.js";
+import { openDb } from "../lib/db.js";
+import { createCardProcessor } from "../lib/card-processor.js";
+import { centsToPayPalAmount, payPalAmountToCents } from "../lib/paypal.js";
+
+const WEBHOOK_HEADERS = {
+  "paypal-auth-algo": "SHA256withRSA",
+  "paypal-cert-url": "https://api-m.sandbox.paypal.com/certs/test",
+  "paypal-transmission-id": "tx-1",
+  "paypal-transmission-sig": "sig",
+  "paypal-transmission-time": "2026-01-01T00:00:00Z",
+};
+
+// Fake PayPal REST layer (the createApp seam). Handlers are per-test closures;
+// every call is recorded so tests can assert what would have gone to PayPal.
+async function startShop(handler) {
+  process.env.PAYPAL_WEBHOOK_ID = "WH-TEST";
+  const calls = [];
+  const paypalClient = async (method, path, body) => {
+    calls.push({ method, path, body });
+    return handler({ method, path, body });
+  };
+  const db = openDb(":memory:");
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypalClient });
+  const server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  const base = `http://127.0.0.1:${server.address().port}`;
+  return { db, base, calls, close: () => new Promise((r) => server.close(r)) };
+}
+
+const post = (url, body, headers = {}) =>
+  fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body) });
+
+const ppError = (issue, debug = "dbg-1") => ({
+  name: "UNPROCESSABLE_ENTITY",
+  debug_id: debug,
+  details: [{ issue, description: `${issue} from PayPal` }],
+});
+
+function completedCaptureBody({ shopOrderId, value = "49.00", currency = "USD", captureStatus = "COMPLETED" }) {
+  return {
+    id: "PP-ORDER-1",
+    status: captureStatus === "COMPLETED" ? "COMPLETED" : "APPROVED",
+    purchase_units: [
+      {
+        custom_id: shopOrderId,
+        payments: { captures: [{ id: "CAP-1", status: captureStatus, amount: { value, currency_code: currency } }] },
+      },
+    ],
+  };
+}
+
+// Creates a shop order bound to PP-ORDER-1 and returns { shopOrderId }.
+async function createBag(shop, createHandler) {
+  const res = await post(`${shop.base}/api/paypal/orders`, { items: [{ sku: "FOG-HOODIE", qty: 1 }] });
+  assert.equal(res.status, 200);
+  const data = await res.json();
+  assert.equal(data.id, "PP-ORDER-1");
+  return data.orderId;
+}
+
+function baseHandler(overrides = {}) {
+  return ({ method, path, body }) => {
+    if (path === "/v1/notifications/verify-webhook-signature") {
+      return { status: 200, body: { verification_status: overrides.verification ?? "SUCCESS" } };
+    }
+    if (method === "POST" && path === "/v2/checkout/orders") {
+      return { status: 201, body: { id: "PP-ORDER-1" } };
+    }
+    if (method === "POST" && path.endsWith("/capture")) return overrides.capture(body);
+    if (method === "GET" && path.startsWith("/v2/checkout/orders/")) return overrides.getOrder(body);
+    throw new Error(`unexpected PayPal call ${method} ${path}`);
+  };
+}
+
+test("cents convert to PayPal decimal strings exactly (rule 2)", () => {
+  assert.equal(centsToPayPalAmount(4900), "49.00");
+  assert.equal(centsToPayPalAmount(5), "0.05");
+  assert.equal(centsToPayPalAmount(0), "0.00");
+  assert.equal(centsToPayPalAmount(101), "1.01");
+  assert.equal(payPalAmountToCents("49.00"), 4900);
+  assert.equal(payPalAmountToCents("0.01"), 1);
+  assert.equal(payPalAmountToCents("4900"), null);
+});
+
+test("create order ignores browser prices and sends the server total with breakdown (rules 1, 2)", async () => {
+  let sent;
+  const shop = await startShop(({ method, path, body }) => {
+    sent = body;
+    return { status: 201, body: { id: "PP-ORDER-1" } };
+  });
+  try {
+    const res = await post(`${shop.base}/api/paypal/orders`, {
+      items: [{ sku: "FOG-HOODIE", qty: 1, price: 1, unit_amount: { value: "0.01" } }],
+      amount: 1,
+      total: "0.01",
+      currency: "EUR",
+      price: 1,
+    });
+    assert.equal(res.status, 200);
+    const data = await res.json();
+    const unit = sent.purchase_units[0];
+    assert.equal(unit.amount.value, "49.00");
+    assert.equal(unit.amount.currency_code, "USD");
+    assert.equal(unit.amount.breakdown.item_total.value, "49.00");
+    assert.equal(unit.items[0].unit_amount.value, "49.00");
+    assert.equal(unit.custom_id, data.orderId);
+    assert.equal(unit.invoice_id, data.orderId);
+    assert.equal(shop.db.getOrder(data.orderId).payment_reference, "PP-ORDER-1");
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a $0.01 capture does not ship the $49 hoodie (rules 1, 2, 4)", async () => {
+  let shopOrderId;
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 201, body: completedCaptureBody({ shopOrderId, value: "0.01" }) }),
+  }));
+  try {
+    shopOrderId = await createBag(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(res.status, 422);
+    assert.equal(shop.db.getOrder(shopOrderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("capturing an order nobody approved does not mark it paid (rule 4)", async () => {
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 422, body: ppError("ORDER_NOT_APPROVED", "dbg-approved") }),
+  }));
+  try {
+    const shopOrderId = await createBag(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(res.status, 422);
+    const data = await res.json();
+    assert.equal(data.issue, "ORDER_NOT_APPROVED");
+    assert.equal(data.debug_id, "dbg-approved");
+    assert.equal(shop.db.getOrder(shopOrderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a capture answer with no completed capture (order still CREATED) does not mark it paid (rule 4)", async () => {
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 200, body: { id: "PP-ORDER-1", status: "CREATED", purchase_units: [] } }),
+  }));
+  try {
+    const shopOrderId = await createBag(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(res.status, 422);
+    assert.equal(shop.db.getOrder(shopOrderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a real completed capture fulfils once, and capturing again is safe (rules 4, 8, 10)", async () => {
+  let shopOrderId;
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 201, body: completedCaptureBody({ shopOrderId }) }),
+  }));
+  try {
+    shopOrderId = await createBag(shop);
+    const first = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(first.status, 200);
+    assert.equal((await first.json()).status, "fulfilled");
+    const second = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(second.status, 200);
+    assert.equal(shop.db.getOrder(shopOrderId).status, "fulfilled");
+    assert.equal(shop.db.getOrder(shopOrderId).paid_cents, 4900);
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("ORDER_ALREADY_CAPTURED settles by reading the order from PayPal (rule 10)", async () => {
+  let shopOrderId;
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 422, body: ppError("ORDER_ALREADY_CAPTURED") }),
+    getOrder: () => ({ status: 200, body: completedCaptureBody({ shopOrderId }) }),
+  }));
+  try {
+    shopOrderId = await createBag(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(res.status, 200);
+    assert.equal(shop.db.getOrder(shopOrderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 1);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("INSTRUMENT_DECLINED stays unpaid and asks for another payment method (rule 5)", async () => {
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 422, body: ppError("INSTRUMENT_DECLINED") }),
+  }));
+  try {
+    const shopOrderId = await createBag(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(res.status, 402);
+    const data = await res.json();
+    assert.equal(data.issue, "INSTRUMENT_DECLINED");
+    assert.match(data.error, /another way to pay/);
+    assert.equal(shop.db.getOrder(shopOrderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a PENDING capture stays unpaid until the webhook (rule 5)", async () => {
+  let shopOrderId;
+  const shop = await startShop(baseHandler({
+    capture: () => ({ status: 201, body: completedCaptureBody({ shopOrderId, captureStatus: "PENDING" }) }),
+  }));
+  try {
+    shopOrderId = await createBag(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PP-ORDER-1/capture`, {});
+    assert.equal(res.status, 202);
+    assert.equal(shop.db.getOrder(shopOrderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
+
+function captureCompletedEvent(id, shopOrderId) {
+  return {
+    id,
+    event_type: "PAYMENT.CAPTURE.COMPLETED",
+    resource: {
+      id: "CAP-1",
+      status: "COMPLETED",
+      custom_id: shopOrderId,
+      amount: { value: "49.00", currency_code: "USD" },
+      supplementary_data: { related_ids: { order_id: "PP-ORDER-1" } },
+    },
+  };
+}
+
+test("CHECKOUT.ORDER.APPROVED webhook never marks an order paid (rule 4)", async () => {
+  const shop = await startShop(baseHandler({ capture: () => { throw new Error("unused"); } }));
