+    assert.equal(shop.db.getOrder(shopOrderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(shopOrderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
+
+test("a forged webhook (verification FAILURE) is rejected and changes nothing (rule 6)", async () => {
+  const shop = await startShop(baseHandler({ verification: "FAILURE", capture: () => { throw new Error("unused"); } }));
