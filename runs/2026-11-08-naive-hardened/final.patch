+// Rules 4 + 6: approval is not payment, and forged webhooks change nothing.
+test("a verified CHECKOUT.ORDER.APPROVED webhook does not mark the order paid", async () => {
+  const fake = fakePayPal();
+  const shop = await startShop(fake.client);
+  try {
+    const { orderId } = await createPayPalOrder(shop);
+    const res = await post(
+      `${shop.base}/api/paypal/webhooks`,
+      { id: "WH-EVT-1", event_type: "CHECKOUT.ORDER.APPROVED", resource: { id: PP_ORDER_ID, status: "APPROVED" } },
+      webhookHeaders,
+    );
+    assert.equal(res.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 0);
+  } finally {
+    await shop.close();
+  }
+});
