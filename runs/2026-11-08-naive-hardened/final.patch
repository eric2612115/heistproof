+import { centsToPayPalAmount, payPalAmountToCents, PayPalError } from "../lib/paypal.js";
+
+const PP_ORDER_ID = "PP-ORDER-123";
+
+// A stand-in for the PayPal sandbox. Records every call, creates an order,
+// and answers capture / GET order / webhook-verification as configured.
+// Its capture echoes the custom_id the shop bound at create time, like
+// the real Orders v2 API.
+function fakePayPal({ capture, captureError, held, verifyStatus = "SUCCESS" } = {}) {
+  const calls = [];
+  let boundCustomId = null;
+  const completedPayload = (amountValue = "49.00", currency = "USD") => ({
+    id: PP_ORDER_ID,
+    status: "COMPLETED",
+    purchase_units: [
+      {
+        reference_id: boundCustomId,
+        custom_id: boundCustomId,
+        payments: {
+          captures: [
+            { id: "CAP-1", status: "COMPLETED", amount: { currency_code: currency, value: amountValue } },
+          ],
+        },
+      },
+    ],
+  });
+  const client = async (method, path, body) => {
+    calls.push({ method, path, body });
+    if (method === "POST" && path === "/v2/checkout/orders") {
+      boundCustomId = body.purchase_units[0].custom_id;
+      return { id: PP_ORDER_ID, status: "CREATED" };
+    }
+    if (method === "POST" && path.endsWith("/capture")) {
+      if (captureError) throw captureError;
+      if (typeof capture === "function") return capture({ boundCustomId, completedPayload });
+      return capture ?? completedPayload();
+    }
+    if (method === "GET" && path.startsWith("/v2/checkout/orders/")) {
+      if (typeof held === "function") return held({ boundCustomId, completedPayload });
+      return held ?? completedPayload();
+    }
+    if (method === "POST" && path === "/v1/notifications/verify-webhook-signature") {
+      return { verification_status: verifyStatus };
+    }
+    throw new Error(`fake PayPal: unexpected ${method} ${path}`);
+  };
+  return { client, calls, completedPayload };
+}
+
