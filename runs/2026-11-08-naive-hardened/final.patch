+// PayPal REST helpers. Amount conversion lives here and nowhere else.
 const base = () => process.env.PAYPAL_API_BASE ?? "https://api-m.sandbox.paypal.com";
 
+// Catalog prices are integer cents; PayPal amounts are decimal dollar strings.
+// 4900 -> "49.00", 5 -> "0.05".
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error(`Invalid cents amount: ${cents}`);
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, "0")}`;
+}
+
+// Exact inverse of centsToPayPalAmount. Returns null for anything that is not
+// a canonical decimal string, so "49.00" -> 4900 and "0.01" -> 1 (never floats).
+export function payPalAmountToCents(value) {
+  if (typeof value !== "string") return null;
+  const match = /^(\d+)\.(\d{2})$/.exec(value.trim());
+  if (!match) return null;
+  return Number(match[1]) * 100 + Number(match[2]);
+}
+
+// PayPal's own error vocabulary: callers must key off this, not assumptions.
+export function payPalErrorInfo(body) {
+  const detail = Array.isArray(body?.details) ? body.details[0] : undefined;
+  return {
+    issue: detail?.issue ?? body?.name ?? "PAYPAL_ERROR",
+    message: detail?.description ?? body?.message ?? "PayPal rejected the request.",
+    debugId: body?.debug_id ?? null,
+  };
+}
