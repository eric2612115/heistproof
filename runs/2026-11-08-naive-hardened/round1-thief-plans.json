{
  "plans": [
    {
      "name": "Capture lands on newest order",
      "idea": "The capture endpoint binds a PayPal capture to the newest shop order in the session, or to an orderId supplied in the capture body, instead of the custom_id stored on the PayPal order, and does not compare the captured and shop-order amounts.",
      "expect": "Four hoodies are fulfilled after capturing only the $49 one-hoodie PayPal order.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{a.body.orderId}}",
            "shopOrderId": "{{a.body.orderId}}"
          },
          "times": 1,
          "together": false
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "body": null,
          "times": 1,
          "together": false
        }
      ]
    },
    {
      "name": "Old capture, new order",
      "idea": "The CAPTURE.COMPLETED webhook handler trusts resource.custom_id to select the order and checks only whether that order is already fulfilled, without checking that this capture ID already settled the legitimate order or re-fetching the capture from PayPal.",
      "expect": "A second hoodie order is fulfilled by reusing the legitimate $49 capture, with no new payment for the second order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.orderId}}",
            "resource.invoice_id": "{{a.body.orderId}}",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.id}}"
          },
          "signed": true,
          "times": 1
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "body": null,
          "times": 1,
          "together": false
        }
      ]
    },
    {
      "name": "49-yen hoodie",
      "idea": "Extra currency or purchase-unit fields supplied at PayPal-order creation are forwarded to PayPal, while later verification compares only the numeric value 49.00 and ignores currency_code.",
      "expect": "The hoodie is fulfilled after PayPal captures 49 JPY instead of 49 USD.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ],
            "currency": "JPY",
            "currency_code": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "49"
            },
            "purchase_units": [
              {
                "reference_id": "default",
                "amount": {
                  "currency_code": "JPY",
                  "value": "49",
                  "breakdown": {
                    "item_total": {
                      "currency_code": "JPY",
                      "value": "49"
                    }
                  }
                },
                "items": [
                  {
                    "name": "Fogline Hoodie",
                    "sku": "FOG-HOODIE",
                    "quantity": "1",
                    "unit_amount": {
                      "currency_code": "JPY",
                      "value": "49"
                    }
                  }
                ]
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{b.shopOrderId}}",
          "body": null,
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Duplicate lines, single charge",
      "idea": "Pricing de-duplicates repeated SKUs, for example with a Map keyed by SKU, while the stored and fulfilled order retains every raw duplicate line.",
      "expect": "Three hoodies are fulfilled while PayPal is charged for only one.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{b.shopOrderId}}",
          "body": null,
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Forged binding identifier",
      "idea": "Client-supplied custom_id or invoice_id fields override the binding identifier the shop normally sets on a PayPal order, so capture processing follows the supplied identifier to another pending shop order and does not enforce the amount for that order.",
      "expect": "The pending three-hoodie shop order is fulfilled after the separate one-hoodie PayPal order is captured for $49.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ],
            "orderId": "{{a.body.orderId}}",
            "shopOrderId": "{{a.body.orderId}}",
            "custom_id": "{{a.body.orderId}}",
            "invoice_id": "{{a.body.orderId}}",
            "purchase_units": [
              {
                "reference_id": "default",
                "custom_id": "{{a.body.orderId}}",
                "invoice_id": "{{a.body.orderId}}",
                "amount": {
                  "currency_code": "USD",
                  "value": "49.00"
                }
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "body": null,
          "times": 1,
          "together": false
        }
      ]
    },
    {
      "name": "Expired test card",
      "idea": "The separate card route checks the card number against its declined-card logic but does not validate that the expiration date is in the future before treating the simulated charge as paid.",
      "expect": "A hoodie order is fulfilled using a Luhn-valid test card number that expired in January 2000.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/card",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ],
            "email": "shopper@example.com",
            "card": {
              "number": "4242424242424242",
              "exp": "01/00",
              "cvc": "999"
            }
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "body": null,
          "times": 1,
          "together": false
        }
      ]
    }
  ]
}