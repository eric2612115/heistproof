+  assert.equal(resolvePayPalSdkConfig({ apiBase: "http://127.0.0.1:9999" }).sdkUrl, SANDBOX_SDK_URL);
+  assert.equal(resolvePayPalSdkConfig({ apiBase: "https://proxy.example.test/paypal" }).sdkUrl, SANDBOX_SDK_URL);
+  // Production only for an explicit live host, and never with testBuyerCountry.
+  assert.equal(resolvePayPalSdkConfig({ apiBase: "https://api-m.paypal.com" }).sdkUrl, PRODUCTION_SDK_URL);
