+test("Fix R2-4: browser wiring — handlers before src, PayPal wired before optional messages", () => {
+  const src = fs.readFileSync(new URL("../public/paypal.js", import.meta.url), "utf8");
+  // Load handlers must be registered before the src is assigned (load race).
+  assert.ok(src.indexOf("script.onload") > -1 && src.indexOf("script.onload") < src.indexOf("script.src ="), "onload must precede src assignment");
+  assert.ok(src.indexOf("script.onerror") > -1 && src.indexOf("script.onerror") < src.indexOf("script.src ="), "onerror must precede src assignment");
+  // The PayPal button must be wired before createPayPalMessages runs, so a
+  // messaging failure can never leave every button hidden (the round-1 bug).
+  assert.ok(src.indexOf('isMethodEligible(methods, "paypal")') < src.indexOf("sdk.createPayPalMessages"), "PayPal button must be wired before Pay Later messaging");
+  assert.ok(src.indexOf('isMethodEligible(methods, "paypal")') < src.indexOf('isMethodEligible(methods, "venmo")'), "PayPal must be wired before Venmo");
+  // Fallbacks that keep a real purchase completable.
+  assert.match(src, /loadSdkScript\(SANDBOX_SDK_URL\)/, "failed core load must retry with the sandbox core");
+  assert.match(src, /createInstance\(baseOptions\)/, "createInstance must retry without testBuyerCountry");
+});
