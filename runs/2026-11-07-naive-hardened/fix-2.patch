+// Pure helpers for the PayPal v6 browser integration. No DOM access, so
+// Node tests can import this file directly (public/paypal.js uses it too).
+
+export const SANDBOX_SDK_URL = "https://www.sandbox.paypal.com/web-sdk/v6/core";
+
+// Eligibility must never hide the PayPal button on an *unknown* answer:
+// findEligibleMethods() failing, returning a malformed object, or its
+// isEligible() throwing leaves eligibility unknown — in that case PayPal
+// (the primary method) is shown and Venmo/Pay Later (which need a positive
+// eligibility answer, and Pay Later also needs its details) stay hidden.
+// Only an explicit `false` from PayPal hides a button.
+export function isMethodEligible(methods, method) {
+  if (!methods || typeof methods.isEligible !== "function") return method === "paypal";
+  try {
+    return Boolean(methods.isEligible(method));
+  } catch {
+    return method === "paypal";
+  }
+}
+
+// Decimal-dollar string for <paypal-message>, or null when there is no
+// positive total to advertise (a "0.00" Pay Later message is invalid and
+// must never be pushed into the component before the buttons are wired).
+export function payPalMessageAmount(totalCents) {
+  if (!Number.isInteger(totalCents) || totalCents <= 0) return null;
+  return `${Math.floor(totalCents / 100)}.${String(totalCents % 100).padStart(2, "0")}`;
+}
