+  const prod = resolvePayPalSdkConfig({ apiBase: "https://api-m.sandbox.paypal.com", sdkUrl: PRODUCTION_SDK_URL, testBuyerCountry: "GB" });
+  assert.equal(prod.sdkUrl, PRODUCTION_SDK_URL);
+  assert.equal(prod.testBuyerCountry, undefined, "testBuyerCountry is sandbox-only and must be omitted for the production core");
+  // Explicit SDK URL wins.
