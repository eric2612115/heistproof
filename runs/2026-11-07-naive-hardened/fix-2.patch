+export const SANDBOX_SDK_URL = "https://www.sandbox.paypal.com/web-sdk/v6/core";
+export const PRODUCTION_SDK_URL = "https://www.paypal.com/web-sdk/v6/core";
+
+// Which v6 core the browser must load. The SDK determines its environment
+// from the host it was loaded from, and createInstance() rejects a
+// testBuyerCountry (and a sandbox client id) on the production core — so
+// guessing "live" from a non-sandbox API base (a local/recording proxy, a
+// bare host, an unset value) makes the PayPal button never appear.
+// Rules: an explicit PAYPAL_SDK_URL wins; otherwise production only for an
+// explicit live API host with no test buyer country; everything else is
+// sandbox. testBuyerCountry is sandbox-only, so it is never sent with a
+// production core.
+export function resolvePayPalSdkConfig({ apiBase, sdkUrl, testBuyerCountry } = {}) {
+  const explicit = typeof sdkUrl === "string" && sdkUrl.trim() ? sdkUrl.trim() : null;
+  let resolved = explicit;
+  if (!resolved) {
+    let host = "";
+    try { host = new URL(apiBase ?? "").hostname; } catch { /* unset/invalid -> sandbox */ }
+    const isLiveHost = host === "api-m.paypal.com" || host === "api.paypal.com";
+    resolved = isLiveHost && !testBuyerCountry ? PRODUCTION_SDK_URL : SANDBOX_SDK_URL;
+  }
+  const isSandboxSdk = resolved.includes("sandbox.paypal.com");
+  return { sdkUrl: resolved, testBuyerCountry: isSandboxSdk ? (testBuyerCountry || undefined) : undefined };
+}
