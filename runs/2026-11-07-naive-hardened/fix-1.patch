+function completedBody(shopId, { value = "49.00", currency = "USD", captureStatus = "COMPLETED", customId = shopId } = {}) {
+  return {
+    id: "PP-ORDER-1",
+    status: captureStatus === "COMPLETED" ? "COMPLETED" : "APPROVED",
+    purchase_units: [{
+      custom_id: customId,
+      reference_id: customId,
+      amount: { currency_code: currency, value },
+      payments: { captures: [{ id: "CAP-1", status: captureStatus, amount: { currency_code: currency, value } }] },
+    }],
+  };
+}
+
+function makeFakePayPal(overrides = {}) {
+  const fake = {
+    calls: { create: 0, capture: 0, get: 0 },
+    payload: null,
+    async createOrder(payload) {
+      fake.calls.create++;
+      fake.payload = payload;
+      return { status: 201, body: { id: "PP-ORDER-1", status: "CREATED" } };
+    },
+    async captureOrder() {
+      fake.calls.capture++;
+      const shopId = fake.payload.purchase_units[0].custom_id;
+      return { status: 201, body: completedBody(shopId) };
+    },
+    async getOrder() {
+      fake.calls.get++;
+      const shopId = fake.payload.purchase_units[0].custom_id;
+      return { status: 200, body: completedBody(shopId) };
+    },
+    async verifyWebhookSignature() {
+      return { status: 200, body: { verification_status: "SUCCESS" } };
+    },
+    ...overrides,
+  };
+  return fake;
+}
+
