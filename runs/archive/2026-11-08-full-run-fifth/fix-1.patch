+test("capture sends an empty JSON body (real sandbox rejects a bodyless capture with 415)", async () => {
+  const fake = makeFakePayPal();
+  const shop = await startShop(fake);
+  try {
+    const { orderId } = await createPayPalOrder(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/PAYPAL-ORDER-1/capture`);
+    // Without the JSON body the fake — like the real sandbox — answers
+    // 415 UNSUPPORTED_MEDIA_TYPE and the order would stay pending.
+    assert.equal(res.status, 200, await res.clone().text().catch(() => ""));
+    assert.equal((await res.json()).status, "fulfilled");
+    assert.equal(shop.db.getOrder(orderId).status, "fulfilled");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+
+    const captureCall = fake.calls.find((c) => c.path.endsWith("/capture"));
+    assert.ok(captureCall.headers.get("content-type")?.includes("application/json"), "capture must send Content-Type: application/json");
+    assert.equal(captureCall.rawBody, "{}");
+    assert.deepEqual(captureCall.body, {});
+  } finally { await shop.close(); }
+});
