+++ b/lib/paypal.js
@@ -0,0 +1,280 @@
+import { PaypalError } from "paypal";
+import { PaypalClient } from "paypal";
+
+// One conversion function (hardening #2): integer cents -> PayPal decimal dollars string.
+export function centsToPayPalAmount(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  const dollars = Math.floor(cents / 100);
+  const rem = cents % 100;
+  return `${dollars}.${String(rem).padStart(2, "0")}`;
+}
+
+export function payPalAmountToCents(value) {
+  if (typeof value !== "string") return null;
+  const m = /^(\d+)(?:\.(\d{1,2}))?$/.exec(value.trim());
+  if (!m) return null;
+  return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0") || 0);
+}
+
+export class PayPalServiceError extends Error {
+  constructor(status, message, { code, reason, unknown = false, cause } = {}) {
+    super(message, cause ? { cause } : undefined);
+    this.status = status;
+    this.code = code;
+    this.reason = reason;
+    this.unknown = unknown;
+  }
+}
+
+function extractReason(err) {
+  try {
+    const payload = err?.payload;
+    if (payload && payload.kind !== "undeclared" && payload.body) {
+      const body = payload.body;
+      const details = Array.isArray(body.details) ? body.details : [];
+      const detailText = details.map((d) => d.description || d.issue).filter(Boolean).join("; ");
+      return { text: [body.message, detailText].filter(Boolean).join(" — ") || body.name || undefined, issue: details[0]?.issue, name: body.name, details };
+    }
+    if (payload && "rawBody" in payload && payload.rawBody) {
+      const text = new TextDecoder().decode(payload.rawBody);
+      try {
+        const j = JSON.parse(text);
+        const details = Array.isArray(j.details) ? j.details : [];
+        return { text: j.message || j.name || text.slice(0, 300), issue: details[0]?.issue, name: j.name, details };
+      } catch {
+        return { text: text.slice(0, 300) || undefined, details: [] };
+      }
+    }
+  } catch {}
+  return { details: [] };
+}
+
+// Map SDK family errors to our HTTP boundary per plan 1b.4. Returns PayPalServiceError (or rethrows outside family).
+export function mapSdkError(err, { isWrite = false } = {}) {
+  if (err instanceof PaypalError) {
+    switch (err.kind) {
+      case "api": {
+        const reason = extractReason(err);
+        const reasonText = reason.text;
+        if (err.status === 401 || err.status === 403) {
+          return new PayPalServiceError(502, "Payment provider unavailable.", { cause: err, reason: reasonText });
+        }
+        if (err.status === 429) return new PayPalServiceError(503, "Payment provider temporarily unavailable.", { cause: err });
+        if (err.status >= 400 && err.status < 500) {
+          return new PayPalServiceError(err.status, reasonText ?? "Payment request rejected.", { cause: err, reason: reasonText, code: reason.issue });
+        }
+        return new PayPalServiceError(502, "Payment provider error.", { cause: err, reason: reasonText });
+      }
+      case "auth":
+      case "encode":
+        // Never sent: no re-read for writes.
+        return new PayPalServiceError(502, "Payment provider unavailable.", { cause: err });
+      case "connection":
+      case "timeout":
+      case "decode":
+        if (isWrite) return new PayPalServiceError(502, "Payment outcome unknown. Please check your order status.", { cause: err, unknown: true });
+        return new PayPalServiceError(502, "Payment provider error.", { cause: err });
+      default:
+        return new PayPalServiceError(502, "Payment provider error.", { cause: err });
+    }
+  }
+  throw err;
+}
+
+export function createPayPalService({
+  clientId,
+  clientSecret,
+  webhookId,
+  apiBase = "https://api-m.sandbox.paypal.com",
+  env = "sandbox",
+  testBuyerCountry,
+  fetchImpl,
+  sdkClient,
+} = {}) {
+  if (!clientId) throw new Error("PAYPAL_CLIENT_ID is not configured");
+  if (!clientSecret) throw new Error("PAYPAL_CLIENT_SECRET is not configured");
+  if (env !== "sandbox" && env !== "live") throw new Error(`PAYPAL_ENV must be "sandbox" or "live"`);
+  const base = String(apiBase || "https://api-m.sandbox.paypal.com").replace(/\/+$/, "");
+  const transport = fetchImpl ?? globalThis.fetch;
+  if (typeof transport !== "function") throw new Error("no fetch available for PayPal client");
+  const client =
+    sdkClient ??
+    new PaypalClient({
+      oauth2: { clientId, clientSecret },
+      serverOptions: { baseUrl: base },
+      retry: { maxRetries: 0, timeout: 10_000 },
+      logging: { level: "off" },
+      fetch: transport,
+    });
+
+  const scriptUrl = env === "live" ? "https://www.paypal.com/web-sdk/v6/core" : "https://www.sandbox.paypal.com/web-sdk/v6/core";
+
+  async function createOrder({ shopOrderId, cart }) {
+    const currency = "USD";
+    const total = centsToPayPalAmount(cart.totalCents);
+    const body = {
+      intent: "CAPTURE",
+      purchaseUnits: [
+        {
+          customId: shopOrderId,
+          invoiceId: shopOrderId,
+          amount: {
+            currencyCode: currency,
+            value: total,
+            breakdown: { itemTotal: { currencyCode: currency, value: total } },
+          },
+          items: cart.lines.map((l) => ({
+            name: l.name,
+            sku: l.sku,
+            quantity: String(l.qty),
+            unitAmount: { currencyCode: currency, value: centsToPayPalAmount(l.unitCents) },
+          })),
+        },
+      ],
+    };
+    let order;
+    try {
+      order = await client.orders.createOrder({ payPalRequestId: shopOrderId, prefer: "return=representation", body });
+    } catch (err) {
+      throw mapSdkError(err, { isWrite: true });
+    }
+    if (!order?.id) {
+      throw new PayPalServiceError(502, "Payment outcome unknown. Please check your order status.", { unknown: true });
+    }
+    return order;
+  }
+
+  async function captureOrder({ paypalOrderId, shopOrderId }) {
+    try {
+      // Real sandbox 415 UNSUPPORTED_MEDIA_TYPE (debug ca571d11c6846) when no body is sent:
+      // omitting `body` sends no Content-Type at all. PayPal capture requires an empty JSON object.
+      const order = await client.orders.captureOrder({ id: paypalOrderId, payPalRequestId: shopOrderId, prefer: "return=representation", body: {} });
+      if (!order?.id || !Array.isArray(order.purchaseUnits)) {
+        throw new PayPalServiceError(502, "Payment outcome unknown. Please check your order status.", { unknown: true });
+      }
+      return order;
+    } catch (err) {
+      if (err instanceof PayPalServiceError) throw err;
+      // ORDER_ALREADY_CAPTURED and unknown outcomes are settled by caller via getOrder.
+      const mapped = mapSdkError(err, { isWrite: true });
+      const reason = err instanceof PaypalError && err.kind === "api" ? extractReason(err) : {};
+      if (reason.issue) mapped.code = reason.issue;
+      if (reason.text) mapped.reason = reason.text;
+      throw mapped;
+    }
+  }
+
+  async function getOrder({ paypalOrderId }) {
+    try {
+      const order = await client.orders.getOrder({ id: paypalOrderId });
+      if (!order?.id) throw new PayPalServiceError(502, "Payment provider error.", {});
+      return order;
+    } catch (err) {
+      if (err instanceof PayPalServiceError) throw err;
+      throw mapSdkError(err, { isWrite: false });
+    }
+  }
+
+  // Webhook verification: SDK has no operation for this; direct REST to PAYPAL_API_BASE (plan).
+  async function verifyWebhook({ headers, event }) {
+    if (!webhookId) throw new PayPalServiceError(502, "Payment provider unavailable.", {});
+    const get = (name) => (typeof headers?.get === "function" ? headers.get(name) : headers?.[name] ?? headers?.[name.toLowerCase()]);
+    const auth_algo = get("paypal-auth-algo");
+    const cert_url = get("paypal-cert-url");
+    const transmission_id = get("paypal-transmission-id");
+    const transmission_sig = get("paypal-transmission-sig");
+    const transmission_time = get("paypal-transmission-time");
+    if (!auth_algo || !cert_url || !transmission_id || !transmission_sig || !transmission_time) {
+      return { verified: false, status: 400 };
+    }
+    // Client-credentials token at PAYPAL_API_BASE.
+    let tokenRes;
+    try {
+      tokenRes = await transport(`${base}/v1/oauth2/token`, {
+        method: "POST",
+        headers: {
+          authorization: `Basic ${Buffer.from(`${clientId}:${clientSecret}`).toString("base64")}`,
+          "content-type": "application/x-www-form-urlencoded",
+        },
+        body: "grant_type=client_credentials",
+      });
+    } catch (e) {
+      throw new PayPalServiceError(502, "Payment provider error.", { cause: e });
+    }
+    if (!tokenRes.ok) throw new PayPalServiceError(502, "Payment provider unavailable.", {});
+    const tokenJson = await tokenRes.json().catch(() => null);
+    const accessToken = tokenJson?.access_token;
+    if (!accessToken) throw new PayPalServiceError(502, "Payment provider unavailable.", {});
+    let verifyRes;
+    try {
+      verifyRes = await transport(`${base}/v1/notifications/verify-webhook-signature`, {
+        method: "POST",
+        headers: { authorization: `Bearer ${accessToken}`, "content-type": "application/json" },
+        body: JSON.stringify({ auth_algo, cert_url, transmission_id, transmission_sig, transmission_time, webhook_id: webhookId, webhook_event: event }),
+      });
+    } catch (e) {
+      throw new PayPalServiceError(502, "Payment provider error.", { cause: e });
+    }
+    if (!verifyRes.ok) {
+      // Verification endpoint refusing is treated as unverified unless it's our auth (401/403 -> 502 ladder via status check)
+      if (verifyRes.status === 401 || verifyRes.status === 403) throw new PayPalServiceError(502, "Payment provider unavailable.", {});
+      return { verified: false, status: 400 };
+    }
+    const verifyJson = await verifyRes.json().catch(() => null);
+    return { verified: verifyJson?.verification_status === "SUCCESS", status: verifyJson?.verification_status === "SUCCESS" ? 200 : 400 };
+  }
+
+  return {
+    clientId,
+    scriptUrl,
+    env,
+    testBuyerCountry: env === "sandbox" && testBuyerCountry ? testBuyerCountry : undefined,
+    currency: "USD",
+    createOrder,
+    captureOrder,
+    getOrder,
+    verifyWebhook,
+    // exposed for tests / diagnostics only, never credentials
+    _client: client,
+  };
+}
+
+export function payPalServiceFromEnv(envVars = process.env, fetchImpl) {
+  const clientId = envVars.PAYPAL_CLIENT_ID;
+  const clientSecret = envVars.PAYPAL_CLIENT_SECRET;
+  if (!clientId || !clientSecret) return null;
+  return createPayPalService({
+    clientId,
+    clientSecret,
+    webhookId: envVars.PAYPAL_WEBHOOK_ID,
+    apiBase: envVars.PAYPAL_API_BASE || "https://api-m.sandbox.paypal.com",
+    env: envVars.PAYPAL_ENV || "sandbox",
+    testBuyerCountry: envVars.PAYPAL_TEST_BUYER_COUNTRY || undefined,
+    fetchImpl,
+  });
+}
+
+// Validate an SDK Order object against a shop order; returns {capture} if COMPLETED-matching, {pendingCapture} if PENDING, else {mismatch: reason}
+export function evaluatePayPalOrder(order, shopOrder) {
+  const expectedDollars = centsToPayPalAmount(shopOrder.total_cents);
+  const units = order?.purchaseUnits ?? [];
+  if (!units.length) return { mismatch: "missing purchase_units" };
+  const unit = units[0];
+  if (unit.customId !== undefined && unit.customId !== shopOrder.id) return { mismatch: "custom_id mismatch" };
+  if (unit.customId === undefined) return { mismatch: "missing custom_id" };
+  const captures = units.flatMap((u) => u.payments?.captures ?? []);
+  if (!captures.length) return { mismatch: "no captures" };
+  for (const cap of captures) {
+    if (!cap.amount) continue;
+    if (cap.amount.currencyCode !== "USD") continue;
+    if (cap.amount.value !== expectedDollars) continue;
+    if (cap.customId !== undefined && cap.customId !== shopOrder.id) continue;
+    if (cap.status === "COMPLETED") return { capture: cap };
+    if (cap.status === "PENDING") return { pendingCapture: cap };
+    if (cap.status === "DECLINED" || cap.status === "FAILED") return { declinedCapture: cap };
+  }
+  // Distinguish pending/declined with right amount handled above; anything else mismatch
+  const anyPending = captures.find((c) => c.status === "PENDING");
+  if (anyPending) return { mismatch: "capture amount or currency mismatch" };
+  return { mismatch: "no COMPLETED capture with matching amount/currency/custom_id" };
+}
