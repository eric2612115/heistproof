+function makeFakePayPal(overrides = {}) {
+  const calls = [];
+  const state = { created: new Map(), captured: new Map(), verifyStatus: overrides.verifyStatus ?? "SUCCESS", seq: 0 };
+  const fetchImpl = async (input, init) => {
+    const request = new Request(input, init);
+    const url = new URL(request.url);
+    const text = request.body === null ? "" : await request.clone().text();
+    const call = { url, request, text, body: text ? safeJson(text) : null };
+    calls.push(call);
+    if (overrides.onCall) overrides.onCall(call);
+
+    if (url.pathname === "/v1/oauth2/token") return jsonRes(200, TOKEN);
+    if (url.pathname === "/v1/notifications/verify-webhook-signature") {
+      state.lastVerify = call;
+      return jsonRes(200, { verification_status: state.verifyStatus });
+    }
+    if (url.pathname === "/v2/checkout/orders" && request.method === "POST") {
+      if (overrides.createResponder) return overrides.createResponder(call, state);
+      const pu = call.body.purchase_units[0];
+      const id = `PAYPAL-${++state.seq}`;
+      state.created.set(id, { custom_id: pu.custom_id, value: pu.amount.value, currency: pu.amount.currency_code });
+      return jsonRes(201, { id, status: "CREATED", intent: "CAPTURE", purchase_units: [{ custom_id: pu.custom_id, invoice_id: pu.invoice_id, amount: pu.amount }] });
+    }
+    const capMatch = url.pathname.match(/^\/v2\/checkout\/orders\/([^/]+)\/capture$/);
+    if (capMatch && request.method === "POST") {
+      if (overrides.captureResponder) return overrides.captureResponder(call, state, capMatch[1]);
+      const info = state.created.get(capMatch[1]);
+      const capture = { id: "CAP-1", status: overrides.captureStatus ?? "COMPLETED", custom_id: info.custom_id, amount: { currency_code: info.currency, value: overrides.captureValue ?? info.value } };
+      state.captured.set(capMatch[1], capture);
+      return jsonRes(200, completedOrder(capMatch[1], info, capture));
+    }
+    const getMatch = url.pathname.match(/^\/v2\/checkout\/orders\/([^/]+)$/);
+    if (getMatch && request.method === "GET") {
+      if (overrides.getResponder) return overrides.getResponder(call, state, getMatch[1]);
+      const info = state.created.get(getMatch[1]);
+      const capture = state.captured.get(getMatch[1]);
+      if (!info) return jsonRes(404, { name: "RESOURCE_NOT_FOUND", message: "not found", debug_id: "d" });
+      return jsonRes(200, capture ? completedOrder(getMatch[1], info, capture) : { id: getMatch[1], status: "APPROVED", purchase_units: [{ custom_id: info.custom_id, amount: { currency_code: info.currency, value: info.value }, payments: { captures: [] } }] });
