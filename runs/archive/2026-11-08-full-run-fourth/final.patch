+test("create prices from catalog, ignores browser prices, sends exact SDK wire (claim present during call)", async () => {
+  let shopRef;
+  const seen = [];
+  const fake = makeFakePayPal({ onCall(call) {
+    if (call.url.pathname === "/v2/checkout/orders" && call.request.method === "POST") {
+      const pu = call.body.purchase_units[0];
+      seen.push({ claim: shopRef.db.hasClaim(`create:${pu.custom_id}`), headers: call.request.headers, body: call.body });
+    }
+  }});
+  const shop = await startShop(fake); shopRef = shop;
+  try {
+    const { id, orderId } = await createViaApi(shop);
+    assert.ok(id.startsWith("PAYPAL-"));
+    const order = shop.db.getOrder(orderId);
+    assert.equal(order.total_cents, 4900);
+    assert.equal(order.paypal_order_id, id);
+    assert.equal(seen.length, 1);
+    assert.equal(seen[0].claim, true, "claim row must exist when SDK request leaves");
+    assert.equal(seen[0].body.intent, "CAPTURE");
+    const pu = seen[0].body.purchase_units[0];
+    assert.deepEqual(Object.keys(pu).sort(), ["amount", "custom_id", "invoice_id", "items"].sort());
+    assert.equal(pu.custom_id, orderId);
+    assert.equal(pu.amount.value, "49.00");
+    assert.equal(pu.amount.breakdown.item_total.value, "49.00");
+    assert.deepEqual(pu.items, [{ name: "Fogline Hoodie", sku: "FOG-HOODIE", quantity: "1", unit_amount: { currency_code: "USD", value: "49.00" } }]);
+    assert.equal(seen[0].headers.get("paypal-request-id"), orderId);
+    assert.equal(seen[0].headers.get("prefer"), "return=representation");
+    assert.equal(seen[0].headers.get("paypal-mock-response"), null);
+    // token went to PAYPAL_API_BASE
+    assert.ok(fake.calls.some((c) => c.url.href === "https://paypal.test/v1/oauth2/token"));
+    // optional-fields proof: no invented body keys anywhere
+    assert.deepEqual(Object.keys(seen[0].body).sort(), ["intent", "purchase_units"]);
+  } finally { await shop.close(); }
+});
