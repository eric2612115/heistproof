+    assert.equal(v.webhook_event.id, "EVT-1");
+    // replay
+    const replay = await post(`${shop.base}/api/paypal/webhooks`, evt, webhookHeaders);
+    assert.equal(replay.status, 200);
+    assert.equal(shop.db.shipmentsFor(orderId).length, 1);
+  } finally { await shop.close(); }
