+const jsonRes = (status, body) => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+const TOKEN = { access_token: "T", token_type: "Bearer", expires_in: 3600 };
+const ppError = (issue, message = "The requested action could not be performed.") =>
+  jsonRes(422, { name: "UNPROCESSABLE_ENTITY", message, debug_id: "dbg1", details: [{ issue, description: `${issue} detail` }] });
