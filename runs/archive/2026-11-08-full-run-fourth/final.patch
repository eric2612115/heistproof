+const post = (url, body, headers = {}) => fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body ?? {}) });
+async function createViaApi(shop, items = [{ sku: "FOG-HOODIE", qty: 1 }]) {
+  const res = await post(`${shop.base}/api/paypal/orders`, { items, email: "b@example.com", price: 1, amount: "0.01", total: 1, currency: "EUR" });
+  assert.equal(res.status, 200);
+  return res.json(); // {id, orderId}
+}
+const webhookHeaders = { "paypal-auth-algo": "SHA256withRSA", "paypal-cert-url": "https://paypal.test/cert", "paypal-transmission-id": "tid", "paypal-transmission-sig": "sig", "paypal-transmission-time": "2026-01-01T00:00:00Z" };
+function captureCompletedEvent(shopOrderId, paypalId, { id = "EVT-1", value = "49.00", currency = "USD" } = {}) {
+  return { id, event_type: "PAYMENT.CAPTURE.COMPLETED", resource: { id: "CAP-1", status: "COMPLETED", custom_id: shopOrderId, amount: { value, currency_code: currency }, supplementary_data: { related_ids: { order_id: paypalId } } } };
+}
