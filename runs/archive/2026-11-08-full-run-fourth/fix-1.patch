+test("capture sends empty JSON body with application/json content-type (real sandbox 415 regression)", async () => {
+  const fake = makeFakePayPal();
+  const shop = await startShop(fake);
+  try {
+    const { id } = await createViaApi(shop);
+    const res = await post(`${shop.base}/api/paypal/orders/${id}/capture`, {});
+    assert.equal(res.status, 200);
+    const captures = fake.calls.filter((c) => c.url.pathname.endsWith("/capture"));
+    assert.equal(captures.length, 1);
+    // Omitting body sends no body and no Content-Type; real PayPal answered
+    // 415 UNSUPPORTED_MEDIA_TYPE (debug ca571d11c6846). Must send "{}" as JSON.
+    assert.match(captures[0].request.headers.get("content-type") ?? "", /application\/json/);
+    assert.equal(captures[0].text, "{}");
+    assert.deepEqual(captures[0].body, {});
+  } finally { await shop.close(); }
+});
+
