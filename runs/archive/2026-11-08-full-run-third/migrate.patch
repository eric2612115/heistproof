diff --git a/lib/paypal.js b/lib/paypal.js
new file mode 100644
index 0000000..ca79199
--- /dev/null
+++ b/lib/paypal.js
@@ -0,0 +1,352 @@
+import { PaypalClient, PaypalError } from "paypal";
+
+// One conversion point between shop money (integer cents) and PayPal money
+// (decimal strings in dollars). 4900 -> "49.00", 5 -> "0.05".
+export function centsToPayPalValue(cents) {
+  if (!Number.isInteger(cents) || cents < 0) throw new Error("amount must be a non-negative integer number of cents");
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, "0")}`;
+}
+
+export function payPalValueToCents(value) {
+  const m = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(value ?? ""));
+  if (!m) return null;
+  return Number(m[1]) * 100 + Number((m[2] ?? "").padEnd(2, "0") || 0);
+}
+
+export class PayPalShopError extends Error {
+  constructor(status, message, { code = undefined, outcome = undefined } = {}) {
+    super(message);
+    this.name = "PayPalShopError";
+    this.status = status;
+    this.code = code;
+    // "refused" = PayPal answered no (claim may be released); "unknown" = write may have happened.
+    this.outcome = outcome;
+  }
+}
+
+const FIXED = {
+  credentials: "PayPal is unavailable: our PayPal credentials were rejected.",
+  quota: "PayPal is temporarily unavailable: our PayPal quota is exhausted.",
+  provider: "PayPal is unavailable right now. Please try again later.",
+  unknown: "We could not confirm the outcome with PayPal. Please check before paying again.",
+};
+
+function reasonFromApiError(err) {
+  const payload = err?.payload;
+  if (!payload) return undefined;
+  if ("rawBody" in payload) {
+    try {
+      const text = new TextDecoder().decode(payload.rawBody);
+      const parsed = JSON.parse(text);
+      const details = (parsed.details ?? []).map((d) => d.description || d.issue).filter(Boolean).join("; ");
+      return [parsed.message, details].filter(Boolean).join(": ") || undefined;
+    } catch {
+      return undefined;
+    }
+  }
+  const body = payload.body;
+  if (!body) return undefined;
+  const details = (body.details ?? []).map((d) => d.description || d.issue).filter(Boolean).join("; ");
+  return [body.message, details].filter(Boolean).join(": ") || undefined;
+}
+
+function issueFromApiError(err) {
+  const payload = err?.payload;
+  if (!payload) return undefined;
+  if ("rawBody" in payload) {
+    try {
+      return (JSON.parse(new TextDecoder().decode(payload.rawBody)).details ?? [])[0]?.issue;
+    } catch {
+      return undefined;
+    }
+  }
+  return payload.body?.details?.[0]?.issue;
+}
+
+function isSdkFamily(err) {
+  return err instanceof PaypalError || (err && typeof err === "object" && "kind" in err && "uri" in err);
+}
+
+// Map one SDK failure to our boundary error. `write` marks calls where a
+// transport failure leaves the outcome unknown rather than failed.
+// Returns null for a never-sent failure's re-read decision handled by caller via outcome.
+export function translatePayPalError(err, { write = false } = {}) {
+  if (!isSdkFamily(err)) throw err; // abort reason, configuration fault, or bug: outside the family
+  switch (err.kind) {
+    case "api": {
+      if (err.status === 401 || err.status === 403) return new PayPalShopError(502, FIXED.credentials, { outcome: "refused" });
+      if (err.status === 429) return new PayPalShopError(503, FIXED.quota, { outcome: "refused" });
+      if (err.status >= 400 && err.status < 500) {
+        return new PayPalShopError(err.status, reasonFromApiError(err) ?? "PayPal rejected the request.", {
+          code: issueFromApiError(err),
+          outcome: "refused",
+        });
+      }
+      return new PayPalShopError(502, FIXED.provider, { outcome: "refused" });
+    }
+    case "auth":
+      // Credential could not be obtained: nothing was sent.
+      return new PayPalShopError(502, FIXED.credentials, { outcome: "never-sent" });
+    case "encode":
+      return new PayPalShopError(502, FIXED.provider, { outcome: "never-sent" });
+    case "decode":
+      if (err.status >= 400) {
+        if (err.status === 401 || err.status === 403) return new PayPalShopError(502, FIXED.credentials, { outcome: "refused" });
+        if (err.status === 429) return new PayPalShopError(503, FIXED.quota, { outcome: "refused" });
+        if (err.status < 500) return new PayPalShopError(err.status, "PayPal rejected the request.", { outcome: "refused" });
+        return new PayPalShopError(502, FIXED.provider, { outcome: "refused" });
+      }
+      // 2xx body unreadable: the write may have taken effect.
+      return new PayPalShopError(502, FIXED.unknown, { outcome: write ? "unknown" : "refused" });
+    case "connection":
+    case "timeout":
+      return new PayPalShopError(502, write ? FIXED.unknown : FIXED.provider, { outcome: write ? "unknown" : "refused" });
+    default:
+      throw err;
+  }
+}
+
+// Verify a decoded Order really contains a completed capture for exactly the
+// shop order's amount. Returns { captureId, paidCents } or null when there is
+// no capture at all yet; throws PayPalShopError on mismatch / pending / declined.
+export function verifyCompletedCapture(order, { paypalOrderId, shopOrderId, totalCents, currency }) {
+  if (!order || order.id === undefined) throw new PayPalShopError(502, FIXED.unknown, { outcome: "unknown" });
+  if (order.id !== paypalOrderId) throw new PayPalShopError(502, "PayPal order does not match this order.", { outcome: "refused" });
+  const units = order.purchaseUnits ?? [];
+  let bound = false;
+  for (const unit of units) {
+    if (unit.customId !== undefined && unit.customId !== shopOrderId) {
+      throw new PayPalShopError(502, "PayPal order is bound to a different shop order.", { outcome: "refused" });
+    }
+    if (unit.customId === shopOrderId) bound = true;
+  }
+  if (!bound) throw new PayPalShopError(502, "PayPal order is not bound to this shop order.", { outcome: "refused" });
+  const captures = units.flatMap((u) => u.payments?.captures ?? []);
+  if (captures.length === 0) return null;
+  const wantedCurrency = String(currency).toUpperCase();
+  for (const capture of captures) {
+    if (capture.status === "PENDING") {
+      throw new PayPalShopError(202, "Your payment is pending with PayPal. We will fulfil it once PayPal completes it.", {
+        code: "CAPTURE_PENDING",
+        outcome: "refused",
+      });
+    }
+    if (capture.status === "DECLINED" || capture.status === "FAILED") {
+      throw new PayPalShopError(402, "Your payment was declined by PayPal. Please choose another way to pay.", {
+        code: "CAPTURE_DECLINED",
+        outcome: "refused",
+      });
+    }
+    if (capture.status !== "COMPLETED") continue;
+    if (capture.id === undefined || capture.amount === undefined) {
+      throw new PayPalShopError(502, FIXED.unknown, { outcome: "unknown" });
+    }
+    const paidCents = payPalValueToCents(capture.amount.value);
+    if (String(capture.amount.currencyCode).toUpperCase() !== wantedCurrency || paidCents !== totalCents) {
+      throw new PayPalShopError(502, "The captured amount does not match this order.", { outcome: "refused" });
+    }
+    return { captureId: capture.id, paidCents };
+  }
+  return null;
+}
+
+export function createPayPalService({
+  clientId,
+  clientSecret,
+  webhookId = undefined,
+  apiBase = "https://api-m.sandbox.paypal.com",
+  env = "sandbox",
+  testBuyerCountry = undefined,
+  fetchImpl = undefined,
+} = {}) {
+  if (!clientId) throw new Error("PAYPAL_CLIENT_ID is not configured");
+  if (!clientSecret) throw new Error("PAYPAL_CLIENT_SECRET is not configured");
+  if (env !== "sandbox" && env !== "live") throw new Error(`PAYPAL_ENV must be "sandbox" or "live"`);
+  const base = String(apiBase).replace(/\/+$/, "");
+  const rawFetch = fetchImpl ?? ((...args) => globalThis.fetch(...args));
+
+  // Built once and held: resource getters and the OAuth2 token cache live on it.
+  // This SDK has no environment selector; the host is this baseUrl override,
+  // bound explicitly to PAYPAL_API_BASE (the token endpoint follows it too).
+  const client = new PaypalClient({
+    serverOptions: { baseUrl: base },
+    oauth2: { clientId, clientSecret },
+    retry: { timeout: 15_000, maxRetries: 0 },
+    logging: { level: "off" },
+    ...(fetchImpl ? { fetch: fetchImpl } : {}),
+  });
+
+  let cachedToken = null; // { value, expiresAt }
+
+  async function getAccessToken() {
+    if (cachedToken && cachedToken.expiresAt > Date.now()) return cachedToken.value;
+    const res = await rawFetch(`${base}/v1/oauth2/token`, {
+      method: "POST",
+      headers: {
+        "content-type": "application/x-www-form-urlencoded",
+        authorization: `Basic ${Buffer.from(`${clientId}:${clientSecret}`).toString("base64")}`,
+      },
+      body: "grant_type=client_credentials",
+    });
+    if (!res.ok) throw new PayPalShopError(502, FIXED.credentials, { outcome: "never-sent" });
+    const data = await res.json();
+    if (!data.access_token) throw new PayPalShopError(502, FIXED.credentials, { outcome: "never-sent" });
+    const ttlMs = Number(data.expires_in) > 60 ? (Number(data.expires_in) - 30) * 1000 : 0;
+    cachedToken = { value: data.access_token, expiresAt: Date.now() + ttlMs };
+    return data.access_token;
+  }
+
+  const expectedFor = ({ shopOrderId, totalCents, currency, paypalOrderId }) => ({
+    paypalOrderId,
+    shopOrderId,
+    totalCents,
+    currency,
+  });
+
+  async function settleFromPayPal(args) {
+    let order;
+    try {
+      order = await client.orders.getOrder({ id: args.paypalOrderId });
+    } catch (err) {
+      throw translatePayPalError(err);
+    }
+    return verifyCompletedCapture(order, expectedFor(args));
+  }
+
+  return {
+    browserConfig() {
+      return {
+        clientId,
+        scriptUrl:
+          env === "live" ? "https://www.paypal.com/web-sdk/v6/core" : "https://www.sandbox.paypal.com/web-sdk/v6/core",
+        ...(env === "sandbox" && testBuyerCountry ? { testBuyerCountry } : {}),
+      };
+    },
+
+    // The shop order row (claim) already exists; shopOrderId is both the
+    // PayPal-Request-Id and purchase_units[0].custom_id.
+    async createOrderForShop({ shopOrderId, cart }) {
+      const currency = String(cart.currency).toUpperCase();
+      const money = (cents) => ({ currencyCode: currency, value: centsToPayPalValue(cents) });
+      let order;
+      try {
+        order = await client.orders.createOrder({
+          payPalRequestId: shopOrderId,
+          body: {
+            intent: "CAPTURE",
+            purchaseUnits: [
+              {
+                customId: shopOrderId,
+                invoiceId: shopOrderId,
+                amount: { ...money(cart.totalCents), breakdown: { itemTotal: money(cart.totalCents) } },
+                items: cart.lines.map((line) => ({
+                  name: line.name,
+                  sku: line.sku,
+                  unitAmount: money(line.unitCents),
+                  quantity: String(line.qty),
+                })),
+              },
+            ],
+          },
+        });
+      } catch (err) {
+        // No SDK operation can re-read a create by request id: unknown, never failed.
+        throw translatePayPalError(err, { write: true });
+      }
+      if (!order?.id) throw new PayPalShopError(502, FIXED.unknown, { outcome: "unknown" });
+      return { paypalOrderId: order.id };
+    },
+
+    async captureVerified(args) {
+      let order;
+      try {
+        order = await client.orders.captureOrder({
+          id: args.paypalOrderId,
+          payPalRequestId: `${args.shopOrderId}-capture`,
+          prefer: "return=representation",
+        });
+      } catch (err) {
+        const issue = isSdkFamily(err) && err.kind === "api" ? issueFromApiError(err) : undefined;
+        if (issue === "ORDER_ALREADY_CAPTURED") {
+          const settled = await settleFromPayPal(args);
+          if (settled) return settled;
+          throw new PayPalShopError(502, FIXED.unknown, { outcome: "unknown" });
+        }
+        const translated = translatePayPalError(err, { write: true });
+        if (translated.outcome === "unknown") {
+          // Settle from what PayPal holds before reporting anything.
+          try {
+            const settled = await settleFromPayPal(args);
+            if (settled) return settled;
+            // Re-read succeeded and PayPal holds no capture: still report
+            // unknown to this caller, but the claim may be released for a retry.
+            translated.outcome = "unknown-not-captured";
+          } catch (settleErr) {
+            if (settleErr instanceof PayPalShopError && settleErr.code === "CAPTURE_PENDING") throw settleErr;
+            // re-read failed too: still unknown, never failed
+          }
+          throw translated;
+        }
+        if (translated.code === "INSTRUMENT_DECLINED") {
+          translated.message = "That payment method was declined. Please choose another way to pay.";
+        }
+        throw translated;
+      }
+      if (!order?.id) throw new PayPalShopError(502, FIXED.unknown, { outcome: "unknown" });
+      const verified = verifyCompletedCapture(order, expectedFor(args));
+      if (!verified) throw new PayPalShopError(502, FIXED.unknown, { outcome: "unknown" });
+      return verified;
+    },
+
+    // Used when a second capture caller loses the claim, and exposed for tests.
+    settleFromPayPal,
+
+    // PayPal webhook verification REST call (no SDK operation exists for it);
+    // goes to PAYPAL_API_BASE like every other PayPal call, on the same fetch.
+    async verifyWebhookSignature({ headers, event }) {
+      if (!webhookId) return false;
+      const get = (name) => (typeof headers?.get === "function" ? headers.get(name) : headers?.[name]);
+      const auth_algo = get("paypal-auth-algo");
+      const cert_url = get("paypal-cert-url");
+      const transmission_id = get("paypal-transmission-id");
+      const transmission_sig = get("paypal-transmission-sig");
+      const transmission_time = get("paypal-transmission-time");
+      if (!auth_algo || !cert_url || !transmission_id || !transmission_sig || !transmission_time || !event) return false;
+      let token;
+      try {
+        token = await getAccessToken();
+      } catch {
+        return false;
+      }
+      const res = await rawFetch(`${base}/v1/notifications/verify-webhook-signature`, {
+        method: "POST",
+        headers: { "content-type": "application/json", authorization: `Bearer ${token}` },
+        body: JSON.stringify({
+          auth_algo,
+          cert_url,
+          transmission_id,
+          transmission_sig,
+          transmission_time,
+          webhook_id: webhookId,
+          webhook_event: event,
+        }),
+      });
+      if (!res.ok) return false;
+      const data = await res.json().catch(() => null);
+      return data?.verification_status === "SUCCESS";
+    },
+  };
+}
+
+export function payPalServiceFromEnv(env = process.env, fetchImpl = undefined) {
+  if (!env.PAYPAL_CLIENT_ID || !env.PAYPAL_CLIENT_SECRET) return null;
+  return createPayPalService({
+    clientId: env.PAYPAL_CLIENT_ID,
+    clientSecret: env.PAYPAL_CLIENT_SECRET,
+    webhookId: env.PAYPAL_WEBHOOK_ID || undefined,
+    apiBase: env.PAYPAL_API_BASE || "https://api-m.sandbox.paypal.com",
+    env: env.PAYPAL_ENV || "sandbox",
+    testBuyerCountry: env.PAYPAL_TEST_BUYER_COUNTRY || undefined,
+    fetchImpl,
+  });
+}
