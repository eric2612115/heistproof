+    const approved = await sendWebhook(shop, {
+      id: "EVT-APPROVED-1",
+      event_type: "CHECKOUT.ORDER.APPROVED",
+      resource: { id: "PP-ORDER-1", status: "APPROVED", purchase_units: [{ custom_id: orderId, amount: { currency_code: "USD", value: "49.00" } }] },
+    });
+    assert.equal(approved.status, 200);
+    assert.equal(shop.db.getOrder(orderId).status, "pending");
+    assert.equal(shop.db.shipmentsFor(orderId).length, 0);
+
+    const completedEvent = {
+      id: "EVT-CAPTURE-1",
+      event_type: "PAYMENT.CAPTURE.COMPLETED",
