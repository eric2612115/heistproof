+function json(status, body) {
+  return new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+}
+const tokenOk = () => json(200, { access_token: "tok", token_type: "Bearer", expires_in: 3600 });
+const errorBody = (issue, description = "The instrument presented was declined.") => ({
+  name: "UNPROCESSABLE_ENTITY",
+  message: "The requested action could not be performed.",
+  debug_id: "debug-1",
+  details: [{ issue, description }],
+});
+
+// A faked fetch standing in for all of PayPal: OAuth token, Orders v2 and
+// webhook verification all route through it. No network.
+function makeFakePayPal(hooks = {}) {
+  const behavior = {
+    tokenFails: false,
+    captureMode: "completed", // completed | declined | alreadyCaptured | connection | mismatch | pending
+    verify: null, // null -> SUCCESS iff transmission_sig === "good"
+  };
+  const calls = [];
+  let created = null;
+  const completedOrder = (value = created?.amount) => ({
+    id: "PP-ORDER-1",
+    status: "COMPLETED",
+    intent: "CAPTURE",
+    purchase_units: [
+      {
+        custom_id: created?.customId,
+        amount: { currency_code: "USD", value },
+        payments: {
+          captures: [
+            {
+              id: "CAP-1",
+              status: behavior.captureMode === "pending" ? "PENDING" : "COMPLETED",
+              amount: { currency_code: "USD", value: behavior.captureMode === "mismatch" ? "0.01" : value },
+              custom_id: created?.customId,
+            },
+          ],
+        },
+      },
+    ],
+  });
+  const fetchImpl = async (input, init) => {
+    const request = new Request(input, init);
+    const url = new URL(request.url);
+    const bodyText = request.method === "GET" || request.method === "HEAD" ? undefined : await request.clone().text();
+    let parsedBody;
+    try {
+      parsedBody = bodyText ? JSON.parse(bodyText) : undefined;
+    } catch {
+      parsedBody = bodyText; // form-encoded token body
+    }
+    const call = { method: request.method, path: url.pathname, headers: request.headers, body: parsedBody, bodyText };
+    calls.push(call);
+    hooks.onCall?.(call);
+
+    if (url.pathname === "/v1/oauth2/token") {
+      return behavior.tokenFails ? json(401, { error: "invalid_client" }) : tokenOk();
+    }
+    if (url.pathname === "/v1/notifications/verify-webhook-signature") {
+      const ok = behavior.verify ? behavior.verify(call.body) : call.body.transmission_sig === "good";
+      return json(200, { verification_status: ok ? "SUCCESS" : "FAILURE" });
+    }
+    if (url.pathname === "/v2/checkout/orders" && request.method === "POST") {
+      const pu = call.body.purchase_units[0];
+      created = { customId: pu.custom_id, amount: pu.amount.value };
+      return json(201, {
+        id: "PP-ORDER-1",
+        status: "CREATED",
+        intent: "CAPTURE",
+        purchase_units: [{ custom_id: pu.custom_id, amount: pu.amount }],
+      });
+    }
+    if (url.pathname === "/v2/checkout/orders/PP-ORDER-1/capture") {
+      if (behavior.captureMode === "connection") throw new TypeError("fetch failed");
+      if (behavior.captureMode === "declined") return json(422, errorBody("INSTRUMENT_DECLINED"));
+      if (behavior.captureMode === "alreadyCaptured") return json(422, errorBody("ORDER_ALREADY_CAPTURED", "Order already captured."));
+      return json(200, completedOrder());
+    }
+    if (url.pathname === "/v2/checkout/orders/PP-ORDER-1" && request.method === "GET") {
+      return json(200, completedOrder());
+    }
+    return json(404, { name: "RESOURCE_NOT_FOUND", message: "not here", debug_id: "d" });
+  };
+  return { fetchImpl, calls, behavior, created: () => created };
+}
+
+async function startShop(hooks) {
+  const fake = makeFakePayPal(hooks);
+  const db = openDb(":memory:");
+  const paypal = createPayPalService({
+    clientId: "client-id-123",
+    clientSecret: SECRET,
+    webhookId: "WH-1",
+    apiBase: "https://paypal.test",
+    env: "sandbox",
+    testBuyerCountry: "US",
+    fetchImpl: fake.fetchImpl,
+  });
+  const app = createApp({ db, cards: createCardProcessor({ apiKey: "test" }), adminKey: "k", paypal });
+  const server = await new Promise((resolve) => {
+    const s = app.listen(0, "127.0.0.1", () => resolve(s));
+  });
+  return { db, fake, base: `http://127.0.0.1:${server.address().port}`, close: () => new Promise((r) => server.close(r)) };
+}
+
+const post = (url, body, headers = {}) =>
+  fetch(url, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body ?? {}) });
+
+async function createViaApi(shop, items = HOODIE, extra = {}) {
+  const res = await post(`${shop.base}/api/paypal/orders`, { items, ...extra });
+  assert.equal(res.status, 200);
+  return res.json();
+}
+
+test("converts cents to PayPal decimal strings exactly", () => {
+  assert.equal(centsToPayPalValue(4900), "49.00");
+  assert.equal(centsToPayPalValue(5), "0.05");
+  assert.equal(centsToPayPalValue(100), "1.00");
+  assert.equal(centsToPayPalValue(0), "0.00");
+});
+
+test("config exposes only browser-safe values, script from PAYPAL_ENV", async () => {
+  const shop = await startShop();
+  try {
+    const res = await fetch(`${shop.base}/api/paypal/config`);
+    const data = await res.json();
+    assert.equal(data.clientId, "client-id-123");
+    assert.equal(data.scriptUrl, "https://www.sandbox.paypal.com/web-sdk/v6/core");
+    assert.equal(data.testBuyerCountry, "US");
+    assert.ok(!JSON.stringify(data).includes(SECRET));
+  } finally {
+    await shop.close();
+  }
+});
+
+test("create prices from the catalog, ignores browser money, binds custom_id, claim precedes the call", async () => {
+  let claimSeenInFetch = false;
+  const shop = await startShop({
+    onCall(call) {
+      if (call.path === "/v2/checkout/orders" && call.method === "POST") {
+        // The shop order (claim) must already exist when the request leaves.
+        claimSeenInFetch = Boolean(shopRef.db.getOrder(call.body.purchase_units[0].custom_id));
+      }
+    },
+  });
+  const shopRef = shop;
+  try {
+    const data = await createViaApi(shop, [{ sku: "FOG-HOODIE", qty: 1, price: 1 }], {
+      amount: "0.01",
+      total: 1,
+      currency: "EUR",
+      price: 1,
+    });
+    assert.equal(data.id, "PP-ORDER-1");
+    assert.ok(claimSeenInFetch);
+    const create = shop.fake.calls.find((c) => c.path === "/v2/checkout/orders" && c.method === "POST");
+    assert.deepEqual(Object.keys(create.body).sort(), ["intent", "purchase_units"]);
+    assert.equal(create.body.intent, "CAPTURE");
+    const pu = create.body.purchase_units[0];
+    assert.deepEqual(Object.keys(pu).sort(), ["amount", "custom_id", "invoice_id", "items"]);
+    assert.equal(pu.custom_id, data.orderId);
+    assert.equal(pu.invoice_id, data.orderId);
+    assert.equal(pu.amount.currency_code, "USD");
+    assert.equal(pu.amount.value, "49.00");
+    assert.equal(pu.amount.breakdown.item_total.value, "49.00");
+    const itemsSum = pu.items.reduce((s, i) => s + Number(i.unit_amount.value) * Number(i.quantity), 0);
+    assert.equal(itemsSum.toFixed(2), pu.amount.value);
+    assert.equal(create.headers.get("paypal-request-id"), data.orderId);
+    assert.equal(create.headers.get("paypal-mock-response"), null);
+    assert.equal(shop.db.getOrder(data.orderId).paypal_order_id, "PP-ORDER-1");
+    assert.equal(shop.db.getOrder(data.orderId).status, "pending");
+  } finally {
+    await shop.close();
+  }
+});
+
+test("capture fulfils once; a second capture is safe and ships nothing new", async () => {
+  let claimSeenInFetch = false;
+  const shop = await startShop({
+    onCall(call) {
+      if (call.path.endsWith("/capture")) claimSeenInFetch = shopRef.db.hasCaptureClaim("PP-ORDER-1");
+    },
