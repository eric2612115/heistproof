+const webhookHeaders = (sig) => ({
+  "paypal-auth-algo": "SHA256withRSA",
+  "paypal-cert-url": "https://api-m.sandbox.paypal.com/certs/x.pem",
+  "paypal-transmission-id": "tx-1",
