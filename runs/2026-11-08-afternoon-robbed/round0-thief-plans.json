{
  "plans": [
    {
      "name": "Latest-order capture mix-up",
      "idea": "The capture handler may fulfil the shop order most recently created for the session instead of the shop order bound to the approved PayPal order.",
      "expect": "Ten hoodies shipped for one approved $49 payment.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 10
              }
            ]
          },
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {},
          "save": "c"
        }
      ]
    },
    {
      "name": "Capture webhook re-addressed",
      "idea": "The webhook handler may trust an edited custom_id and amount without verifying that the capture belongs to that shop order or was already used for the legitimate order.",
      "expect": "A new ten-hoodie order is marked fulfilled using the legitimate $49 capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 10
              }
            ]
          },
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.id": "{{legit.captureId}}",
            "resource.custom_id": "{{a.body.orderId}}",
            "resource.amount.value": "490.00",
            "resource.amount.currency_code": "USD",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.id}}"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Duplicate line, single price",
      "idea": "Pricing may collapse duplicate SKUs through a map while fulfilment may iterate every submitted line.",
      "expect": "Two hoodies shipped although PayPal is charged the single-item $49 total.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              },
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Same number, cheaper currency",
      "idea": "The shop may pass a client-supplied currency to PayPal but later compare or record only the numeric capture value as USD.",
      "expect": "The hoodie is shipped after approving 49 JPY instead of $49.00.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ],
            "currency": "JPY",
            "currency_code": "JPY",
            "amount": {
              "value": "49.00",
              "currency_code": "JPY"
            }
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Card checkout client total",
      "idea": "The card route may trust client-supplied total or payment-status fields instead of calculating $147 from the catalogue and the processor result.",
      "expect": "Three hoodies are fulfilled while only $49 is charged, or while the supplied fulfilled status bypasses charging.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/card",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 3
              }
            ],
            "email": "buyer@example.com",
            "card": {
              "number": "4242424242424242",
              "exp": "12/34",
              "cvc": "123"
            },
            "totalCents": 4900,
            "amount": {
              "currency_code": "USD",
              "value": "49.00"
            },
            "paid": true,
            "status": "fulfilled"
          },
          "save": "a"
        }
      ]
    },
    {
      "name": "Capture body names another order",
      "idea": "The capture route may trust an orderId, custom_id or x-order-id supplied with the capture request over the mapping stored for the approved PayPal order.",
      "expect": "The approved $49 payment fulfils the separate ten-hoodie shop order named in the capture request.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders",
          "body": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 10
              }
            ]
          },
          "save": "a"
        },
        {
          "do": "buy",
          "tamper": {
            "items": [
              {
                "sku": "FOG-HOODIE",
                "qty": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/paypal/orders/{{b.paypalOrderId}}/capture",
          "body": {
            "orderId": "{{a.body.orderId}}",
            "shopOrderId": "{{a.body.orderId}}",
            "custom_id": "{{a.body.orderId}}"
          },
          "headers": {
            "x-order-id": "{{a.body.orderId}}",
            "x-shop-order-id": "{{a.body.orderId}}"
          },
          "save": "c"
        }
      ]
    }
  ]
}