{
  "plans": [
    {
      "name": "Latest-order capture mix-up",
      "idea": "The shop may bind a capture to its most recently created session order instead of the shop order originally bound to that PayPal order.",
      "expect": "Pay $64 for one kettle but have the later ten-kettle order shipped.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 10
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {},
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Capture-time basket upsizing",
      "idea": "The capture handler may trust lines supplied in the capture request when creating the shipment, even though PayPal captures only the originally approved amount.",
      "expect": "Pay for one kettle and receive ten.",
      "steps": [
        {
          "do": "buy",
          "tamper": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 1
              }
            ]
          },
          "blockCapture": true,
          "save": "b"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{b.paypalOrderId}}/capture",
          "body": {
            "ref": "{{b.shopOrderId}}",
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 10
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "c"
        }
      ]
    },
    {
      "name": "Legitimate capture, different beneficiary",
      "idea": "The capture endpoint may mark the shop order named in the request body as paid when presented with an already completed legitimate PayPal capture, instead of enforcing the original PayPal-order-to-shop-order binding.",
      "expect": "The unpaid ten-kettle order ships by reusing the legitimate $64 capture, with no new payment.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 10
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{legit.paypalOrderId}}/capture",
          "body": {
            "ref": "{{a.body.ref}}",
            "shopOrderId": "{{a.body.ref}}",
            "paypalOrderId": "{{a.body.paypalOrderId}}"
          },
          "times": 1,
          "together": false,
          "save": "c"
        },
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal/{{a.body.paypalOrderId}}/capture",
          "body": {
            "ref": "{{a.body.ref}}",
            "captureId": "{{legit.captureId}}",
            "paypalOrderId": "{{legit.paypalOrderId}}"
          },
          "times": 1,
          "together": false,
          "save": "d"
        }
      ]
    },
    {
      "name": "Webhook retargeted to unpaid order",
      "idea": "The webhook handler may select the order solely from resource.custom_id and trust the completed status and edited amount without properly verifying the signature or the capture's original order binding.",
      "expect": "An unpaid ten-kettle order is treated as paid and shipped using the legitimate capture event.",
      "steps": [
        {
          "do": "request",
          "method": "POST",
          "path": "/api/checkout/paypal",
          "body": {
            "lines": [
              {
                "product": "KC-KETTLE",
                "count": 10
              }
            ]
          },
          "times": 1,
          "together": false,
          "save": "a"
        },
        {
          "do": "webhook",
          "event": "PAYMENT.CAPTURE.COMPLETED",
          "edit": {
            "resource.custom_id": "{{a.body.ref}}",
            "resource.amount.value": "640.00",
            "resource.amount.currency_code": "USD",
            "resource.status": "COMPLETED"
          },
          "signed": true,
          "times": 1
        }
      ]
    },
