{
  "name": "heistproof",
  "version": "0.1.0",
  "private": true,
  "description": "Add PayPal, Venmo and Pay Later to a card-only shop with an AI coding agent, prove it with a real sandbox purchase, then try to rob it before it ships.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "tsx src/cli/doctor.ts",
    "demo": "tsx src/cli/demo.ts",
    "heist": "tsx src/cli/run.ts",
    "check": "tsx src/cli/check.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "console": "tsx src/console/server.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:attacks": "node --import tsx --test --test-concurrency=1 \"test/attacks/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "playwright install chromium && node scripts/prepare-demo.mjs",
    "repro:415": "tsx scripts/repro-415.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "dotenv": "^16.6.1",
    "playwright": "^1.64.1"
  }
}
